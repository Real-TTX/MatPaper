<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MatPaper</RootNamespace>
    <AssemblyName>MatPaper</AssemblyName>
    <!-- PDFium/SkiaSharp rendering runs only on the container (Linux) and Windows dev,
         both supported by PDFtoImage; the platform-compat analyzer noise is not useful here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Phase 4: document text extraction, PDF rendering and thumbnails.
         PDFtoImage brings SkiaSharp + the Linux (NoDependencies) native assets transitively. -->
    <PackageReference Include="PdfPig" Version="0.1.*" />
    <PackageReference Include="PDFtoImage" Version="5.*" />
    <!-- Pin SkiaSharp managed + Linux native to the SAME version PDFtoImage targets,
         otherwise the managed/native libSkiaSharp versions mismatch at runtime. -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <!-- Phase 6: task scheduling + e-mail import -->
    <PackageReference Include="Cronos" Version="0.*" />
    <PackageReference Include="MailKit" Version="4.*" />
  </ItemGroup>

</Project>
