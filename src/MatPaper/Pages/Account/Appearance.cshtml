@page
@model MatPaper.Pages.Account.AppearanceModel
@using MatPaper.Services
@{
    // Account pages default to the sign-in layout; this one belongs in the app shell.
    Layout = "_Layout";
    ViewData["Breadcrumb"] = L["Appearance"].Value;
    ViewData["BreadcrumbLiteral"] = true;
    ViewData["Width"] = "narrow";

    string LabelOf(IReadOnlyList<ThemeCatalog.Option> list, string id) => L[list.First(o => o.Id == id).Label].Value;
}

<div class="mat-stack">
    <partial name="_AccountTabs" model='"appearance"' />

    @* Every choice is applied to the page at once (matpaper.js, data-theme-part / data-preview: the attributes of the toolkit data-theme, data-scheme, data-accent);
       Save stores it on the account. "Instance default" previews the default and follows a later change of it. *@
    <form method="post" id="appearance-form" class="mat-form" novalidate>
        <partial name="_ValidationSummary" />

        <div class="mat-card">
            <div class="mat-card__head">
                <mp-icon name="moon" />
                <h2 class="mat-card__title">@L["Mode"]</h2>
            </div>
            <div class="mat-card__body">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-sr-only">@L["Mode"]</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" name="Mode" value="" checked="@(string.IsNullOrEmpty(Model.Mode))" data-theme-part="mode" data-preview="@Model.InstanceDefault.Mode" />
                            <span class="mat-choice__text"><strong>@L["Instance default"]</strong><small>@LabelOf(ThemeCatalog.Modes, Model.InstanceDefault.Mode)</small></span>
                        </label>
                        @foreach (var mode in ThemeCatalog.Modes)
                        {
                            <label class="mat-choice">
                                <input type="radio" name="Mode" value="@mode.Id" checked="@(Model.Mode == mode.Id)" data-theme-part="mode" data-preview="@mode.Id" />
                                <span class="mat-choice__text"><strong>@L[mode.Label]</strong></span>
                            </label>
                        }
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="mat-card">
            <div class="mat-card__head">
                <mp-icon name="layers" />
                <h2 class="mat-card__title">@L["Colour scheme"]</h2>
            </div>
            <div class="mat-card__body">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-sr-only">@L["Colour scheme"]</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" name="Scheme" value="" checked="@(string.IsNullOrEmpty(Model.Scheme))" data-theme-part="scheme" data-preview="@Model.InstanceDefault.Scheme" />
                            <span class="mat-choice__text"><strong>@L["Instance default"]</strong><small>@LabelOf(ThemeCatalog.Schemes, Model.InstanceDefault.Scheme)</small></span>
                        </label>
                        @foreach (var scheme in ThemeCatalog.Schemes)
                        {
                            <label class="mat-choice">
                                <input type="radio" name="Scheme" value="@scheme.Id" checked="@(Model.Scheme == scheme.Id)" data-theme-part="scheme" data-preview="@scheme.Id" />
                                <span class="mat-choice__text">
                                    <strong>@L[scheme.Label]</strong>
                                    @if (scheme.Hint is not null)
                                    {
                                        <small>@L[scheme.Hint]</small>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="mat-card">
            <div class="mat-card__head">
                <mp-icon name="palette" />
                <h2 class="mat-card__title">@L["Accent colour"]</h2>
            </div>
            <div class="mat-card__body">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-sr-only">@L["Accent colour"]</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" name="Accent" value="" checked="@(string.IsNullOrEmpty(Model.Accent))" data-theme-part="accent" data-preview="@ThemeCatalog.MatAccent(Model.InstanceDefault.Accent)" />
                            <span class="mat-dot mp-dot--lg" data-colour="@ThemeCatalog.AccentColour(Model.InstanceDefault.Accent)" aria-hidden="true"></span>
                            <span class="mat-choice__text"><strong>@L["Instance default"]</strong><small>@LabelOf(ThemeCatalog.Accents, Model.InstanceDefault.Accent)</small></span>
                        </label>
                        @foreach (var accent in ThemeCatalog.Accents)
                        {
                            <label class="mat-choice">
                                <input type="radio" name="Accent" value="@accent.Id" checked="@(Model.Accent == accent.Id)" data-theme-part="accent" data-preview="@ThemeCatalog.MatAccent(accent.Id)" />
                                <span class="mat-dot mp-dot--lg" data-colour="@ThemeCatalog.AccentColour(accent.Id)" aria-hidden="true"></span>
                                <span class="mat-choice__text"><strong>@L[accent.Label]</strong></span>
                            </label>
                        }
                    </div>
                </fieldset>
            </div>
        </div>

        <mp-button-row>
            <mp-button variant="primary" icon="save">@L["Save"]</mp-button>
            <mp-button variant="ghost" href="/" icon="back">@L["Back"]</mp-button>
        </mp-button-row>
    </form>
</div>
