@page
@model MatPaper.Pages.Account.SetupModel
@{
    ViewData["Title"] = L["Welcome to MatPaper"].Value;
    ViewData["PageSub"] = L["Create the administrator account"].Value;
}

<form method="post" class="mat-form" novalidate>
    <partial name="_ValidationSummary" />

    <mp-field asp-for="Input.Username" label='@L["Username"]' autocomplete="username" autofocus="true" required="true" />
    <mp-field asp-for="Input.DisplayName" label='@L["Display name"]' autocomplete="name" />
    <mp-field asp-for="Input.Email" kind="email" label='@L["Email"]' autocomplete="email" help='@L["(optional)"]' />
    <mp-field asp-for="Input.Password" kind="password" label='@L["Password"]' autocomplete="new-password" required="true" />
    <mp-field asp-for="Input.ConfirmPassword" kind="password" label='@L["Confirm password"]' autocomplete="new-password" required="true" />

    <mp-button-row plain="true">
        <mp-button variant="primary" icon="rocket" block="true">@L["Create account"]</mp-button>
    </mp-button-row>
</form>
