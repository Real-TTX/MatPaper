@page "/Blocklist"
@model MatPaper.Pages.Blocklist.IndexModel
@{
    ViewData["Breadcrumb"] = L["Blocklist"].Value;
}

<p class="form-help">@L["What you deleted and blocked is skipped by imports and searches when it turns up again. Release an entry to get it back."]</p>

<form method="get" class="toolbar-search" style="margin-bottom:1rem">
    <input class="form-control" type="search" name="Search" value="@Model.Search" placeholder='@L["Search by name"]' />
    <button class="btn btn--secondary" type="submit">@L["Search"]</button>
</form>

<mp-table item-count="Model.Rows.Count" empty-text='@L["Nothing is blocked."]'>
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["File name"]</th>
            <th>@L["Blocked on"]</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Name</td>
                <td>@r.OriginalFileName</td>
                <td>@Fmt.Date(r.CreateDate)</td>
                <td class="is-actions">
                    <form method="post" asp-page-handler="Release" asp-route-id="@r.Id" asp-route-Search="@Model.Search" style="display:inline">
                        <button class="btn btn--secondary" type="submit"
                                data-confirm='@L["Release this entry? The document is imported again the next time it turns up."]'>@L["Release"]</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</mp-table>
@if (Model.Truncated)
{
    <p class="form-help">@L["Only the newest entries are shown; narrow it down with the search."]</p>
}
