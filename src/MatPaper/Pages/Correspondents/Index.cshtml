@page "/Correspondents"
@model MatPaper.Pages.Correspondents.IndexModel
@{
    ViewData["Breadcrumb"] = L["Correspondents"].Value;
}

<div class="mat-list">
    <mp-toolbar id="correspondents" label='@L["Correspondents"]' count="Model.TotalCount" singular="{0} correspondent" plural="{0} correspondents">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name, pattern or notes"]' />
        <mp-toolbar-sort value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="Model.Filters" />

    <mp-table item-count="Model.Rows.Count" empty-text='@L["No correspondents match your criteria."]' caption='@L["Correspondents"]'>
        <thead>
            <tr>
                <th scope="col">@L["Name"]</th>
                <th scope="col" class="mat-hide-sm">@L["Email"]</th>
                <th scope="col">@L["Last document"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Rows)
            {
                Model.Stats.TryGetValue(c.Id, out var st);
                <tr data-row-href="/Correspondents/Edit?id=@c.Id">
                    <td><div class="mat-table__name"><a href="/Documents?CorrespondentIds=@c.Id" data-tip='@L["Show documents"]'>@c.Name</a></div></td>
                    <td class="mat-hide-sm">@(string.IsNullOrWhiteSpace(c.Email) ? "—" : c.Email)</td>
                    <td>
                        @if (st != null && st.LatestId != null)
                        {
                            <div class="mat-table__name"><span><a href="/Documents/Edit?id=@st.LatestId">@st.LatestTitle</a><small>@Fmt.Date(st.Last) · @st.Count @L["doc(s)"]</small></span></div>
                        }
                        else
                        {
                            <span class="mat-muted">—</span>
                        }
                    </td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            @if (st != null && st.LatestId != null)
                            {
                                <mp-icon-button icon="clock" label='@($"{L["Last document"]}: {st.LatestTitle}")' href='@($"/Documents/Edit?id={st.LatestId}")' />
                            }
                            <mp-icon-button icon="file-text" label='@L["Documents"]' href='@($"/Documents?CorrespondentIds={c.Id}")' />
                            <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/Correspondents/Edit?id={c.Id}")' />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mp-table>

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />

    <div class="mat-actions">
        <mp-button variant="primary" href="/Correspondents/Edit" icon="plus">@L["New correspondent"]</mp-button>
    </div>
</div>
