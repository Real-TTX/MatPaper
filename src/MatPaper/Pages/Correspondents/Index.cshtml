@page "/Correspondents"
@model MatPaper.Pages.Correspondents.IndexModel
@{
    ViewData["Breadcrumb"] = "Correspondents";
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder="Name, pattern or notes" />
    <mp-toolbar-select name="Sort" label="Sort" value="@Model.Sort">
        <option value="name_asc">Name (A–Z)</option>
        <option value="name_desc">Name (Z–A)</option>
    </mp-toolbar-select>
</mp-toolbar>

<partial name="_FilterChips" model="Model.Filters" />

<mp-table item-count="Model.Rows.Count" empty-text="No correspondents match your criteria.">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Last document</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Rows)
        {
            Model.Stats.TryGetValue(c.Id, out var st);
            <tr>
                <td>@c.Name</td>
                <td>@(string.IsNullOrWhiteSpace(c.Email) ? "—" : c.Email)</td>
                <td>
                    @if (st != null && st.Count > 0)
                    {
                        <span>@(st.Last?.ToString("yyyy-MM-dd") ?? "—")</span>
                        <span class="form-help" style="margin:0">(@st.Count)</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td class="is-actions"><a href="/Documents?CorrespondentIds=@c.Id">Documents</a><a href="/Correspondents/Edit?id=@c.Id">Edit</a></td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/Correspondents/Edit">New correspondent</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
