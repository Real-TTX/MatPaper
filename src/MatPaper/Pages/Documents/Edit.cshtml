@page "/Documents/Edit"
@model MatPaper.Pages.Documents.EditModel
@{
    ViewData["Breadcrumb"] = L["Documents / Edit"].Value;

    var (ocrLabel, ocrBadge) = Model.OcrState switch
    {
        MatPaper.Data.OcrState.Done => (L["Processed"].Value, "badge--ok"),
        MatPaper.Data.OcrState.Failed => (L["Failed"].Value, "badge--off"),
        _ => (L["Pending"].Value, "badge--muted")
    };
}

<style>
    .doc-edit {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .doc-preview {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
        position: sticky;
        top: 1rem;
    }

    .doc-preview__frame {
        width: 100%;
        height: 70vh;
        min-height: 420px;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface-alt);
    }

    .doc-preview__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .doc-facts {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .doc-facts li {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }

    .doc-facts .doc-facts__key {
        color: var(--color-text-muted, #777);
    }

    .doc-facts .doc-facts__val {
        text-align: right;
        word-break: break-word;
    }

    .doc-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
    }

    .doc-tags label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: normal;
        margin: 0;
    }

    .doc-tags .color-swatch {
        display: inline-block;
        width: 0.9em;
        height: 0.9em;
        border-radius: 3px;
        vertical-align: middle;
    }

    .doc-shares {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--color-border);
    }

    .doc-shares__title {
        font-size: 1.1rem;
        margin: 0 0 0.25rem;
    }

    .doc-shares__create {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .doc-shares__create .form-control {
        width: auto;
    }

    @@media (max-width: 800px) {
        .doc-edit {
            grid-template-columns: 1fr;
        }

        .doc-preview {
            position: static;
        }
    }
    .doc-reanalyze {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .doc-reanalyze__opt {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    .doc-status {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        padding: 0.6rem 0.85rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
    }

    .doc-info {
        margin-top: 1.25rem;
        padding: 1rem 1.15rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
    }

    .doc-info__title {
        margin: 0 0 0.6rem;
        font-size: 1rem;
    }

    .doc-advanced {
        margin-top: 1.25rem;
        padding: 1rem 1.15rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
    }

    .doc-advanced > summary {
        cursor: pointer;
        font-weight: 600;
    }

    .doc-ocr {
        max-height: 320px;
        overflow: auto;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 12.5px;
        background: var(--color-surface-alt);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 10px;
        margin: 0;
    }
</style>

@if (TempData["TaskMessage"] is string taskMsg)
{
    <div class="form-summary" style="color:var(--color-text)">@taskMsg</div>
}

<div class="doc-status">
    <span class="doc-status__owner">@L["Owner"]: <strong>@(Model.OwnerName ?? "—")</strong></span>
    @if (Model.IsCommon)
    {
        <span class="badge badge--ok">@L["Common area"]</span>
    }
    @if (Model.ReviewState == MatPaper.Data.ReviewState.Pending)
    {
        <span class="badge badge--muted">@L["Needs review"]</span>
        @if (Model.IsStaged)
        {
            <span class="badge badge--muted" title='@L["The file waits in the inbox area until you confirm; then it is filed into the chosen storage location."]'>@L["Not filed yet"]</span>
        }
    }
    else
    {
        <span class="badge badge--ok">@L["Reviewed"]</span>
    }
    @if (!Model.CanEdit)
    {
        <span class="form-help" style="margin:0">@L["Shared with you — read only."]</span>
    }
</div>

<div class="doc-edit">
    <aside class="doc-preview">
        <div class="doc-preview__head">
            <strong>@L["Preview"]</strong>
            <a class="btn btn--secondary" href="/Documents/@Model.Token/view" target="_blank" rel="noopener">@L["Open in tab"]</a>
        </div>
        <iframe class="doc-preview__frame" src="/Documents/@Model.Token/view" title='@L["Document preview"]'></iframe>

        <a class="btn btn--secondary" href="/Documents/@Model.Token/download">@L["Download"]</a>

        <form method="post" class="doc-reanalyze">
            <input type="hidden" asp-for="Id" />
            <label class="doc-reanalyze__opt">
                <input type="checkbox" name="overwrite" value="true" /> @L["overwrite existing"]
            </label>
            <button class="btn btn--secondary" type="submit" asp-page-handler="Reanalyze"
                    title='@L["Auto-assign type, correspondent and date (from XRechnung/ZUGFeRD data if present, else the text)"]'>
                @L["Re-analyze"]
            </button>
        </form>
    </aside>

    <div class="doc-right">
    <form class="form" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="form-summary"></div>

        <mp-field asp-for="Input.Title" label='@L["Title"]' placeholder='@L["Document title"]' />

        <div class="form-row">
            <label asp-for="Input.DocumentDate">@L["Document date"]</label>
            <input class="form-control" type="date" asp-for="Input.DocumentDate" />
            <span class="field-error" asp-validation-for="Input.DocumentDate"></span>
        </div>

        <mp-picker asp-for="Input.DocumentTypeId" label='@L["Document type"]'
                   asp-items="Model.DocumentTypeOptions.Where(o => o.Value != string.Empty)" placeholder='@L["— None —"]' />

        <mp-picker asp-for="Input.CorrespondentId" label='@L["Correspondent"]'
                   asp-items="Model.CorrespondentOptions.Where(o => o.Value != string.Empty)" placeholder='@L["— None —"]' />

        <mp-picker asp-for="Input.ProjectId" label='@L["Project"]'
                   asp-items="Model.ProjectOptions.Where(o => o.Value != string.Empty)" placeholder='@L["— None —"]' />

        <mp-field asp-for="Input.StorageLocationId" kind="select" label='@(Model.IsStaged ? L["File to"].Value : L["Storage location"].Value)'
                  asp-items="Model.StorageLocationOptions" />

        @if (Model.TagItems.Count == 0)
        {
            <div class="form-row">
                <label>@L["Tags"]</label>
                <p class="form-help">@L["No tags defined yet."]</p>
            </div>
        }
        else
        {
            <mp-picker asp-for="SelectedTagIds" label='@L["Tags"]' asp-items="Model.TagItems" multiple="true" placeholder='@L["Add tags…"]' />
        }

        <mp-button-row>
            @if (Model.CanEdit && Model.ReviewState == MatPaper.Data.ReviewState.Pending)
            {
                @if (Model.OcrState == MatPaper.Data.OcrState.Pending)
                {
                    <button class="btn btn--primary" type="submit" disabled title='@L["Still being processed"]'>@L["Save & confirm"]</button>
                }
                else
                {
                    <mp-button variant="primary" type="submit" handler="SaveConfirm">@L["Save & confirm"]</mp-button>
                }
                <mp-button variant="secondary" type="submit">@L["Save"]</mp-button>
            }
            else if (Model.CanEdit)
            {
                <mp-button variant="primary" type="submit">@L["Save"]</mp-button>
            }
            <mp-button variant="secondary" href="@Model.BackUrl">@L["Back"]</mp-button>
            @if (Model.IsOwner)
            {
                <mp-button-spacer />
                <mp-button variant="danger" type="submit" handler="Delete"
                           confirm='@(Model.IsStaged ? L["Delete this document? It is removed from the inbox together with its file."].Value : L["Delete this document? The file stays in its storage location but the document is removed from MatPaper."].Value)'>@L["Delete"]</mp-button>
            }
        </mp-button-row>
    </form>

    <aside class="doc-info">
        <h3 class="doc-info__title">@L["Info"]</h3>
        <ul class="doc-facts">
            <li>
                <span class="doc-facts__key">@L["OCR status"]</span>
                <span class="doc-facts__val"><span class="badge @ocrBadge">@ocrLabel</span></span>
            </li>
            <li>
                <span class="doc-facts__key">@L["Pages"]</span>
                <span class="doc-facts__val">@Model.PageCount</span>
            </li>
            <li>
                <span class="doc-facts__key">@L["File size"]</span>
                <span class="doc-facts__val">@Fmt.Size(Model.FileSize)</span>
            </li>
            <li>
                <span class="doc-facts__key">@L["Original file"]</span>
                <span class="doc-facts__val">@Model.OriginalFileName</span>
            </li>
            @if (!string.IsNullOrEmpty(Model.InvoiceNumber))
            {
                <li>
                    <span class="doc-facts__key">@L["Invoice no."]</span>
                    <span class="doc-facts__val">@Model.InvoiceNumber</span>
                </li>
            }
            <li>
                <span class="doc-facts__key">@L["Added"]</span>
                <span class="doc-facts__val">@Fmt.DateTime(Model.AddedDate)</span>
            </li>
        </ul>
    </aside>

    <details class="doc-advanced">
        <summary>@L["Advanced"]</summary>
        <ul class="doc-facts">
            <li><span class="doc-facts__key">@L["Document ID"]</span><span class="doc-facts__val">@Model.Id</span></li>
            <li><span class="doc-facts__key">@L["Token"]</span><span class="doc-facts__val" style="word-break:break-all">@Model.Token</span></li>
            <li><span class="doc-facts__key">@L["Storage"]</span><span class="doc-facts__val">@(Model.IsStaged ? L["Inbox (not filed yet)"].Value : Model.StorageLocationName ?? "—")</span></li>
            <li><span class="doc-facts__key">@L["Path"]</span><span class="doc-facts__val" style="word-break:break-all">@Model.RelativePath</span></li>
            <li><span class="doc-facts__key">@L["Content hash"]</span><span class="doc-facts__val" style="word-break:break-all">@(Model.ContentHash ?? "—")</span></li>
        </ul>
        <h3 style="margin:1rem 0 .35rem;font-size:.95rem">@L["Indexed text (OCR)"]</h3>
        @if (string.IsNullOrWhiteSpace(Model.OcrText))
        {
            <p class="form-help">@L["No text extracted yet."]</p>
        }
        else
        {
            <pre class="doc-ocr">@Model.OcrText</pre>
        }
    </details>

@if (Model.IsOwner)
{
<section class="doc-shares">
    <h2 class="doc-shares__title">@L["Sharing"]</h2>

    <form method="post" asp-page-handler="SetCommon">
        <input type="hidden" asp-for="Id" />
        <label class="doc-reanalyze__opt">
            <input type="checkbox" name="isCommon" value="true" @(Model.IsCommon ? "checked" : "") onchange="this.form.submit()" />
            @L["Show in the common area (visible to everyone)"]
        </label>
    </form>

    <h3 style="margin:1.25rem 0 0.35rem;font-size:1rem">@L["Shared with users"]</h3>
    @if (Model.UserShares.Count > 0)
    {
        <ul class="share-users">
            @foreach (var s in Model.UserShares)
            {
                <li class="share-user">
                    <span class="share-user__name">@s.UserName</span>
                    <span class="share-user__perm">@(s.CanEdit ? L["can edit"].Value : L["view only"].Value)</span>
                    <form method="post" asp-page-handler="RevokeUserShare" style="display:inline">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="shareId" value="@s.ShareId" />
                        <button class="btn btn--danger" type="submit">@L["Remove"]</button>
                    </form>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="form-help">@L["Not shared with any user yet."]</p>
    }

    @if (Model.ShareUserOptions.Count > 0)
    {
        <form method="post" asp-page-handler="ShareUser" class="doc-shares__create">
            <input type="hidden" asp-for="Id" />
            <mp-picker asp-for="ShareUserId" label='@L["Add user"]' asp-items="Model.ShareUserOptions" placeholder='@L["Choose a user…"]' />
            <label class="doc-reanalyze__opt">
                <input type="checkbox" name="canEdit" value="true" /> @L["may edit"]
            </label>
            <button class="btn btn--primary" type="submit">@L["Share"]</button>
        </form>
    }

    <h3 style="margin:1.5rem 0 0.35rem;font-size:1rem">@L["Share links"]</h3>
    <p class="form-help">@L["Anyone with a share link can view and download this document without signing in."]</p>

    @if (Model.ShareLinks.Count > 0)
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>@L["Link"]</th><th>@L["Expires"]</th><th class="is-actions"></th></tr>
                </thead>
                <tbody>
                    @foreach (var link in Model.ShareLinks)
                    {
                        var url = $"{Model.ShareBaseUrl}/Share/{link.Token}";
                        <tr>
                            <td><a href="/Share/@link.Token" target="_blank" rel="noopener">@url</a></td>
                            <td>@(link.ExpiresAt.HasValue ? Fmt.Date(link.ExpiresAt) : L["Never"].Value)</td>
                            <td class="is-actions">
                                <form method="post" style="display:inline">
                                    <input type="hidden" name="Id" value="@Model.Id" />
                                    <input type="hidden" name="shareLinkId" value="@link.Id" />
                                    <button class="btn btn--danger" type="submit" asp-page-handler="RevokeShare"
                                            onclick='return confirm("@L["Revoke this share link?"]")'>@L["Revoke"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="form-help">@L["No share links yet."]</p>
    }

    <form method="post" class="doc-shares__create">
        <input type="hidden" name="Id" value="@Model.Id" />
        <label for="expiryDays">@L["Expires in"]</label>
        <select id="expiryDays" name="expiryDays" class="form-control">
            <option value="0">@L["Never"]</option>
            <option value="7">@L["7 days"]</option>
            <option value="30">@L["30 days"]</option>
            <option value="90">@L["90 days"]</option>
        </select>
        <button class="btn btn--primary" type="submit" asp-page-handler="CreateShare">@L["Create share link"]</button>
    </form>
</section>
}
    </div>
</div>

