@page "/Documents/Edit"
@model MatPaper.Pages.Documents.EditModel
@{
    ViewData["Breadcrumb"] = "Documents / Edit";

    var (ocrLabel, ocrBadge) = Model.OcrState switch
    {
        MatPaper.Data.OcrState.Done => ("Processed", "badge--ok"),
        MatPaper.Data.OcrState.Failed => ("Failed", "badge--off"),
        _ => ("Pending", "badge--muted")
    };
}

<style>
    .doc-edit {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .doc-preview {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
        position: sticky;
        top: 1rem;
    }

    .doc-preview__frame {
        width: 100%;
        height: 70vh;
        min-height: 420px;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface-alt);
    }

    .doc-preview__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .doc-facts {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .doc-facts li {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }

    .doc-facts .doc-facts__key {
        color: var(--color-text-muted, #777);
    }

    .doc-facts .doc-facts__val {
        text-align: right;
        word-break: break-word;
    }

    .doc-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
    }

    .doc-tags label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: normal;
        margin: 0;
    }

    .doc-tags .color-swatch {
        display: inline-block;
        width: 0.9em;
        height: 0.9em;
        border-radius: 3px;
        vertical-align: middle;
    }

    .doc-shares {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--color-border);
    }

    .doc-shares__title {
        font-size: 1.1rem;
        margin: 0 0 0.25rem;
    }

    .doc-shares__create {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .doc-shares__create .form-control {
        width: auto;
    }

    @@media (max-width: 800px) {
        .doc-edit {
            grid-template-columns: 1fr;
        }

        .doc-preview {
            position: static;
        }
    }
    .doc-reanalyze {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .doc-reanalyze__opt {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin: 0;
    }
</style>

@if (TempData["TaskMessage"] is string taskMsg)
{
    <div class="form-summary" style="color:var(--color-text)">@taskMsg</div>
}

<div class="doc-edit">
    <aside class="doc-preview">
        <div class="doc-preview__head">
            <strong>Preview</strong>
            <a class="btn btn--secondary" href="/Documents/@Model.Token/view" target="_blank" rel="noopener">Open in tab</a>
        </div>
        <iframe class="doc-preview__frame" src="/Documents/@Model.Token/view" title="Document preview"></iframe>

        <ul class="doc-facts">
            <li>
                <span class="doc-facts__key">OCR status</span>
                <span class="doc-facts__val"><span class="badge @ocrBadge">@ocrLabel</span></span>
            </li>
            <li>
                <span class="doc-facts__key">Pages</span>
                <span class="doc-facts__val">@Model.PageCount</span>
            </li>
            <li>
                <span class="doc-facts__key">File size</span>
                <span class="doc-facts__val">@FormatSize(Model.FileSize)</span>
            </li>
            <li>
                <span class="doc-facts__key">Original file</span>
                <span class="doc-facts__val">@Model.OriginalFileName</span>
            </li>
            @if (!string.IsNullOrEmpty(Model.InvoiceNumber))
            {
                <li>
                    <span class="doc-facts__key">Invoice no.</span>
                    <span class="doc-facts__val">@Model.InvoiceNumber</span>
                </li>
            }
            <li>
                <span class="doc-facts__key">Added</span>
                <span class="doc-facts__val">@Model.AddedDate.ToString("yyyy-MM-dd HH:mm") UTC</span>
            </li>
        </ul>

        <a class="btn btn--secondary" href="/Documents/@Model.Token/download">Download</a>

        <form method="post" class="doc-reanalyze">
            <input type="hidden" asp-for="Id" />
            <label class="doc-reanalyze__opt">
                <input type="checkbox" name="overwrite" value="true" /> overwrite existing
            </label>
            <button class="btn btn--secondary" type="submit" asp-page-handler="Reanalyze"
                    title="Auto-assign type, correspondent and date (from XRechnung/ZUGFeRD data if present, else the text)">
                Re-analyze
            </button>
        </form>
    </aside>

    <form class="form" method="post">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="form-summary"></div>

        <mp-field asp-for="Input.Title" label="Title" placeholder="Document title" />

        <div class="form-row">
            <label asp-for="Input.DocumentDate">Document date</label>
            <input class="form-control" type="date" asp-for="Input.DocumentDate" />
            <span class="field-error" asp-validation-for="Input.DocumentDate"></span>
        </div>

        <mp-picker asp-for="Input.DocumentTypeId" label="Document type"
                   asp-items="Model.DocumentTypeOptions.Where(o => o.Value != string.Empty)" placeholder="— None —" />

        <mp-picker asp-for="Input.CorrespondentId" label="Correspondent"
                   asp-items="Model.CorrespondentOptions.Where(o => o.Value != string.Empty)" placeholder="— None —" />

        <mp-picker asp-for="Input.ProjectId" label="Project"
                   asp-items="Model.ProjectOptions.Where(o => o.Value != string.Empty)" placeholder="— None —" />

        <mp-field asp-for="Input.StorageLocationId" kind="select" label="Storage location"
                  asp-items="Model.StorageLocationOptions"
                  help="Changing this moves the file into the selected location." />

        @if (Model.TagItems.Count == 0)
        {
            <div class="form-row">
                <label>Tags</label>
                <p class="form-help">No tags defined yet.</p>
            </div>
        }
        else
        {
            <mp-picker asp-for="SelectedTagIds" label="Tags" asp-items="Model.TagItems" multiple="true" placeholder="Add tags…" />
        }

        <mp-button-row>
            <mp-button variant="primary" type="submit">Save</mp-button>
            <mp-button variant="secondary" href="/Documents">Back</mp-button>
            <mp-button-spacer />
            <mp-button variant="danger" type="submit" handler="Delete"
                       confirm="Delete this document? The file stays on disk but the document is removed from MatPaper.">Delete</mp-button>
        </mp-button-row>
    </form>
</div>

<section class="doc-shares">
    <h2 class="doc-shares__title">Share links</h2>
    <p class="form-help">Anyone with a share link can view and download this document without signing in.</p>

    @if (Model.ShareLinks.Count > 0)
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>Link</th><th>Expires</th><th class="is-actions"></th></tr>
                </thead>
                <tbody>
                    @foreach (var link in Model.ShareLinks)
                    {
                        var url = $"{Model.ShareBaseUrl}/Share/{link.Token}";
                        <tr>
                            <td><a href="/Share/@link.Token" target="_blank" rel="noopener">@url</a></td>
                            <td>@(link.ExpiresAt.HasValue ? link.ExpiresAt.Value.ToString("yyyy-MM-dd") : "Never")</td>
                            <td class="is-actions">
                                <form method="post" style="display:inline">
                                    <input type="hidden" name="Id" value="@Model.Id" />
                                    <input type="hidden" name="shareLinkId" value="@link.Id" />
                                    <button class="btn btn--danger" type="submit" asp-page-handler="RevokeShare"
                                            onclick="return confirm('Revoke this share link?')">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="form-help">No share links yet.</p>
    }

    <form method="post" class="doc-shares__create">
        <input type="hidden" name="Id" value="@Model.Id" />
        <label for="expiryDays">Expires in</label>
        <select id="expiryDays" name="expiryDays" class="form-control">
            <option value="0">Never</option>
            <option value="7">7 days</option>
            <option value="30">30 days</option>
            <option value="90">90 days</option>
        </select>
        <button class="btn btn--primary" type="submit" asp-page-handler="CreateShare">Create share link</button>
    </form>
</section>

@functions {
    private static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{bytes} {units[unit]}" : $"{size:0.#} {units[unit]}";
    }
}
