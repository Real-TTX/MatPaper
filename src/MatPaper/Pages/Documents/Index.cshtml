@page "/Documents"
@using MatPaper.Data
@using Microsoft.AspNetCore.Mvc.Rendering
@model MatPaper.Pages.Documents.IndexModel
@{
    ViewData["Breadcrumb"] = L["Documents"].Value;
    var tagColours = Model.Tags.ToDictionary(t => t.Id.ToString(), t => (string?)t.Color);
    var projectColours = Model.Projects.ToDictionary(p => p.Id.ToString(), p => (string?)p.Color);

    // The mark of a document that is not simply in the archive: it waits in the inbox, was ignored, or is deleted.
    string StatusPill(Document d) => Model.ShowingDeleted ? "mat-pill mat-pill--warn" : d.ReviewState == ReviewState.Pending ? "mat-pill mat-pill--warn" : "mat-pill mat-pill--plain";
    string? StatusText(Document d) => Model.ShowingDeleted ? L["Deleted"].Value : d.ReviewState == ReviewState.Pending ? L["Needs review"].Value : d.ReviewState == ReviewState.Ignored ? L["Ignored"].Value : null;
}

<div class="mat-list">
    <mp-toolbar id="docs" label='@L["Documents"]' count="Model.TotalCount" singular="{0} document" plural="{0} documents" filter-size="md">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Full-text search"]' />
        <mp-view-switch current="@Model.View" />

        <mp-picker create="false" asp-for="CorrespondentIds" label='@L["Correspondent"]' multiple="true" placeholder='@L["All"]'
                   asp-items="@(new[] { new SelectListItem(L["No correspondent"].Value, "0") }.Concat(Model.Correspondents.Select(c => new SelectListItem(c.Name, c.Id.ToString()))))" />

        <mp-picker create="false" asp-for="DocumentTypeIds" label='@L["Type"]' multiple="true" placeholder='@L["All"]'
                   asp-items="@(new[] { new SelectListItem(L["No type"].Value, "0") }.Concat(Model.DocumentTypes.Select(t => new SelectListItem(t.Name, t.Id.ToString()))))" />

        <mp-picker create="false" asp-for="TagIds" label='@L["Tag"]' multiple="true" placeholder='@L["All"]' colours="tagColours"
                   asp-items="@(new[] { new SelectListItem(L["No tags"].Value, "0") }.Concat(Model.Tags.Select(t => new SelectListItem(t.Name, t.Id.ToString()))))" />

        <mp-picker create="false" asp-for="ProjectIds" label='@L["Project"]' multiple="true" placeholder='@L["All"]' colours="projectColours"
                   asp-items="@(new[] { new SelectListItem(L["No project"].Value, "0") }.Concat(Model.Projects.Select(p => new SelectListItem(p.Name, p.Id.ToString()))))" />

        <mp-picker asp-for="StorageLocationIds" label='@L["Location"]' multiple="true" placeholder='@L["All"]' create="false"
                   asp-items="@Model.StorageLocations.Select(s => new SelectListItem(s.Name, s.Id.ToString()))" />

        <mp-field asp-for="DateFrom" kind="date" label='@L["From"]' clearable="true" />
        <mp-field asp-for="DateTo" kind="date" label='@L["To"]' clearable="true" />

        <mp-toolbar-select name="Scope" label='@L["Scope"]' value="@Model.Scope">
            <option value="all">@L["All"]</option>
            <option value="mine">@L["Mine"]</option>
            <option value="shared">@L["Shared with me"]</option>
            <option value="common">@L["Common area"]</option>
        </mp-toolbar-select>

        <mp-toolbar-select name="Review" label='@L["Review"]' value="@Model.Review">
            <option value="all">@L["All"]</option>
            <option value="pending">@L["Needs review"]</option>
            <option value="reviewed">@L["Reviewed"]</option>
            <option value="ignored">@L["Ignored"]</option>
            <option value="deleted">@L["Deleted"]</option>
        </mp-toolbar-select>

        @if (Model.AsnEnabled)
        {
            <mp-toolbar-select name="Asn" label='@L["Archive number"]' value="@Model.Asn">
                <option value="all">@L["All"]</option>
                <option value="with">@L["With a number"]</option>
                <option value="without">@L["Without a number"]</option>
            </mp-toolbar-select>

            <mp-field asp-for="AsnFrom" kind="number" label='@L["Archive number from"]' min="1" step="1" inputmode="numeric" />
            <mp-field asp-for="AsnTo" kind="number" label='@L["Archive number to"]' min="1" step="1" inputmode="numeric" />
        }

        <mp-toolbar-sort value="@Model.Sort">
            <option value="added">@L["Recently added"]</option>
            <option value="newest">@L["Document date"]</option>
            <option value="oldest">@L["Oldest first"]</option>
            <option value="title">@L["Title"]</option>
            @if (Model.AsnEnabled)
            {
                <option value="asn">@L["Archive number"]</option>
                <option value="asn_desc">@L["Archive number (highest first)"]</option>
            }
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="Model.Filters" />

    @if (Model.Rows.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><mp-icon name="search" /></span>
            <div class="mat-empty__title">@L["No documents match your criteria."]</div>
            @if (Model.Filters.Any)
            {
                <p>@L["Change the search or the filters, or reset them."]</p>
                <mp-button variant="primary" href="/Documents" icon="refresh">@L["Reset the tools"]</mp-button>
            }
        </div>
    }
    else if (Model.ListView)
    {
        <mp-table item-count="Model.Rows.Count" caption='@L["Documents"]' table-class="mp-doc-table">
            <thead>
                <tr>
                    <th scope="col"><span class="mat-sr-only">@L["Preview"]</span></th>
                    <th scope="col">@L["Title"]</th>
                    <th scope="col" class="mat-hide-sm">@L["Correspondent"]</th>
                    <th scope="col" class="mat-hide-sm">@L["Type"]</th>
                    <th scope="col" class="mat-hide-sm mp-hide-md">@L["Project"]</th>
                    @if (Model.AsnEnabled)
                    {
                        <th scope="col" class="mat-hide-sm">@L["Archive no."]</th>
                    }
                    <th scope="col">@L["Date"]</th>
                    <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Rows)
                {
                    var rowTags = d.DocumentTags?.Where(t => t.Tag != null).Select(t => t.Tag!).ToList() ?? new List<MatPaper.Data.Tag>();
                    <tr class="@(Model.ShowingDeleted ? "mp-row--deleted" : null)" data-row-href="@(Model.ShowingDeleted ? null : $"/Documents/Edit?id={d.Id}")">
                        <td class="mp-cell-thumb" data-label="">
                            @if (Model.ShowingDeleted)
                            {
                                <span class="mp-thumb" aria-hidden="true"><mp-icon name="file-text" /></span>
                            }
                            else
                            {
                                <button type="button" class="mp-thumb mp-thumb--button" data-doc-preview="@d.Token" data-doc-preview-title="@d.Title" data-doc-preview-edit="/Documents/Edit?id=@d.Id" data-doc-preview-share="@(Model.CanShare(d) ? "true" : "false")" data-viewer-token="@d.Token" data-viewer-title="@d.Title" aria-label='@($"{L["Preview"]} {d.Title}")'>
                                    @if (d.ThumbnailPath != null)
                                    {
                                        <img src="/Documents/@d.Token/thumb" loading="lazy" alt="" />
                                    }
                                    else
                                    {
                                        <mp-icon name="file-text" />
                                    }
                                </button>
                            }
                        </td>
                        <td class="mp-cell-title">
                            <div class="mat-table__name">
                                <span>
                                    @if (Model.ShowingDeleted)
                                    {
                                        <span class="mp-doc-name" title="@d.Title">@d.Title</span>
                                    }
                                    else
                                    {
                                        <a class="mp-doc-name" href="/Documents/Edit?id=@d.Id" title="@d.Title">@d.Title</a>
                                    }
                                    @if (StatusText(d) is { } status)
                                    {
                                        <span class="@StatusPill(d)">@status</span>
                                    }
                                    @if (d.IsEInvoice)
                                    {
                                        <span class="mat-pill mat-pill--plain" data-tip='@L["Structured invoice data (XRechnung / ZUGFeRD)"]'>@L["E-invoice"]</span>
                                    }
                                    <small class="mp-doc-sub">@(d.Correspondent?.Name ?? "—")@(d.DocumentType != null ? " · " + d.DocumentType.Name : "")@(Model.AsnText(d) is { } subNumber ? " · " + subNumber : "")</small>
                                    @if (rowTags.Count > 0)
                                    {
                                        <span class="mp-doc-tags">
                                            @foreach (var t in rowTags)
                                            {
                                                <span class="mat-tag" data-colour="@(string.IsNullOrWhiteSpace(t.Color) ? "#808080" : t.Color)">@t.Name</span>
                                            }
                                        </span>
                                    }
                                </span>
                            </div>
                        </td>
                        <td class="mat-hide-sm">@(d.Correspondent?.Name ?? "—")</td>
                        <td class="mat-hide-sm">@(d.DocumentType?.Name ?? "—")</td>
                        <td class="mat-hide-sm mp-hide-md">
                            @if (d.Project != null)
                            {
                                <span class="mp-project"><mp-icon name="folder" data-colour="@(string.IsNullOrWhiteSpace(d.Project.Color) ? "#808080" : d.Project.Color)" />@d.Project.Name</span>
                            }
                            else
                            {
                                <span class="mat-muted">—</span>
                            }
                        </td>
                        @if (Model.AsnEnabled)
                        {
                            <td class="mat-hide-sm mat-mono">@(Model.AsnText(d) ?? "—")</td>
                        }
                        <td class="mat-mono mp-cell-date" data-label="">@Fmt.Date(d.DocumentDate ?? d.CreateDate)</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                @if (Model.ShowingDeleted)
                                {
                                    <form method="post" asp-page-handler="Restore" asp-route-Review="deleted" class="mp-contents">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <mp-icon-button icon="restore" label='@L["Restore"]' type="submit" />
                                    </form>
                                }
                                else
                                {
                                    <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/Documents/Edit?id={d.Id}")' />
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </mp-table>
    }
    else
    {
        <div class="mat-gallery">
            @foreach (var d in Model.Rows)
            {
                var displayDate = Fmt.Date(d.DocumentDate ?? d.CreateDate);
                var docTags = d.DocumentTags?.Where(t => t.Tag != null).Select(t => t.Tag!).ToList() ?? new List<MatPaper.Data.Tag>();
                <article class="mat-tile mp-doc @(Model.ShowingDeleted ? "mp-doc--deleted" : string.Empty)">
                    <div class="mp-doc__media">
                        @if (Model.ShowingDeleted)
                        {
                            <span class="mp-doc__thumb mp-doc__thumb--static" aria-hidden="true"><mp-icon name="file-text" /></span>
                        }
                        else
                        {
                            <button type="button" class="mp-doc__thumb" data-doc-preview="@d.Token" data-doc-preview-title="@d.Title" data-doc-preview-edit="/Documents/Edit?id=@d.Id" data-doc-preview-share="@(Model.CanShare(d) ? "true" : "false")" data-viewer-token="@d.Token" data-viewer-title="@d.Title" aria-label='@($"{L["Preview"]} {d.Title}")'>
                                @if (d.ThumbnailPath != null)
                                {
                                    <img src="/Documents/@d.Token/thumb" loading="lazy" alt="" />
                                }
                                else
                                {
                                    <mp-icon name="file-text" />
                                }
                                <span class="mp-doc__zoom" aria-hidden="true"><mp-icon name="zoom-in" /></span>
                            </button>
                        }
                        @if (StatusText(d) is { } status)
                        {
                            <span class="@StatusPill(d) mp-doc__status">@status</span>
                        }
                    </div>
                    <div class="mp-doc__body">
                        <div class="mp-doc__head">
                            <span class="mp-doc__party @(d.Correspondent == null ? "is-empty" : string.Empty)" title="@(d.Correspondent?.Name)">
                                <mp-icon name="user" /><span>@(d.Correspondent?.Name ?? "—")</span>
                            </span>
                            @if (Model.ShowingDeleted)
                            {
                                <form method="post" asp-page-handler="Restore" asp-route-Review="deleted" class="mp-contents">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <mp-icon-button icon="restore" label='@L["Restore"]' type="submit" />
                                </form>
                            }
                            else
                            {
                                <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/Documents/Edit?id={d.Id}")' />
                            }
                        </div>
                        @if (Model.ShowingDeleted)
                        {
                            <span class="mp-doc__title" title="@d.Title">@d.Title</span>
                        }
                        else
                        {
                            <a class="mp-doc__title" href="/Documents/Edit?id=@d.Id" title="@d.Title">@d.Title</a>
                        }
                        <div class="mp-doc__meta">
                            @if (d.DocumentType != null)
                            {
                                <span class="mat-pill mat-pill--accent">@d.DocumentType.Name</span>
                            }
                            @if (d.IsEInvoice)
                            {
                                <span class="mat-pill mat-pill--plain" data-tip='@L["Structured invoice data (XRechnung / ZUGFeRD)"]'>@L["E-invoice"]</span>
                            }
                            @if (Model.AsnText(d) is { } cardNumber)
                            {
                                <span class="mat-pill mat-pill--plain mat-mono" data-tip='@L["Archive number"]'>@cardNumber</span>
                            }
                            <span class="mp-doc__date"><mp-icon name="calendar" />@displayDate</span>
                        </div>
                        @if (d.Project != null)
                        {
                            <span class="mp-project" data-tip='@L["Project"]'><mp-icon name="folder" data-colour="@(string.IsNullOrWhiteSpace(d.Project.Color) ? "#808080" : d.Project.Color)" />@d.Project.Name</span>
                        }
                        @if (docTags.Count > 0)
                        {
                            <div class="mp-doc-tags">
                                @foreach (var t in docTags)
                                {
                                    <span class="mat-tag" data-colour="@(string.IsNullOrWhiteSpace(t.Color) ? "#808080" : t.Color)">@t.Name</span>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />

    <div class="mat-actions">
        <mp-button variant="primary" href="/Documents/Upload" icon="plus">@L["Add documents"]</mp-button>
    </div>
</div>
