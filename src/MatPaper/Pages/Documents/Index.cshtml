@page "/Documents"
@using MatPaper.Data
@using Microsoft.AspNetCore.Mvc.Rendering
@model MatPaper.Pages.Documents.IndexModel
@{
    ViewData["Breadcrumb"] = L["Documents"].Value;
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Full-text search"]' />

    @* A phone has no list bar: the gallery / list choice is the first field of the filter dialog. *@
    <mp-toolbar-view name="View" value="@Model.View" />

    <mp-picker create="false" asp-for="CorrespondentIds" label='@L["Correspondent"]' multiple="true" placeholder='@L["All"]'
               asp-items="@(new[] { new SelectListItem(L["No correspondent"].Value, "0") }.Concat(Model.Correspondents.Select(c => new SelectListItem(c.Name, c.Id.ToString()))))" />

    <mp-picker create="false" asp-for="DocumentTypeIds" label='@L["Type"]' multiple="true" placeholder='@L["All"]'
               asp-items="@(new[] { new SelectListItem(L["No type"].Value, "0") }.Concat(Model.DocumentTypes.Select(t => new SelectListItem(t.Name, t.Id.ToString()))))" />

    <mp-picker create="false" asp-for="TagIds" label='@L["Tag"]' multiple="true" placeholder='@L["All"]'
               asp-items="@(new[] { new SelectListItem(L["No tags"].Value, "0") }.Concat(Model.Tags.Select(t => new SelectListItem(t.Name, t.Id.ToString()))))" />

    <mp-picker create="false" asp-for="ProjectIds" label='@L["Project"]' multiple="true" placeholder='@L["All"]'
               asp-items="@(new[] { new SelectListItem(L["No project"].Value, "0") }.Concat(Model.Projects.Select(p => new SelectListItem(p.Name, p.Id.ToString()))))" />

    <mp-picker asp-for="StorageLocationIds" label='@L["Location"]' multiple="true" placeholder='@L["All"]'
               asp-items="@Model.StorageLocations.Select(s => new SelectListItem(s.Name, s.Id.ToString()))" />

    <div class="toolbar__group toolbar__filter">
        <label for="DateFrom">@L["From"]</label>
        <input class="form-control" type="date" id="DateFrom" name="DateFrom"
               value="@Fmt.InputDate(Model.DateFrom)" />
    </div>
    <div class="toolbar__group toolbar__filter">
        <label for="DateTo">@L["To"]</label>
        <input class="form-control" type="date" id="DateTo" name="DateTo"
               value="@Fmt.InputDate(Model.DateTo)" />
    </div>

    <mp-toolbar-select name="Scope" label='@L["Scope"]' value="@Model.Scope">
        <option value="all">@L["All"]</option>
        <option value="mine">@L["Mine"]</option>
        <option value="shared">@L["Shared with me"]</option>
        <option value="common">@L["Common area"]</option>
    </mp-toolbar-select>

    <mp-toolbar-select name="Review" label='@L["Review"]' value="@Model.Review">
        <option value="all">@L["All"]</option>
        <option value="pending">@L["Needs review"]</option>
        <option value="reviewed">@L["Reviewed"]</option>
        <option value="ignored">@L["Ignored"]</option>
        <option value="deleted">@L["Deleted"]</option>
    </mp-toolbar-select>

    <mp-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="added">@L["Recently added"]</option>
        <option value="newest">@L["Document date"]</option>
        <option value="oldest">@L["Oldest first"]</option>
        <option value="title">@L["Title"]</option>
    </mp-toolbar-select>
</mp-toolbar>

<partial name="_FilterChips" model="Model.Filters" />

<mp-list-bar count="Model.TotalCount" singular="{0} document" plural="{0} documents" current-page="Model.PageNumber" total-pages="Model.TotalPages">
    <mp-view-switch current="@Model.View" />
</mp-list-bar>

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">@L["No documents match your criteria."]</div>
}
else if (Model.ListView)
{
    <div class="data-table-wrap">
        <table class="data-table doc-table">
            <thead>
                <tr>
                    <th class="doc-table__thumbcell"><span class="visually-hidden">@L["Preview"]</span></th>
                    <th>@L["Title"]</th>
                    <th class="doc-table__optional doc-table__optional--party">@L["Correspondent"]</th>
                    <th class="doc-table__optional doc-table__optional--type">@L["Type"]</th>
                    <th class="doc-table__optional doc-table__optional--project">@L["Project"]</th>
                    <th>@L["Date"]</th>
                    <th class="is-actions @(Model.ShowingDeleted ? null : "doc-table__edit")"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Rows)
                {
                    var rowTags = d.DocumentTags?.Where(t => t.Tag != null).Select(t => t.Tag!).ToList() ?? new List<MatPaper.Data.Tag>();
                    <tr class="@(Model.ShowingDeleted ? "doc-row--deleted" : null)"
                        data-row-href="@(Model.ShowingDeleted ? null : $"/Documents/Edit?id={d.Id}")"
                        tabindex="@(Model.ShowingDeleted ? null : "0")">
                        <td class="doc-table__thumbcell">
                            @if (Model.ShowingDeleted)
                            {
                                <span class="doc-row__thumb doc-row__thumb--static" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" /></svg>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="doc-row__thumb" data-preview-url="/Documents/@d.Token/view" data-preview-title="@d.Title" data-viewer-token="@d.Token" data-viewer-title="@d.Title" data-preview-edit="/Documents/Edit?id=@d.Id" data-preview-share="@(Model.CanShare(d) ? "true" : "false")" aria-label='@L["Preview"] @d.Title'>
                                    @if (d.ThumbnailPath != null)
                                    {
                                        <img src="/Documents/@d.Token/thumb" loading="lazy" alt="" />
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" /></svg>
                                    }
                                </button>
                            }
                        </td>
                        <td class="doc-table__title">
                            @if (Model.ShowingDeleted)
                            {
                                <span class="doc-table__name" title="@d.Title">@d.Title</span>
                                <span class="badge badge--warn">@L["Deleted"]</span>
                            }
                            else
                            {
                                <a class="doc-table__name" href="/Documents/Edit?id=@d.Id" title="@d.Title">@d.Title</a>
                                @if (d.ReviewState == ReviewState.Pending)
                                {
                                    <span class="badge badge--warn">@L["Needs review"]</span>
                                }
                                else if (d.ReviewState == ReviewState.Ignored)
                                {
                                    <span class="badge badge--muted">@L["Ignored"]</span>
                                }
                            }
                            @if (d.IsEInvoice)
                            {
                                <span class="badge badge--muted" title="@L["Structured invoice data (XRechnung / ZUGFeRD)"]">@L["E-invoice"]</span>
                            }
                            <div class="doc-table__sub">@(d.Correspondent?.Name ?? "—")@(d.DocumentType != null ? " · " + d.DocumentType.Name : "")</div>
                            @if (rowTags.Count > 0)
                            {
                                <div class="doc-table__tags">
                                    @foreach (var t in rowTags)
                                    {
                                        <span class="tag-label"><span class="tag-label__dot" style="background:@(string.IsNullOrWhiteSpace(t.Color) ? "#808080" : t.Color)"></span>@t.Name</span>
                                    }
                                </div>
                            }
                        </td>
                        <td class="doc-table__optional doc-table__optional--party">@(d.Correspondent?.Name ?? "—")</td>
                        <td class="doc-table__optional doc-table__optional--type">@(d.DocumentType?.Name ?? "—")</td>
                        <td class="doc-table__optional doc-table__optional--project">
                            @if (d.Project != null)
                            {
                                <span class="project-label">
                                    <svg class="project-label__icon" viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:@(string.IsNullOrWhiteSpace(d.Project.Color) ? "#808080" : d.Project.Color)"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>@d.Project.Name
                                </span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="doc-table__date">@Fmt.Date(d.DocumentDate ?? d.CreateDate)</td>
                        <td class="is-actions @(Model.ShowingDeleted ? null : "doc-table__edit")">
                            @if (Model.ShowingDeleted)
                            {
                                <form method="post" asp-page-handler="Restore" asp-route-Review="deleted" style="display:inline">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button class="icon-btn" type="submit" title='@L["Restore"]' aria-label='@L["Restore"]'>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="icon-btn" href="/Documents/Edit?id=@d.Id" title='@L["Edit"]' aria-label='@L["Edit"]'>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" /></svg>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="doc-grid">
        @foreach (var d in Model.Rows)
        {
            var displayDate = Fmt.Date(d.DocumentDate ?? d.CreateDate);
            var docTags = d.DocumentTags?.Where(t => t.Tag != null).Select(t => t.Tag!).ToList() ?? new List<MatPaper.Data.Tag>();
            <article class="doc-card @(Model.ShowingDeleted ? "doc-card--deleted" : string.Empty)">
                <div class="doc-card__media">
                    @if (Model.ShowingDeleted)
                    {
                        <span class="doc-card__thumb doc-card__thumb--static" aria-hidden="true">
                            <svg class="doc-card__thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                                <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
                            </svg>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="doc-card__thumb" data-preview-url="/Documents/@d.Token/view" data-preview-title="@d.Title" data-viewer-token="@d.Token" data-viewer-title="@d.Title" data-preview-edit="/Documents/Edit?id=@d.Id" data-preview-share="@(Model.CanShare(d) ? "true" : "false")" aria-label='@L["Preview"] @d.Title'>
                            @if (d.ThumbnailPath != null)
                            {
                                <img src="/Documents/@d.Token/thumb" loading="lazy" alt="" />
                            }
                            else
                            {
                                <svg class="doc-card__thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                                    <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
                                </svg>
                            }
                            <span class="doc-card__zoom" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" /></svg>
                            </span>
                        </button>
                    }
                    @if (Model.ShowingDeleted)
                    {
                        <span class="doc-card__status doc-card__status--warn">@L["Deleted"]</span>
                    }
                    else if (d.ReviewState == ReviewState.Pending)
                    {
                        <span class="doc-card__status doc-card__status--review">@L["Needs review"]</span>
                    }
                    else if (d.ReviewState == ReviewState.Ignored)
                    {
                        <span class="doc-card__status">@L["Ignored"]</span>
                    }
                </div>
                <div class="doc-card__body">
                    <div class="doc-card__head">
                        <span class="doc-card__party @(d.Correspondent == null ? "is-empty" : string.Empty)" title="@(d.Correspondent?.Name)">
                            <svg class="doc-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M20 21v-1a6 6 0 0 0-6-6h-4a6 6 0 0 0-6 6v1" /></svg><span>@(d.Correspondent?.Name ?? "—")</span>
                        </span>
                        @if (Model.ShowingDeleted)
                        {
                            <form method="post" asp-page-handler="Restore" asp-route-Review="deleted" style="display:inline">
                                <input type="hidden" name="id" value="@d.Id" />
                                <button class="icon-btn" type="submit" title='@L["Restore"]' aria-label='@L["Restore"]'>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
                                    </svg>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="icon-btn" href="/Documents/Edit?id=@d.Id" title='@L["Edit"]' aria-label='@L["Edit"]'>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" /></svg>
                            </a>
                        }
                    </div>
                    @if (Model.ShowingDeleted)
                    {
                        <span class="doc-card__title" title="@d.Title">@d.Title</span>
                    }
                    else
                    {
                        <a class="doc-card__title" href="/Documents/Edit?id=@d.Id" title="@d.Title">@d.Title</a>
                    }
                    <div class="doc-card__meta">
                        @if (d.DocumentType != null)
                        {
                            <span class="doc-card__type">@d.DocumentType.Name</span>
                        }
                        @if (d.IsEInvoice)
                        {
                            <span class="badge badge--muted" title="@L["Structured invoice data (XRechnung / ZUGFeRD)"]">@L["E-invoice"]</span>
                        }
                        <span class="doc-card__date"><svg class="doc-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>@displayDate</span>
                    </div>
                    @if (d.Project != null)
                    {
                        <span class="project-label doc-card__project" title='@L["Project"]'>
                            <svg class="project-label__icon" viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:@(string.IsNullOrWhiteSpace(d.Project.Color) ? "#808080" : d.Project.Color)"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>@d.Project.Name
                        </span>
                    }
                    @if (docTags.Count > 0)
                    {
                        <div class="doc-card__tags">
                            @foreach (var t in docTags)
                            {
                                <span class="tag-label"><span class="tag-label__dot" style="background:@(string.IsNullOrWhiteSpace(t.Color) ? "#808080" : t.Color)"></span>@t.Name</span>
                            }
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}

<div class="list-actions">
    <a class="btn btn--primary" href="/Documents/Upload">@L["Add documents"]</a>
</div>

<mp-list-bar position="bottom" />

<dialog id="doc-preview" class="preview-dialog" aria-label='@L["Document preview"]'>
    <div class="preview-dialog__head">
        <span class="preview-dialog__title" id="doc-preview-title"></span>
        <div class="doc-actions">
            <a class="icon-btn" id="doc-preview-edit" title='@L["Edit"]' aria-label='@L["Edit"]'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" /></svg>
            </a>
            @* The link is made on the server and only the owner may; the script shows the button for those documents. *@
            <button type="button" class="icon-btn" id="doc-preview-share" data-doc-share data-doc-token="" data-doc-title="" title='@L["Share document"]' aria-label='@L["Share document"]' hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
            </button>
            <a class="icon-btn" id="doc-preview-download" title='@L["Download"]' aria-label='@L["Download"]'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
            </a>
            <a class="icon-btn" id="doc-preview-open" target="_blank" rel="noopener" title='@L["Open in tab"]' aria-label='@L["Open in tab"]'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7" /><path d="M10 14 21 3" /><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" /></svg>
            </a>
            <button type="button" class="icon-btn" id="doc-preview-close" title='@L["Close"]' aria-label='@L["Close"]' autofocus>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>
    </div>
    <iframe class="preview-dialog__frame" id="doc-preview-frame" title='@L["Document preview"]' src="about:blank"></iframe>
</dialog>

@section Scripts {
    <script>
        (function () {
            var dlg = document.getElementById("doc-preview");
            if (!dlg || typeof dlg.showModal !== "function") { return; }
            var frame = document.getElementById("doc-preview-frame");
            var titleEl = document.getElementById("doc-preview-title");
            var openEl = document.getElementById("doc-preview-open");
            var downloadEl = document.getElementById("doc-preview-download");
            var editEl = document.getElementById("doc-preview-edit");
            var shareEl = document.getElementById("doc-preview-share");

            function open(btn) {
                var url = btn.getAttribute("data-preview-url");
                var token = btn.getAttribute("data-viewer-token");
                var title = btn.getAttribute("data-preview-title");
                frame.src = url;
                openEl.href = url;
                downloadEl.href = "/Documents/" + token + "/download";
                editEl.href = btn.getAttribute("data-preview-edit");
                shareEl.hidden = btn.getAttribute("data-preview-share") !== "true";
                shareEl.setAttribute("data-doc-token", token);
                shareEl.setAttribute("data-doc-title", title || "");
                titleEl.textContent = title || "@L["Preview"]";
                dlg.showModal();
            }
            function close() {
                dlg.close();
                frame.src = "about:blank";
            }

            document.querySelectorAll("[data-preview-url]").forEach(function (btn) {
                btn.addEventListener("click", function () { open(btn); });
            });
            document.getElementById("doc-preview-close").addEventListener("click", close);
            dlg.addEventListener("click", function (e) { if (e.target === dlg) { close(); } });
            dlg.addEventListener("cancel", function () { frame.src = "about:blank"; });
        })();
    </script>
}
