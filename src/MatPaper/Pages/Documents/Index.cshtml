@page "/Documents"
@using MatPaper.Data
@using Microsoft.AspNetCore.Mvc.Rendering
@model MatPaper.Pages.Documents.IndexModel
@{
    ViewData["Breadcrumb"] = L["Documents"].Value;
}

<mp-toolbar count="Model.TotalCount">
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Full-text search"]' />

    <mp-picker asp-for="CorrespondentIds" label='@L["Correspondent"]' multiple="true" placeholder='@L["All"]'
               asp-items="@Model.Correspondents.Select(c => new SelectListItem(c.Name, c.Id.ToString()))" />

    <mp-picker asp-for="DocumentTypeIds" label='@L["Type"]' multiple="true" placeholder='@L["All"]'
               asp-items="@Model.DocumentTypes.Select(t => new SelectListItem(t.Name, t.Id.ToString()))" />

    <mp-picker asp-for="TagIds" label='@L["Tag"]' multiple="true" placeholder='@L["All"]'
               asp-items="@Model.Tags.Select(t => new SelectListItem(t.Name, t.Id.ToString()))" />

    <mp-picker asp-for="ProjectIds" label='@L["Project"]' multiple="true" placeholder='@L["All"]'
               asp-items="@Model.Projects.Select(p => new SelectListItem(p.Name, p.Id.ToString()))" />

    <mp-picker asp-for="StorageLocationIds" label='@L["Location"]' multiple="true" placeholder='@L["All"]'
               asp-items="@Model.StorageLocations.Select(s => new SelectListItem(s.Name, s.Id.ToString()))" />

    <div class="toolbar__group toolbar__filter">
        <label for="DateFrom">@L["From"]</label>
        <input class="form-control" type="date" id="DateFrom" name="DateFrom"
               value="@Fmt.InputDate(Model.DateFrom)" />
    </div>
    <div class="toolbar__group toolbar__filter">
        <label for="DateTo">@L["To"]</label>
        <input class="form-control" type="date" id="DateTo" name="DateTo"
               value="@Fmt.InputDate(Model.DateTo)" />
    </div>

    <mp-toolbar-select name="Scope" label='@L["Scope"]' value="@Model.Scope">
        <option value="all">@L["All"]</option>
        <option value="mine">@L["Mine"]</option>
        <option value="shared">@L["Shared with me"]</option>
        <option value="common">@L["Common area"]</option>
    </mp-toolbar-select>

    <mp-toolbar-select name="Review" label='@L["Review"]' value="@Model.Review">
        <option value="all">@L["All"]</option>
        <option value="pending">@L["Needs review"]</option>
        <option value="reviewed">@L["Reviewed"]</option>
        <option value="ignored">@L["Ignored"]</option>
        <option value="deleted">@L["Deleted"]</option>
    </mp-toolbar-select>

    <mp-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="added">@L["Recently added"]</option>
        <option value="newest">@L["Document date"]</option>
        <option value="oldest">@L["Oldest first"]</option>
        <option value="title">@L["Title"]</option>
    </mp-toolbar-select>
</mp-toolbar>

<partial name="_FilterChips" model="Model.Filters" />

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">@L["No documents match your criteria."]</div>
}
else
{
    <div class="doc-grid">
        @foreach (var d in Model.Rows)
        {
            var displayDate = Fmt.Date(d.DocumentDate ?? d.CreateDate);
            var docTags = d.DocumentTags?.Where(t => t.Tag != null).Select(t => t.Tag!).ToList() ?? new List<MatPaper.Data.Tag>();
            <article class="doc-card @(Model.ShowingDeleted ? "doc-card--deleted" : string.Empty)">
                @if (Model.ShowingDeleted)
                {
                    <span class="doc-card__thumb doc-card__thumb--static" aria-hidden="true">
                        <svg class="doc-card__thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                            <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
                        </svg>
                    </span>
                }
                else
                {
                    <button type="button" class="doc-card__thumb" data-preview-url="/Documents/@d.Token/view" data-preview-title="@d.Title" aria-label='@L["Preview"] @d.Title'>
                        @if (d.ThumbnailPath != null)
                        {
                            <img src="/Documents/@d.Token/thumb" loading="lazy" alt="" />
                        }
                        else
                        {
                            <svg class="doc-card__thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                                <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
                            </svg>
                        }
                        <span class="doc-card__zoom" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" /></svg>
                        </span>
                    </button>
                }
                <div class="doc-card__body">
                    @if (Model.ShowingDeleted)
                    {
                        <span class="doc-card__title" title="@d.Title">@d.Title</span>
                    }
                    else
                    {
                        <a class="doc-card__title" href="/Documents/Edit?id=@d.Id" title="@d.Title">@d.Title</a>
                    }
                    <div class="doc-card__meta">
                        <span>@(d.Correspondent?.Name ?? "—")</span>
                        <span>@(d.DocumentType?.Name ?? "—")</span>
                        <span>@displayDate</span>
                        @if (d.Project != null)
                        {
                            <span>@d.Project.Name</span>
                        }
                    </div>
                    @if (docTags.Count > 0)
                    {
                        <div class="doc-card__tags">
                            @foreach (var t in docTags)
                            {
                                <span class="tag-label"><span class="tag-label__dot" style="background:@(string.IsNullOrWhiteSpace(t.Color) ? "#808080" : t.Color)"></span>@t.Name</span>
                            }
                        </div>
                    }
                    <div class="doc-card__footer">
                        @if (Model.ShowingDeleted)
                        {
                            <span class="badge badge--warn">@L["Deleted"]</span>
                        }
                        else if (d.ReviewState == ReviewState.Pending)
                        {
                            <span class="badge badge--muted">@L["Needs review"]</span>
                        }
                        else if (d.ReviewState == ReviewState.Ignored)
                        {
                            <span class="badge badge--muted">@L["Ignored"]</span>
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (Model.ShowingDeleted)
                        {
                            <form method="post" asp-page-handler="Restore" asp-route-Review="deleted" style="display:inline">
                                <input type="hidden" name="id" value="@d.Id" />
                                <button class="icon-btn" type="submit" title='@L["Restore"]' aria-label='@L["Restore"]'>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
                                    </svg>
                                </button>
                            </form>
                        }
                        else
                        {
                        <a class="icon-btn" href="/Documents/Edit?id=@d.Id" title='@L["Edit"]' aria-label='@L["Edit"]'>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" /></svg>
                        </a>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}

<div class="list-actions">
    <a class="btn btn--primary" href="/Documents/Upload">@L["Add documents"]</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />

<dialog id="doc-preview" class="preview-dialog" aria-label='@L["Document preview"]'>
    <div class="preview-dialog__head">
        <span class="preview-dialog__title" id="doc-preview-title"></span>
        <a class="btn btn--secondary" id="doc-preview-open" target="_blank" rel="noopener">@L["Open in tab"]</a>
        <button type="button" class="btn btn--secondary" id="doc-preview-close">@L["Close"]</button>
    </div>
    <iframe class="preview-dialog__frame" id="doc-preview-frame" title='@L["Document preview"]' src="about:blank"></iframe>
</dialog>

@section Scripts {
    <script>
        (function () {
            var dlg = document.getElementById("doc-preview");
            if (!dlg || typeof dlg.showModal !== "function") { return; }
            var frame = document.getElementById("doc-preview-frame");
            var titleEl = document.getElementById("doc-preview-title");
            var openEl = document.getElementById("doc-preview-open");

            function open(url, title) {
                frame.src = url;
                openEl.href = url;
                titleEl.textContent = title || "@L["Preview"]";
                dlg.showModal();
            }
            function close() {
                dlg.close();
                frame.src = "about:blank";
            }

            document.querySelectorAll("[data-preview-url]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    open(btn.getAttribute("data-preview-url"), btn.getAttribute("data-preview-title"));
                });
            });
            document.getElementById("doc-preview-close").addEventListener("click", close);
            dlg.addEventListener("click", function (e) { if (e.target === dlg) { close(); } });
            dlg.addEventListener("cancel", function () { frame.src = "about:blank"; });
        })();
    </script>
}
