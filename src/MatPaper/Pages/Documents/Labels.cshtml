@page "/Documents/Labels"
@model MatPaper.Pages.Documents.LabelsModel
@{
    ViewData["Breadcrumb"] = L["Documents / Labels"].Value;
    var isCustom = string.Equals(Model.Input.Format, "custom", StringComparison.OrdinalIgnoreCase);
}

@if (!Model.Enabled)
{
    <div class="form-summary">@L["Reading barcodes is switched off in the settings: a number on a label is not recognised when a scan is added."]</div>
}

<section class="form-section">
    <h2 class="form-section__title">@L["Labels with archive numbers"]</h2>
    <p class="form-section__hint">@L["Print the labels on sticker sheets and stick one on every paper original. When the paper is scanned, MatPaper reads the number and gives it to the document - and you find the paper again by its number."]</p>

    <ul class="doc-facts labels-facts">
        <li>
            <span class="doc-facts__key">@L["Next free number"]</span>
            <span class="doc-facts__val" data-labels-next>@Model.NextFree</span>
        </li>
        <li>
            <span class="doc-facts__key">@L["Printed so far"]</span>
            <span class="doc-facts__val" data-labels-last>@(Model.LastPrinted > 0 ? Model.LastPrinted.ToString() : "—")</span>
        </li>
        <li>
            <span class="doc-facts__key">@L["A label says"]</span>
            <span class="doc-facts__val"><code>@Model.ExampleText</code></span>
        </li>
    </ul>

    <form class="form" method="post" asp-page-handler="Labels" target="_blank" data-labels-form>
        <div asp-validation-summary="All" class="form-summary"></div>

        <div class="form-row">
            <label for="labels-format">@L["Sticker sheet"]</label>
            <select id="labels-format" name="Input.Format" class="form-control" data-labels-format>
                @foreach (var f in Model.Formats)
                {
                    <option value="@f.Id" data-per-page="@f.PerPage" selected="@(string.Equals(Model.Input.Format, f.Id, StringComparison.OrdinalIgnoreCase))">@f.Name</option>
                }
                <option value="custom" data-per-page="0" selected="@isCustom">@L["Other sheet or label printer ..."]</option>
            </select>
        </div>

        <p class="form-help">@L["Small labels (under 15 mm) are read reliably when the paper is scanned at 300 dpi or more."]</p>

        <div class="labels-custom" data-labels-custom hidden="@(!isCustom)">
            <div class="asn-grid">
                <div class="form-row">
                    <label for="labels-columns">@L["Labels across"]</label>
                    <input id="labels-columns" class="form-control" type="number" min="1" max="20" step="1" name="Input.Columns" value="@Model.Input.Columns" />
                </div>
                <div class="form-row">
                    <label for="labels-rows">@L["Labels down"]</label>
                    <input id="labels-rows" class="form-control" type="number" min="1" max="60" step="1" name="Input.Rows" value="@Model.Input.Rows" />
                </div>
                <div class="form-row">
                    <label for="labels-width">@L["Label width (mm)"]</label>
                    <input id="labels-width" class="form-control" type="text" inputmode="decimal" name="Input.LabelWidth" value="@Model.Input.LabelWidth" />
                </div>
                <div class="form-row">
                    <label for="labels-height">@L["Label height (mm)"]</label>
                    <input id="labels-height" class="form-control" type="text" inputmode="decimal" name="Input.LabelHeight" value="@Model.Input.LabelHeight" />
                </div>
                <div class="form-row">
                    <label for="labels-gapx">@L["Gap between columns (mm)"]</label>
                    <input id="labels-gapx" class="form-control" type="text" inputmode="decimal" name="Input.GapX" value="@Model.Input.GapX" />
                </div>
                <div class="form-row">
                    <label for="labels-gapy">@L["Gap between rows (mm)"]</label>
                    <input id="labels-gapy" class="form-control" type="text" inputmode="decimal" name="Input.GapY" value="@Model.Input.GapY" />
                </div>
            </div>
            <div class="form-check">
                <input type="checkbox" id="labels-one" name="Input.OnePerPage" value="true" checked="@Model.Input.OnePerPage" data-labels-one />
                <label for="labels-one">@L["Label printer: one label per page, the page as big as the label"]</label>
            </div>
        </div>

        <div class="asn-grid">
            <div class="form-row">
                <label for="labels-start">@L["First number"]</label>
                <input id="labels-start" class="form-control" type="number" min="1" step="1" inputmode="numeric" name="Input.Start" value="@Model.Input.Start" required data-labels-start />
            </div>
            <div class="form-row">
                <label for="labels-count">@L["How many labels"]</label>
                <input id="labels-count" class="form-control" type="number" min="1" max="5000" step="1" inputmode="numeric" name="Input.Count" value="@Model.Input.Count" required data-labels-count />
            </div>
            <div class="form-row">
                <label for="labels-kind">@L["Code"]</label>
                <select id="labels-kind" name="Input.Kind" class="form-control">
                    @foreach (var o in Model.KindOptions)
                    {
                        <option value="@o.Value" selected="@(o.Value == Model.Input.Kind)">@o.Text</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label for="labels-skip" title='@L["Labels of the first sheet that are used already: a sheet that was started is filled up."]'>@L["Already used (first sheet)"]</label>
                <input id="labels-skip" class="form-control" type="number" min="0" max="999" step="1" inputmode="numeric" name="Input.Skip" value="@Model.Input.Skip" data-labels-skip />
            </div>
        </div>

        <div class="form-check">
            <input type="checkbox" id="labels-text" name="Input.ShowText" value="true" checked="@Model.Input.ShowText" />
            <label for="labels-text">@L["Print the number as text next to the code"]</label>
        </div>
        <input type="hidden" name="Input.ShowText" value="false" />

        <details class="labels-more">
            <summary>@L["Test print and adjustment"]</summary>
            <div class="form-check">
                <input type="checkbox" id="labels-border" name="Input.Border" value="true" checked="@Model.Input.Border" data-labels-border />
                <label for="labels-border">@L["Frame around every label (test print on plain paper; uses up no numbers)"]</label>
            </div>
            <input type="hidden" name="Input.Border" value="false" />
            <p class="form-help">@L["Hold the test print against a sticker sheet in the light: the frames show whether the labels fit. If not, shift the print here."]</p>
            <div class="asn-grid">
                <div class="form-row">
                    <label for="labels-offx">@L["Shift to the right (mm)"]</label>
                    <input id="labels-offx" class="form-control" type="text" inputmode="decimal" name="Input.OffsetX" value="@Model.Input.OffsetX" />
                </div>
                <div class="form-row">
                    <label for="labels-offy">@L["Shift down (mm)"]</label>
                    <input id="labels-offy" class="form-control" type="text" inputmode="decimal" name="Input.OffsetY" value="@Model.Input.OffsetY" />
                </div>
            </div>
        </details>

        <p class="form-help">@L["Print at 100 % (not \"fit to page\")."]</p>

        <mp-button-row>
            <mp-button variant="primary" type="submit">@L["Create PDF"]</mp-button>
            <mp-button variant="secondary" href="/Documents">@L["Back"]</mp-button>
        </mp-button-row>
    </form>
</section>

<section class="form-section">
    <h2 class="form-section__title">@L["Separator sheets"]</h2>
    <p class="form-section__hint">@L["Scan a whole stack of papers in one go: put a separator sheet between two documents. MatPaper cuts the scan at the sheets - every document of the stack is added on its own - and leaves the sheets out."]</p>
    <p class="form-help">@L["The code on the sheet says {0}.", Model.SeparatorText]</p>

    <form class="form" method="post" asp-page-handler="Separators" target="_blank">
        <div class="asn-grid">
            <div class="form-row">
                <label for="sep-count">@L["How many sheets"]</label>
                <input id="sep-count" class="form-control" type="number" min="1" max="500" step="1" inputmode="numeric" name="Input.SeparatorCount" value="@Model.Input.SeparatorCount" required />
            </div>
            <div class="form-row">
                <label for="sep-kind">@L["Code"]</label>
                <select id="sep-kind" name="Input.SeparatorKind" class="form-control">
                    @foreach (var o in Model.KindOptions)
                    {
                        <option value="@o.Value" selected="@(o.Value == Model.Input.SeparatorKind)">@o.Text</option>
                    }
                </select>
            </div>
        </div>
        <mp-button-row>
            <mp-button variant="primary" type="submit">@L["Create PDF"]</mp-button>
        </mp-button-row>
    </form>
</section>

@section Scripts {
    <script src="~/js/labels.js" asp-append-version="true"></script>
}
