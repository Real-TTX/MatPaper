@page "/Documents/Scan"
@model MatPaper.Pages.Documents.ScanModel
@{
    ViewData["Breadcrumb"] = L["Documents / Add"].Value;
    ViewData["AddTab"] = "camera";
}

<partial name="_AddDocumentTabs" />

@if (Model.Messages.Count > 0)
{
    <div class="notice notice--warn">
        <ul>
            @foreach (var message in Model.Messages)
            {
                <li>@message</li>
            }
        </ul>
    </div>
}

<form class="form" method="post" enctype="multipart/form-data" id="scan-form">
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <div class="form-row">
        <label for="Title">@L["Title"]</label>
        <input class="form-control" type="text" id="Title" name="Title" value="@Model.Title" placeholder='@L["Optional"]' />
    </div>

    <mp-picker asp-for="CorrespondentId" label='@L["Correspondent"]' asp-items="Model.CorrespondentOptions"
               value="@(Model.CorrespondentId?.ToString())" placeholder='@L["— Auto-detect —"]' />

    <mp-picker asp-for="DocumentTypeId" label='@L["Document type"]' asp-items="Model.DocumentTypeOptions"
               value="@(Model.DocumentTypeId?.ToString())" placeholder='@L["— Auto-detect —"]' />

    <input type="hidden" id="Prepared" name="Prepared" value="" />

    @* The scanner (scanner.js) shows these when the browser can do it; the plain photo field below is the fallback. *@
    <div class="scn-launch" hidden>
        <div class="scn-launch__buttons">
            <button type="button" class="btn btn--primary scn-launch__main" id="scanner-launch">@L["Start scanner"]</button>
            <button type="button" class="btn btn--secondary" id="scanner-gallery">@L["From gallery"]</button>
            <input type="file" id="scanner-gallery-input" accept="image/*" multiple hidden />
        </div>
        <div class="scn-summary" id="scanner-summary" hidden>
            <div class="scn-summary__head">
                <strong data-count></strong>
                <button type="button" class="btn btn--secondary" id="scanner-reopen">@L["Edit pages"]</button>
            </div>
            <div class="scn-summary__strip" data-strip></div>
        </div>
    </div>

    <div class="form-row" id="scan-fallback">
        <label for="Images">@L["Photos"]</label>
        <input class="form-control" type="file" id="Images" name="Images"
               accept="image/*" capture="environment" multiple />
        <span class="field-error" asp-validation-for="Images"></span>
    </div>

    <mp-button-row>
        <mp-button variant="primary" type="submit" id="scan-submit">@L["Create PDF"]</mp-button>
        <mp-button variant="secondary" href="/Documents">@L["Back"]</mp-button>
    </mp-button-row>
</form>

<div id="scanner-config" hidden
     data-t-title='@L["Scanner"]' data-t-hint='@L["Hold the camera over the page"]' data-t-close='@L["Close"]'
     data-t-torch='@L["Light"]' data-t-auto='@L["Auto"]' data-t-gallery='@L["Gallery"]' data-t-shoot='@L["Take photo"]'
     data-t-found='@L["Page found"]' data-t-hold='@L["Hold still …"]'
     data-t-no-camera='@L["The camera is not available here (it needs HTTPS). Use the gallery instead."]'
     data-t-camera-denied='@L["No access to the camera. Allow it in the browser, or use the gallery."]'
     data-t-auto-corners='@L["Detect again"]' data-t-apply='@L["Done"]' data-t-adjust='@L["Drag the corners onto the page"]'
     data-t-f-enhanced='@L["Enhanced"]' data-t-f-color='@L["Original"]' data-t-f-gray='@L["Gray"]' data-t-f-bw='@L["Black & white"]'
     data-t-retake='@L["Retake"]' data-t-crop='@L["Crop"]' data-t-add-page='@L["+ Page"]' data-t-finish='@L["Done"]'
     data-t-pages='@L["Pages"]' data-t-working='@L["Working …"]' data-t-pages-ready='@L["{0} page(s) ready"]'></div>

@section Scripts {
    <script src="~/js/scanner-core.js" asp-append-version="true"></script>
    <script src="~/js/scanner.js" asp-append-version="true"></script>
}
