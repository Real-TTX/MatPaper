@page "/Documents/Scan"
@model MatPaper.Pages.Documents.ScanModel
@{
    ViewData["Breadcrumb"] = L["Documents / Add"].Value;
    ViewData["AddTab"] = "camera";
}

<partial name="_AddDocumentTabs" />

@if (Model.Messages.Count > 0)
{
    <div class="notice notice--warn">
        <ul>
            @foreach (var message in Model.Messages)
            {
                <li>@message</li>
            }
        </ul>
    </div>
}

<form class="form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <div class="form-row">
        <label for="Title">@L["Title"]</label>
        <input class="form-control" type="text" id="Title" name="Title" value="@Model.Title" placeholder='@L["Optional"]' />
    </div>

    <mp-picker asp-for="CorrespondentId" label='@L["Correspondent"]' asp-items="Model.CorrespondentOptions"
               value="@(Model.CorrespondentId?.ToString())" placeholder='@L["— Auto-detect —"]' />

    <mp-picker asp-for="DocumentTypeId" label='@L["Document type"]' asp-items="Model.DocumentTypeOptions"
               value="@(Model.DocumentTypeId?.ToString())" placeholder='@L["— Auto-detect —"]' />

    <div class="form-row">
        <label for="Images">@L["Photos"]</label>
        <input class="form-control" type="file" id="Images" name="Images"
               accept="image/*" capture="environment" multiple />
        <span class="field-error" asp-validation-for="Images"></span>
    </div>

    <mp-button-row>
        <mp-button variant="primary" type="submit">@L["Create PDF"]</mp-button>
        <mp-button variant="secondary" href="/Documents">@L["Back"]</mp-button>
    </mp-button-row>
</form>
