@page "/Documents/Upload"
@model MatPaper.Pages.Documents.UploadModel
@{
    ViewData["Breadcrumb"] = L["Documents / Add"].Value;
    ViewData["Width"] = "narrow";
}

@if (Model.Messages.Count > 0)
{
    <div class="mat-alert mat-alert--warning" role="alert">
        <mp-icon name="alert" />
        <div class="mat-alert__body">
            <ul class="mat-alert__list">
                @foreach (var message in Model.Messages)
                {
                    <li>@message</li>
                }
            </ul>
        </div>
    </div>
}

<form id="upload-form" method="post" enctype="multipart/form-data" class="mat-form mp-add" novalidate data-no-busy data-camera="@(Model.Camera ? "1" : "")"
      data-ajax-url="/Documents/Upload?handler=Ajax" data-scan-url="/Documents/Upload?handler=Scan" data-inbox-url="/Inbox"
      data-t-queued='@L["Queued"]' data-t-uploading='@L["Uploading…"]' data-t-added='@L["Added"]'
      data-t-duplicate='@L["Duplicate — skipped"]' data-t-failed='@L["Failed"]'
      data-t-show-existing='@L["Show existing document"]' data-t-network-error='@L["Network error"]'
      data-t-summary-added='@L["{0} added"]' data-t-summary-duplicates='@L["{0} duplicate(s) skipped"]'
      data-t-summary-failed='@L["{0} failed"]' data-t-review-link='@L["Review them in your inbox →"]'
      data-t-archive-skipped='@L["{0} file(s) are no documents"]' data-t-processing='@L["Processing …"]'
      data-t-scan-pages='@L["Scan: {0} page(s)"]' data-t-remove='@L["Remove"]'>
    @Html.AntiForgeryToken()
    <partial name="_ValidationSummary" />

    <div class="mat-card" id="step-select">
        <div class="mat-card__head">
            <span class="mp-step-num" aria-hidden="true">1</span>
            <h2 class="mat-card__title">@L["Choose what to add"]</h2>
        </div>
        <div class="mat-card__body mat-stack">
            <div class="mat-field" id="uploader">
                <label class="mat-dropzone" for="Files" id="uploader-dropzone">
                    <mp-icon name="upload" />
                    <strong>@L["Drag & drop files here, or click to choose"]</strong>
                    <span class="mat-muted">@L["PDF, images, XRechnung (XML) or a ZIP archive with them."]</span>
                    <input type="file" id="Files" name="Files" multiple accept=".pdf,.xml,.zip,image/*" />
                </label>
                <span class="mat-error" id="Files-error" aria-live="polite">@(ViewData.ModelState.TryGetValue("Files", out var fileState) ? fileState.Errors.FirstOrDefault()?.ErrorMessage : null)</span>
            </div>

            <div class="mp-or" role="separator"><span>@L["or"]</span></div>

            <button type="button" class="mp-camera" id="add-camera">
                <span class="mp-camera__icon"><mp-icon name="camera" /></span>
                <span class="mp-camera__text">
                    <strong>@L["Scan with the camera"]</strong>
                    <span class="mat-muted">@L["Photograph pages; they are cropped and straightened automatically."]</span>
                </span>
            </button>

            <div class="mp-scan" id="add-scan" hidden>
                <strong data-scan-count></strong>
                <div class="mp-scan__strip" data-scan-strip></div>
                <mp-button variant="secondary" size="sm" type="button" icon="edit" id="add-scan-edit">@L["Edit pages"]</mp-button>
                <mp-icon-button icon="x" label='@L["Remove"]' id="add-scan-remove" />
            </div>

            <ul class="mp-upload-list" id="upload-list" hidden></ul>
        </div>
    </div>

    <div class="mat-card" id="step-details" hidden>
        <div class="mat-card__head">
            <span class="mp-step-num" aria-hidden="true">2</span>
            <h2 class="mat-card__title">@L["Details"]</h2>
            <span class="mat-muted">(@L["optional"])</span>
        </div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-field mat-field--full" id="add-title-row" hidden>
                    <label class="mat-label" for="add-title">@L["Title"]</label>
                    <input class="mat-input" type="text" id="add-title" name="Title" placeholder='@L["Optional"]' autocomplete="off" />
                    <span class="mat-error" aria-live="polite"></span>
                </div>

                <mp-picker asp-for="CorrespondentId" label='@L["Correspondent"]' asp-items="Model.CorrespondentOptions" placeholder='@L["— Auto-detect —"]' />
                <mp-picker asp-for="DocumentTypeId" label='@L["Document type"]' asp-items="Model.DocumentTypeOptions" placeholder='@L["— Auto-detect —"]' />
                <mp-picker asp-for="ProjectId" label='@L["Project"]' asp-items="Model.ProjectOptions" placeholder='@L["— None —"]' />
                <mp-picker asp-for="TagIds" label='@L["Tags"]' asp-items="Model.TagOptions" multiple="true" placeholder='@L["Add tags…"]' />
            </div>
        </div>
    </div>

    <mp-button-row class="mp-add__actions">
        <button class="mat-btn mat-btn--primary" type="submit" id="upload-submit" disabled>@Ui.Icon("plus")<span>@L["Add"]</span></button>
        <mp-button variant="ghost" href="/Documents" icon="back">@L["Back"]</mp-button>
    </mp-button-row>
</form>

<div id="scanner-config" hidden
     data-t-title='@L["Scanner"]' data-t-hint='@L["Hold the camera over the page"]' data-t-close='@L["Close"]'
     data-t-torch='@L["Light"]' data-t-auto='@L["Auto"]' data-t-shoot='@L["Take photo"]'
     data-t-found='@L["Page found"]' data-t-hold='@L["Hold still …"]' data-t-camera='@L["Camera"]' data-t-rotate='@L["Rotate"]'
     data-t-mode='@L["Camera mode"]' data-t-mode-live='@L["Live camera"]' data-t-mode-native='@L["Camera app"]'
     data-t-mode-live-hint='@L["Live camera"]' data-t-mode-native-hint='@L["Camera app: take the photo, it is judged afterwards"]'
     data-t-native-text='@L["The photo is taken with the camera app of your device - usually sharper, with autofocus."]'
     data-t-native-shoot='@L["Take photo"]' data-t-native-pick='@L["Choose photos"]'
     data-t-sensitivity='@L["Sensitivity"]' data-t-sens-low='@L["Low"]' data-t-sens-mid='@L["Medium"]' data-t-sens-high='@L["High"]'
     data-t-sens-low-hint='@L["Low: only a clearly visible page"]' data-t-sens-mid-hint='@L["Medium: balanced"]'
     data-t-sens-high-hint='@L["High: finds more, but may mistake reflections for the page"]'
     data-t-auto-on='@L["Auto: takes the photo when the page lies still"]' data-t-auto-off='@L["Auto off: tap the shutter"]'
     data-t-no-camera='@L["The camera is not available here (it needs HTTPS)."]'
     data-t-camera-denied='@L["No access to the camera. Allow it in the browser."]'
     data-t-auto-corners='@L["Detect again"]' data-t-turn-left='@L["Left"]' data-t-turn-right='@L["Right"]'
     data-t-apply='@L["Apply"]' data-t-back='@L["Back"]' data-t-adjust='@L["Drag the corners onto the page"]'
     data-t-f-enhanced='@L["Enhanced"]' data-t-f-color='@L["Original"]' data-t-f-gray='@L["Gray"]' data-t-f-bw='@L["Black & white"]'
     data-t-retake='@L["Retake"]' data-t-crop='@L["Crop"]' data-t-add-page='@L["Page"]' data-t-finish='@L["Done"]'
     data-t-cut-off='@L["The page is cut off - move back"]' data-t-cut-note='@L["The page is cut off at the edge of the photo - retake it with the whole page in view."]'
     data-t-closer='@L["Move closer"]' data-t-no-page='@L["No page found - drag the corners"]'
     data-t-no-page-note='@L["No page was found - the whole photo is used. Under Crop the corners can be set."]'
     data-t-pages='@L["Pages"]' data-t-page-n='@L["Page {0}"]' data-t-working='@L["Working …"]'
     data-t-move-left='@L["Move left"]' data-t-move-right='@L["Move right"]' data-t-delete='@L["Delete"]'></div>

@section Scripts {
    <script src="~/js/scanner-core.js" asp-append-version="true"></script>
    <script src="~/js/scanner.js" asp-append-version="true"></script>
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
