@page "/Inbox"
@using MatPaper.Data
@model MatPaper.Pages.Inbox.IndexModel
@{
    ViewData["Breadcrumb"] = L["Inbox"].Value;

    var originLabels = new Dictionary<DocumentOrigin, string>
    {
        [DocumentOrigin.Upload] = L["Upload"].Value,
        [DocumentOrigin.Mail] = L["E-mail"].Value,
        [DocumentOrigin.ImportFolder] = L["Import folder"].Value,
        [DocumentOrigin.CameraScan] = L["Camera scan"].Value,
        [DocumentOrigin.StorageScan] = L["Found"].Value
    };

    var locationLabel = Model.StorageLocations.FirstOrDefault(l => l.Id == Model.LocationId)?.Name;
    var originLabel = Model.Origin is DocumentOrigin o ? originLabels[o] : null;

    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search),
        new MatPaper.Services.FilterSpec("Origin", L["Origin"].Value, originLabel),
        new MatPaper.Services.FilterSpec("LocationId", L["Location"].Value, locationLabel),
        new MatPaper.Services.FilterSpec("Folder", L["Folder"].Value, Model.Folder),
        new MatPaper.Services.FilterSpec("State", L["Status"].Value, Model.ShowingIgnored ? L["Ignored"].Value : null),
        new MatPaper.Services.FilterSpec("AllOwners", L["Owned by"].Value, Model.IsAdmin && Model.AllOwners ? L["All"].Value : null));
}

<div class="mat-list" data-selectable>
    <mp-toolbar id="inbox" label='@L["Inbox"]' count="Model.TotalCount" singular="{0} document" plural="{0} documents" filter-size="md">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Title, file name or correspondent"]' />

        <mp-toolbar-select name="Origin" label='@L["Origin"]' value="@(Model.Origin?.ToString() ?? string.Empty)">
            <option value="">@L["All"]</option>
            @foreach (var entry in originLabels)
            {
                <option value="@entry.Key">@entry.Value</option>
            }
        </mp-toolbar-select>

        <mp-toolbar-select name="LocationId" label='@L["Location"]' value="@(Model.LocationId?.ToString() ?? string.Empty)">
            <option value="">@L["All locations"]</option>
            @foreach (var loc in Model.StorageLocations)
            {
                <option value="@loc.Id">@loc.Name</option>
            }
        </mp-toolbar-select>

        <div class="mat-field">
            <label class="mat-label" for="Folder">@L["Folder"]</label>
            <input class="mat-input" type="text" id="Folder" name="Folder" value="@Model.Folder" placeholder='@L["Path inside the location"]' autocomplete="off" />
        </div>

        <mp-toolbar-select name="State" label='@L["Status"]' value="@Model.State">
            <option value="open">@L["Waiting"]</option>
            <option value="ignored">@L["Ignored"]</option>
        </mp-toolbar-select>

        @if (Model.IsAdmin)
        {
            @* A filter is always a dropdown: whose documents the inbox shows. *@
            <mp-toolbar-select name="AllOwners" label='@L["Owned by"]' value="@(Model.AllOwners ? "true" : "false")">
                <option value="false">@L["Own"]</option>
                <option value="true">@L["All"]</option>
            </mp-toolbar-select>
        }

        <mp-toolbar-sort value="@Model.Sort">
            <option value="added">@L["Recently added"]</option>
            <option value="oldest">@L["Oldest first"]</option>
            <option value="date">@L["Document date"]</option>
            <option value="title">@L["Title"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="activeFilters" />

    @if (!Model.HasStorage && Model.TotalCount > 0)
    {
        <div class="mat-alert mat-alert--warning" role="alert">
            <mp-icon name="alert" />
            <div class="mat-alert__body">
                @L["No storage location configured — documents can't be filed yet."]
                @if (Model.IsAdmin)
                {
                    <a href="/System/StorageLocations/Edit">@L["Create one"]</a>
                }
            </div>
        </div>
    }

    @if (Model.TotalCount == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><mp-icon name="inbox" /></span>
            @if (activeFilters.Any)
            {
                <div class="mat-empty__title">@L["No document matches your filter."]</div>
                <mp-button variant="secondary" href="@activeFilters.ClearAllUrl" icon="x">@L["Clear all"]</mp-button>
            }
            else
            {
                <div class="mat-empty__title">@(Model.ShowingIgnored ? L["Nothing ignored"] : L["Inbox empty"])</div>
                <div class="mat-row">
                    <mp-button variant="primary" href="/Documents/Upload" icon="plus">@L["Upload"]</mp-button>
                    @if (Model.IsAdmin)
                    {
                        <mp-button variant="secondary" href="/System/StorageLocations" icon="search">@L["Search storage for files"]</mp-button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        @* Shown by inbox.js once processing is done but the user is mid-edit. *@
        <div id="inbox-refresh" class="mat-alert mat-alert--info" role="status" hidden>
            <mp-icon name="refresh" />
            <div class="mat-alert__body"><strong>@L["Processing finished"]</strong></div>
            <mp-button variant="primary" size="sm" href="">@L["Reload"]</mp-button>
        </div>

        <div class="mp-inbox-list" data-inbox>
            @foreach (var row in Model.Rows)
            {
                <partial name="_Row" model="new MatPaper.Pages.Inbox.IndexModel.RowContext(Model, row)" />
            }
        </div>

        <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />

        @if (!Model.ShowingIgnored)
        {
            @* Only while something is ticked: what to do with the selection. The values to set sit in a dialog. *@
            <form method="post" id="inbox-bulk" class="mp-inbox-bulk" asp-page-handler="Bulk"
                  asp-route-Search="@Model.Search" asp-route-Origin="@Model.Origin" asp-route-LocationId="@Model.LocationId"
                  asp-route-Folder="@Model.Folder" asp-route-State="@(Model.ShowingIgnored ? "ignored" : null)"
                  asp-route-AllOwners="@Model.AllOwners" asp-route-Sort="@Model.Sort" asp-route-PageNumber="@Model.PageNumber">
                <div class="mat-bulk" role="region" aria-label='@L["Selection"]' data-bulk-bar hidden>
                    <label class="mat-check">
                        <input type="checkbox" data-select-all aria-label='@L["Select all"]' />
                        <span class="mat-check__text"><span>@Html.Raw(string.Format(L["{0} selected"].Value, "<span data-bulk-count></span>"))</span></span>
                    </label>
                    @* More than one page: the whole list can be taken in one go (the same batch limit as before). *@
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" id="inbox-select-matching" hidden
                            data-total="@Model.TotalCount" data-t-all='@L["Select all {0}"]' data-t-page='@L["Only this page"]'></button>
                    <input type="hidden" name="allMatching" id="inbox-all-matching" value="false" />
                    <span class="mat-bulk__actions mat-row">
                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="inbox-bulk-open" data-dialog-open="inbox-bulk-dialog" data-t-label='@L["Set values …"]'>@Ui.Icon("sliders")<span>@L["Set values …"]</span></button>
                        <button class="mat-btn mat-btn--secondary mat-btn--sm" type="submit" name="action" value="analyze">@Ui.Icon("sparkles")<span>@L["Analyze selected"]</span></button>
                        <button class="mat-btn mat-btn--secondary mat-btn--sm" type="submit" name="action" value="ignore">@Ui.Icon("eye-off")<span>@L["Ignore"]</span></button>
                        <button class="mat-btn mat-btn--primary mat-btn--sm" type="submit" name="action" value="confirm">@Ui.Icon("check")<span>@L["Take into archive"]</span></button>
                    </span>
                </div>

                <dialog class="mat-dialog mat-dialog--lg" id="inbox-bulk-dialog" aria-labelledby="inbox-bulk-title" data-static>
                    <div class="mat-dialog__form">
                        <div class="mat-dialog__head">
                            @Ui.Icon("sliders")
                            <h2 class="mat-dialog__title" id="inbox-bulk-title">@L["Apply to selection"]</h2>
                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label='@L["Close"]'>@Ui.Icon("x")</button>
                        </div>
                        <div class="mat-dialog__body mat-form">
                            <p class="mat-muted">@L["What is left empty stays as it is."]</p>
                            <div class="mat-form__grid">
                                <mp-picker asp-for="BulkCorrespondentId" label='@L["Correspondent"]' asp-items="Model.CorrespondentOptions" placeholder='@L["— Unchanged —"]' />
                                <mp-picker asp-for="BulkDocumentTypeId" label='@L["Type"]' asp-items="Model.DocumentTypeOptions" placeholder='@L["— Unchanged —"]' />
                                <mp-picker asp-for="BulkProjectId" label='@L["Project"]' asp-items="Model.ProjectOptions" placeholder='@L["— Unchanged —"]' />
                                <mp-picker asp-for="BulkTagIds" label='@L["Tags"]' asp-items="Model.TagItems" multiple="true" placeholder='@L["Add tags…"]' />
                                <fieldset class="mat-field mat-fieldset mat-field--full">
                                    <legend class="mat-legend">@L["Filing"]</legend>
                                    <div class="mat-checks mat-checks--inline">
                                        <label class="mat-check"><input type="radio" name="mode" value="keep" checked /><span class="mat-check__text">@L["Keep in place"]</span></label>
                                        <label class="mat-check"><input type="radio" name="mode" value="refile" /><span class="mat-check__text">@L["Re-file by template"]</span></label>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                        <div class="mat-dialog__foot">
                            <div class="mat-btn-row mat-btn-row--plain">
                                <button type="button" class="mat-btn mat-btn--primary" data-dialog-close>@Ui.Icon("check")<span>@L["Done"]</span></button>
                            </div>
                        </div>
                    </div>
                </dialog>
            </form>
        }
    }
</div>

@section Scripts {
    <script src="~/js/inbox.js" asp-append-version="true" defer></script>
}
