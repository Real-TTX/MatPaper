@page "/Inbox"
@using MatPaper.Data
@model MatPaper.Pages.Inbox.IndexModel
@{
    ViewData["Breadcrumb"] = L["Inbox"].Value;
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Title or correspondent"]' />
</mp-toolbar>

@if (TempData["InboxMessage"] is string inboxMessage && !string.IsNullOrEmpty(inboxMessage))
{
    <div class="form-summary" style="color:var(--color-text)">@inboxMessage</div>
}
@if (TempData["InboxError"] is string inboxError && !string.IsNullOrEmpty(inboxError))
{
    <div class="form-summary">@inboxError</div>
}
@if (!Model.HasStorage && Model.TotalCount > 0)
{
    <div class="form-summary">
        @L["No storage location configured — documents can't be filed yet."]
        @if (Model.IsAdmin)
        {
            <a href="/System/StorageLocations/Edit">@L["Create one"]</a>
        }
    </div>
}
<div id="inbox-refresh" class="form-summary" style="color:var(--color-text)" hidden>
    @L["Processing finished"] — <a href="">@L["reload to see the suggestions."]</a>
</div>

@if (Model.TotalCount == 0)
{
    <div class="empty-state">@L["Inbox empty"] · <a href="/Documents/Upload">@L["Upload"]</a></div>
}
else
{
    <div class="list-header">
        <span class="form-help" style="margin:0">
            @Model.TotalCount @L["to review"]@(Model.ProcessingCount > 0 ? " · " + Model.ProcessingCount + " " + L["processing"].Value : string.Empty)
        </span>
        <form method="post" asp-page-handler="ConfirmAll" style="margin-left:auto">
            <button class="btn btn--secondary" type="submit" disabled="@(!Model.HasStorage)"
                    onclick='return confirm("@L["File all processed documents with their current suggestions?"]")'>
                @L["Confirm all"]
            </button>
        </form>
    </div>

    @foreach (var row in Model.Rows)
    {
        var processing = row.OcrState == OcrState.Pending;
        var failed = row.OcrState == OcrState.Failed;
        var suffix = row.Id.ToString();
        var selectedLocation = row.StorageLocationId ?? Model.DefaultLocationId;

        <article class="inbox-item @(processing ? "is-processing" : string.Empty)"
                 data-doc-id="@row.Id" data-ocr="@row.OcrState.ToString().ToLowerInvariant()">
            <form method="post" asp-page-handler="Confirm" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber">
                <input type="hidden" name="id" value="@row.Id" />

                <div class="inbox-item__head">
                    <a class="inbox-item__thumb" href="/Documents/@row.Token/view" target="_blank" rel="noopener" title='@L["Preview"]'>
                        @if (row.ThumbnailPath != null)
                        {
                            <img src="/Documents/@row.Token/thumb" alt="" width="44" height="58" />
                        }
                        else
                        {
                            <span class="inbox-item__thumb-empty" aria-hidden="true"></span>
                        }
                    </a>
                    <input class="form-control inbox-item__title" type="text" name="title" value="@row.Title" aria-label='@L["Title"]' />
                    <span class="inbox-item__meta">
                        @if (processing)
                        {
                            <span class="badge badge--muted">@L["Processing…"]</span>
                        }
                        else if (failed)
                        {
                            <span class="badge badge--off">@L["OCR failed"]</span>
                        }
                        <span title="@row.OriginalFileName">@Fmt.Date(row.AddedDate)</span>
                    </span>
                </div>

                <div class="inbox-grid">
                    <mp-picker asp-for="CorrespondentId" label='@L["Correspondent"]' asp-items="Model.CorrespondentOptions"
                               value="@(row.CorrespondentId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                    <mp-picker asp-for="DocumentTypeId" label='@L["Type"]' asp-items="Model.DocumentTypeOptions"
                               value="@(row.DocumentTypeId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                    <div class="form-row">
                        <label for="documentDate_@suffix">@L["Date"]</label>
                        <input class="form-control" type="date" id="documentDate_@suffix" name="documentDate"
                               value="@Fmt.InputDate(row.DocumentDate)" />
                    </div>
                    <mp-picker asp-for="ProjectId" label='@L["Project"]' asp-items="Model.ProjectOptions"
                               value="@(row.ProjectId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                    <mp-picker asp-for="TagIds" label='@L["Tags"]' asp-items="Model.TagItems" multiple="true"
                               value="@string.Join(",", row.TagIds)" id-suffix="@suffix" placeholder='@L["Add tags…"]' />
                    <div class="form-row">
                        <label for="storageLocationId_@suffix">@L["File to"]</label>
                        <select class="form-control" id="storageLocationId_@suffix" name="storageLocationId">
                            @foreach (var loc in Model.StorageLocations)
                            {
                                <option value="@loc.Id" selected="@(loc.Id == selectedLocation)">@loc.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="inbox-item__actions">
                    <button class="btn btn--primary" type="submit" disabled="@(processing || !Model.HasStorage)"
                            title='@(processing ? L["Still processing"].Value : L["Apply the values above, file the document and mark it reviewed"].Value)'>
                        @L["Confirm & file"]
                    </button>
                    <a class="btn btn--secondary" href="/Documents/Edit?id=@row.Id&returnUrl=%2FInbox">@L["Open"]</a>
                    <span class="icon-actions inbox-item__tools">
                        <button class="icon-btn icon-btn--danger" type="submit" form="inbox-delete-@row.Id" title='@L["Delete"]'
                                onclick='return confirm("@L["Delete this document?"]")'>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6" /><path d="M14 11v6" />
                            </svg>
                        </button>
                    </span>
                </div>
            </form>
            <form method="post" id="inbox-delete-@row.Id" asp-page-handler="Delete"
                  asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber">
                <input type="hidden" name="id" value="@row.Id" />
            </form>
        </article>
    }

    <mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
}

@section Scripts {
    <script>
        // While documents are still being processed (OCR), poll their state and reload
        // once suggestions are available — unless the user has started editing a row.
        (function () {
            var pending = Array.prototype.map.call(
                document.querySelectorAll('.inbox-item[data-ocr="pending"]'),
                function (el) { return el.getAttribute("data-doc-id"); });
            if (!pending.length) { return; }

            var dirty = false;
            document.addEventListener("input", function () { dirty = true; }, true);
            document.addEventListener("change", function () { dirty = true; }, true);

            function tick() {
                var qs = pending.map(function (id) { return "ids=" + encodeURIComponent(id); }).join("&");
                fetch("/Inbox?handler=Status&" + qs, { credentials: "same-origin", headers: { "Accept": "application/json" } })
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (rows) {
                        var done = rows.some(function (r) { return r.state !== "pending"; });
                        if (!done) { setTimeout(tick, 3000); return; }
                        if (!dirty) { location.reload(); return; }
                        var note = document.getElementById("inbox-refresh");
                        if (note) { note.hidden = false; }
                    })
                    .catch(function () { setTimeout(tick, 5000); });
            }

            setTimeout(tick, 3000);
        })();
    </script>
}
