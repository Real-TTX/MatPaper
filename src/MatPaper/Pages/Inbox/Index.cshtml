@page "/Inbox"
@using MatPaper.Data
@model MatPaper.Pages.Inbox.IndexModel
@{
    ViewData["Breadcrumb"] = L["Inbox"].Value;

    var originLabels = new Dictionary<DocumentOrigin, string>
    {
        [DocumentOrigin.Upload] = L["Upload"].Value,
        [DocumentOrigin.Mail] = L["E-mail"].Value,
        [DocumentOrigin.ImportFolder] = L["Import folder"].Value,
        [DocumentOrigin.CameraScan] = L["Camera scan"].Value,
        [DocumentOrigin.StorageScan] = L["Found"].Value
    };

    var locationLabel = Model.StorageLocations.FirstOrDefault(l => l.Id == Model.LocationId)?.Name;
    var originLabel = Model.Origin is DocumentOrigin o ? originLabels[o] : null;

    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search),
        new MatPaper.Services.FilterSpec("Origin", L["Origin"].Value, originLabel),
        new MatPaper.Services.FilterSpec("LocationId", L["Location"].Value, locationLabel),
        new MatPaper.Services.FilterSpec("Folder", L["Folder"].Value, Model.Folder),
        new MatPaper.Services.FilterSpec("State", L["Status"].Value, Model.ShowingIgnored ? L["Ignored"].Value : null),
        new MatPaper.Services.FilterSpec("AllOwners", L["Owned by"].Value, Model.IsAdmin && Model.AllOwners ? L["All"].Value : null));
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Title, file name or correspondent"]' />
    <mp-toolbar-select name="Origin" label='@L["Origin"]' value="@(Model.Origin?.ToString() ?? string.Empty)">
        <option value="">@L["All"]</option>
        @foreach (var entry in originLabels)
        {
            <option value="@entry.Key">@entry.Value</option>
        }
    </mp-toolbar-select>
    <mp-toolbar-select name="LocationId" label='@L["Location"]' value="@(Model.LocationId?.ToString() ?? string.Empty)">
        <option value="">@L["All locations"]</option>
        @foreach (var loc in Model.StorageLocations)
        {
            <option value="@loc.Id">@loc.Name</option>
        }
    </mp-toolbar-select>
    <mp-toolbar-search name="Folder" value="@Model.Folder" label='@L["Folder"]' placeholder='@L["Path inside the location"]' />
    <mp-toolbar-select name="State" label='@L["Status"]' value="@Model.State">
        <option value="open">@L["Waiting"]</option>
        <option value="ignored">@L["Ignored"]</option>
    </mp-toolbar-select>
    <mp-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="added">@L["Recently added"]</option>
        <option value="oldest">@L["Oldest first"]</option>
        <option value="date">@L["Document date"]</option>
        <option value="title">@L["Title"]</option>
    </mp-toolbar-select>
    @if (Model.IsAdmin)
    {
        @* A filter is always a dropdown: whose documents the inbox shows. *@
        <mp-toolbar-select name="AllOwners" label='@L["Owned by"]' value="@(Model.AllOwners ? "true" : "false")">
            <option value="false">@L["Own"]</option>
            <option value="true">@L["All"]</option>
        </mp-toolbar-select>
    }
</mp-toolbar>

<partial name="_FilterChips" model="activeFilters" />

@if (!Model.HasStorage && Model.TotalCount > 0)
{
    <div class="notice notice--warn">
        @L["No storage location configured — documents can't be filed yet."]
        @if (Model.IsAdmin)
        {
            <a href="/System/StorageLocations/Edit">@L["Create one"]</a>
        }
    </div>
}
@if (Model.TotalCount == 0)
{
    <div class="empty-state">
        @if (activeFilters.Any)
        {
            @L["No document matches your filter."]<text> · </text><a href="@activeFilters.ClearAllUrl">@L["Clear all"]</a>
        }
        else
        {
            @(Model.ShowingIgnored ? L["Nothing ignored"] : L["Inbox empty"])<text> · </text>
            <a href="/Documents/Upload">@L["Upload"]</a>
            @if (Model.IsAdmin)
            {
                <text> · </text><a href="/System/StorageLocations">@L["Search storage for files"]</a>
            }
        }
    </div>
}
else
{
    <mp-list-bar count="Model.TotalCount" singular="{0} document" plural="{0} documents" current-page="Model.PageNumber" total-pages="Model.TotalPages" />

    @* Shown by the script below once processing is done but the user is mid-edit: it takes the
       place of the first list entry instead of a bar above the list. *@
    <div id="inbox-refresh" class="inbox-refresh" role="status" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 4v5h-5" /></svg>
        <strong>@L["Processing finished"]</strong>
        <a class="btn btn--primary" href="">@L["Reload"]</a>
    </div>

    @foreach (var row in Model.Rows)
    {
        <partial name="_Row" model="new MatPaper.Pages.Inbox.IndexModel.RowContext(Model, row)" />
    }

    @if (!Model.ShowingIgnored)
    {
        @* Only while something is ticked: what to do with the selection. The values to set sit in a dialog. *@
        <form method="post" id="inbox-bulk" class="inbox-bulk" asp-page-handler="Bulk"
              asp-route-Search="@Model.Search" asp-route-Origin="@Model.Origin" asp-route-LocationId="@Model.LocationId"
              asp-route-Folder="@Model.Folder" asp-route-State="@(Model.ShowingIgnored ? "ignored" : null)"
              asp-route-AllOwners="@Model.AllOwners" asp-route-Sort="@Model.Sort" asp-route-PageNumber="@Model.PageNumber">
            <div class="selection-bar" role="region" aria-label='@L["Selection"]' hidden
                 data-t-selected='@L["{0} selected"]' data-t-all-selected='@L["All {0} selected"]'>
                <label class="selection-bar__all">
                    <input type="checkbox" id="inbox-select-all" aria-label='@L["Select all"]' />
                    <span class="selection-bar__count"></span>
                </label>
                @* More than one page: the whole list can be taken in one go (the same batch limit as before). *@
                <button type="button" class="selection-bar__link" id="inbox-select-matching" hidden
                        data-total="@Model.TotalCount" data-t-all='@L["Select all {0}"]' data-t-page='@L["Only this page"]'></button>
                <input type="hidden" name="allMatching" id="inbox-all-matching" value="false" />
                <span class="selection-bar__actions">
                    <button type="button" class="btn btn--secondary" id="inbox-bulk-open" data-t-label='@L["Set values …"]'>@L["Set values …"]</button>
                    <button class="btn btn--secondary" type="submit" name="action" value="analyze">@L["Analyze selected"]</button>
                    <button class="btn btn--secondary" type="submit" name="action" value="ignore">@L["Ignore"]</button>
                    <button class="btn btn--primary" type="submit" name="action" value="confirm">@L["Take into archive"]</button>
                </span>
            </div>

            <dialog class="filter-dialog filter-dialog--bulk" id="inbox-bulk-dialog">
                <div class="filter-dialog__head">
                    <div>
                        <h2 class="filter-dialog__title">@L["Apply to selection"]</h2>
                        <div class="filter-dialog__sub">@L["What is left empty stays as it is."]</div>
                    </div>
                    <button type="button" class="icon-btn filter-dialog__close" data-close-dialog aria-label='@L["Close"]'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                </div>
                <div class="filter-dialog__body">
                    <mp-picker asp-for="BulkCorrespondentId" label='@L["Correspondent"]' asp-items="Model.CorrespondentOptions"
                               placeholder='@L["— Unchanged —"]' />
                    <mp-picker asp-for="BulkDocumentTypeId" label='@L["Type"]' asp-items="Model.DocumentTypeOptions"
                               placeholder='@L["— Unchanged —"]' />
                    <mp-picker asp-for="BulkProjectId" label='@L["Project"]' asp-items="Model.ProjectOptions"
                               placeholder='@L["— Unchanged —"]' />
                    <mp-picker asp-for="BulkTagIds" label='@L["Tags"]' asp-items="Model.TagItems" multiple="true"
                               placeholder='@L["Add tags…"]' />
                    <div class="form-row">
                        <label>@L["Filing"]</label>
                        <div class="checkbox-group">
                            <label class="form-check">
                                <input type="radio" name="mode" value="keep" checked />
                                <span>@L["Keep in place"]</span>
                            </label>
                            <label class="form-check">
                                <input type="radio" name="mode" value="refile" />
                                <span>@L["Re-file by template"]</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="filter-dialog__foot">
                    <span></span>
                    <button type="button" class="btn btn--primary" data-close-dialog>@L["Done"]</button>
                </div>
            </dialog>
        </form>
    }

    <mp-list-bar position="bottom" />
}

@section Scripts {
    <script>
        // Phones: project, tags and filing sit behind "More fields".
        document.addEventListener("click", function (e) {
            var btn = e.target.closest && e.target.closest(".inbox-more-toggle");
            if (!btn) { return; }
            var item = btn.closest(".inbox-item");
            var open = item.classList.toggle("is-expanded");
            btn.setAttribute("aria-expanded", open ? "true" : "false");
        });
    </script>
    <script>
        // While documents are still being processed (OCR), poll their state and reload
        // once suggestions are available — unless the user has started editing a row.
        (function () {
            var pending = Array.prototype.map.call(
                document.querySelectorAll('.inbox-item[data-ocr="pending"]'),
                function (el) { return el.getAttribute("data-doc-id"); });
            if (!pending.length) { return; }

            var dirty = false;
            document.addEventListener("input", function () { dirty = true; }, true);
            document.addEventListener("change", function () { dirty = true; }, true);

            function tick() {
                var qs = pending.map(function (id) { return "ids=" + encodeURIComponent(id); }).join("&");
                fetch("/Inbox?handler=Status&" + qs, { credentials: "same-origin", headers: { "Accept": "application/json" } })
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (rows) {
                        // A row the endpoint no longer returns is gone (deleted, reassigned):
                        // treat that as done so the poll cannot run forever.
                        var seen = {};
                        rows.forEach(function (r) { seen[r.id] = r.state; });
                        var done = pending.some(function (id) { return seen[id] === undefined || seen[id] !== "pending"; });
                        if (!done) { setTimeout(tick, 3000); return; }
                        if (!dirty) { location.reload(); return; }
                        var note = document.getElementById("inbox-refresh");
                        if (note) { note.hidden = false; }
                    })
                    .catch(function () { setTimeout(tick, 5000); });
            }

            setTimeout(tick, 3000);
        })();

        // The selection bar shows only while something is ticked; its box ticks or clears the whole page.
        (function () {
            var bar = document.querySelector(".selection-bar");
            if (!bar) { return; }
            var master = document.getElementById("inbox-select-all");
            var count = bar.querySelector(".selection-bar__count");
            var dialog = document.getElementById("inbox-bulk-dialog");

            function boxes() { return Array.prototype.slice.call(document.querySelectorAll('input[name="selectedIds"]')); }

            var matchingButton = document.getElementById("inbox-select-matching");
            var matchingFlag = document.getElementById("inbox-all-matching");
            var total = parseInt(matchingButton.getAttribute("data-total"), 10) || 0;
            var matching = false;

            function setMatching(on) {
                matching = on;
                matchingFlag.value = on ? "true" : "false";
            }

            function refresh() {
                var all = boxes();
                var n = all.filter(function (b) { return b.checked; }).length;
                if (n < all.length) { setMatching(false); }
                bar.hidden = n === 0;
                document.documentElement.classList.toggle("has-selection", n > 0);
                var shown = matching ? total : n;
                count.textContent = (bar.getAttribute(matching ? "data-t-all-selected" : "data-t-selected") || "{0} selected").replace("{0}", String(shown));
                master.checked = n > 0 && n === all.length;
                master.indeterminate = n > 0 && n < all.length;
                // the whole page is ticked and there is more behind it
                matchingButton.hidden = !(all.length > 0 && n === all.length && total > all.length);
                matchingButton.textContent = matching
                    ? (matchingButton.getAttribute("data-t-page") || "Only this page")
                    : (matchingButton.getAttribute("data-t-all") || "Select all {0}").replace("{0}", String(total));
                all.forEach(function (b) {
                    var card = b.closest(".inbox-item");
                    if (card) { card.classList.toggle("is-selected", b.checked); }
                });
            }

            document.addEventListener("change", function (event) {
                if (event.target && event.target.name === "selectedIds") { setMatching(false); refresh(); }
            });
            master.addEventListener("change", function () {
                setMatching(false);
                boxes().forEach(function (b) { b.checked = master.checked; });
                refresh();
            });
            matchingButton.addEventListener("click", function () { setMatching(!matching); refresh(); });

            // the values to set for the selection
            var openButton = document.getElementById("inbox-bulk-open");
            if (dialog && openButton) {
                openButton.addEventListener("click", function () { dialog.showModal(); });
                dialog.addEventListener("click", function (event) {
                    if (event.target === dialog || (event.target.closest && event.target.closest("[data-close-dialog]"))) { dialog.close(); }
                });
                dialog.addEventListener("close", function () {
                    var set = 0;
                    dialog.querySelectorAll(".mp-picker").forEach(function (picker) {
                        var hidden = picker.querySelector(".mp-picker__value");
                        if (hidden ? hidden.value !== "" : picker.querySelector(".mp-picker__chip")) { set++; }
                    });
                    var label = openButton.getAttribute("data-t-label") || "";
                    openButton.textContent = set > 0 ? label.replace(" …", "") + " (" + set + ")" : label;
                });
            }

            refresh();
        })();
    </script>
}
