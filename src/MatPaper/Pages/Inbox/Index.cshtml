@page "/Inbox"
@using MatPaper.Data
@model MatPaper.Pages.Inbox.IndexModel
@{
    ViewData["Breadcrumb"] = L["Inbox"].Value;

    var originLabels = new Dictionary<DocumentOrigin, string>
    {
        [DocumentOrigin.Upload] = L["Upload"].Value,
        [DocumentOrigin.Mail] = L["E-mail"].Value,
        [DocumentOrigin.ImportFolder] = L["Import folder"].Value,
        [DocumentOrigin.CameraScan] = L["Camera scan"].Value,
        [DocumentOrigin.StorageScan] = L["Found"].Value
    };

    var locationLabel = Model.StorageLocations.FirstOrDefault(l => l.Id == Model.LocationId)?.Name;
    var originLabel = Model.Origin is DocumentOrigin o ? originLabels[o] : null;

    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search),
        new MatPaper.Services.FilterSpec("Origin", L["Origin"].Value, originLabel),
        new MatPaper.Services.FilterSpec("LocationId", L["Location"].Value, locationLabel),
        new MatPaper.Services.FilterSpec("Folder", L["Folder"].Value, Model.Folder),
        new MatPaper.Services.FilterSpec("State", L["Status"].Value, Model.ShowingIgnored ? L["Ignored"].Value : null));
}

<mp-toolbar count="Model.TotalCount">
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Title, file name or correspondent"]' />
    <mp-toolbar-select name="Origin" label='@L["Origin"]' value="@(Model.Origin?.ToString() ?? string.Empty)">
        <option value="">@L["All"]</option>
        @foreach (var entry in originLabels)
        {
            <option value="@entry.Key">@entry.Value</option>
        }
    </mp-toolbar-select>
    <mp-toolbar-select name="LocationId" label='@L["Location"]' value="@(Model.LocationId?.ToString() ?? string.Empty)">
        <option value="">@L["All locations"]</option>
        @foreach (var loc in Model.StorageLocations)
        {
            <option value="@loc.Id">@loc.Name</option>
        }
    </mp-toolbar-select>
    <mp-toolbar-search name="Folder" value="@Model.Folder" label='@L["Folder"]' placeholder='@L["Path inside the location"]' />
    <mp-toolbar-select name="State" label='@L["Status"]' value="@Model.State">
        <option value="open">@L["Waiting"]</option>
        <option value="ignored">@L["Ignored"]</option>
    </mp-toolbar-select>
    @if (Model.IsAdmin)
    {
        <div class="toolbar__group toolbar__filter">
            <label for="AllOwners">@L["All owners"]</label>
            <input type="checkbox" id="AllOwners" name="AllOwners" value="true" checked="@Model.AllOwners" />
        </div>
    }
</mp-toolbar>

<partial name="_FilterChips" model="activeFilters" />

@if (!Model.HasStorage && Model.TotalCount > 0)
{
    <div class="notice notice--warn">
        @L["No storage location configured — documents can't be filed yet."]
        @if (Model.IsAdmin)
        {
            <a href="/System/StorageLocations/Edit">@L["Create one"]</a>
        }
    </div>
}
<div id="inbox-refresh" class="notice notice--info" hidden>
    @L["Processing finished"] — <a href="">@L["reload to see the suggestions."]</a>
</div>

@if (Model.TotalCount == 0)
{
    <div class="empty-state">
        @if (activeFilters.Any)
        {
            @L["No document matches your filter."]<text> · </text><a href="@activeFilters.ClearAllUrl">@L["Clear all"]</a>
        }
        else
        {
            @(Model.ShowingIgnored ? L["Nothing ignored"] : L["Inbox empty"])<text> · </text>
            <a href="/Documents/Upload">@L["Upload"]</a>
            @if (Model.IsAdmin)
            {
                <text> · </text><a href="/System/StorageLocations">@L["Search storage for files"]</a>
            }
        }
    </div>
}
else
{
    <div class="list-header">
        <span class="form-help" style="margin:0">
            @if (Model.ShowingIgnored)
            {
                @L["{0} ignored", Model.TotalCount]
            }
            else
            {
                @L["{0} in the inbox · {1} found · {2} being processed", Model.TotalCount, Model.FoundCount, Model.ProcessingCount]
            }
        </span>

        @if (!Model.ShowingIgnored)
        {
            <span class="list-header__actions" style="margin-left:auto">
                @if (Model.LocationId is long filteredLocation && Model.FoundCount > 0)
                {
                    <form method="post" asp-page-handler="IgnoreAllFound" asp-route-LocationId="@Model.LocationId"
                          asp-route-Search="@Model.Search" asp-route-Origin="@Model.Origin" asp-route-Folder="@Model.Folder"
                          asp-route-AllOwners="@Model.AllOwners" style="display:inline">
                        <input type="hidden" name="locationId" value="@filteredLocation" />
                        <button class="btn btn--secondary" type="submit"
                                data-confirm='@L["Ignore {0} found file(s) in \"{1}\"? The files stay where they are.", Model.FoundCount, locationLabel ?? string.Empty]'>
                            @L["Ignore all found files in this location"]
                        </button>
                    </form>
                }
                <form method="post" asp-page-handler="ConfirmAll"
                      asp-route-Search="@Model.Search" asp-route-Origin="@Model.Origin" asp-route-LocationId="@Model.LocationId"
                      asp-route-Folder="@Model.Folder" asp-route-AllOwners="@Model.AllOwners" style="display:inline">
                    <button class="btn btn--secondary" type="submit" disabled="@(!Model.HasStorage)"
                            data-confirm='@L["File all processed documents with their current suggestions?"]'>
                        @L["Confirm all"]
                    </button>
                </form>
            </span>
        }
    </div>

    @foreach (var row in Model.Rows)
    {
        <partial name="_Row" model="new MatPaper.Pages.Inbox.IndexModel.RowContext(Model, row)" />
    }

    @if (!Model.ShowingIgnored)
    {
    <form method="post" id="inbox-bulk" class="form form--wide inbox-bulk" asp-page-handler="Bulk"
          asp-route-Search="@Model.Search" asp-route-Origin="@Model.Origin" asp-route-LocationId="@Model.LocationId"
          asp-route-Folder="@Model.Folder" asp-route-State="@(Model.ShowingIgnored ? "ignored" : null)"
          asp-route-AllOwners="@Model.AllOwners" asp-route-PageNumber="@Model.PageNumber">
        <h2>@L["Apply to selection"]</h2>
        <p class="form-help">
            <label class="form-check">
                <input type="checkbox" id="inbox-select-all" />
                <span>@L["Select all on this page"]</span>
            </label>
        </p>

        <div class="inbox-grid">
            <mp-picker asp-for="BulkCorrespondentId" label='@L["Correspondent"]' asp-items="Model.CorrespondentOptions"
                       placeholder='@L["— Unchanged —"]' />
            <mp-picker asp-for="BulkDocumentTypeId" label='@L["Type"]' asp-items="Model.DocumentTypeOptions"
                       placeholder='@L["— Unchanged —"]' />
            <mp-picker asp-for="BulkProjectId" label='@L["Project"]' asp-items="Model.ProjectOptions"
                       placeholder='@L["— Unchanged —"]' />
            <mp-picker asp-for="BulkTagIds" label='@L["Tags"]' asp-items="Model.TagItems" multiple="true"
                       placeholder='@L["Add tags…"]' />
            <div class="form-row">
                <label>@L["Filing"]</label>
                <div class="checkbox-group">
                    <label class="form-check">
                        <input type="radio" name="mode" value="keep" checked />
                        <span>@L["Keep in place"]</span>
                    </label>
                    <label class="form-check">
                        <input type="radio" name="mode" value="refile" />
                        <span>@L["Re-file by template"]</span>
                    </label>
                </div>
            </div>
        </div>

        <mp-button-row>
            <button class="btn btn--primary" type="submit" name="action" value="confirm">@L["Take into archive"]</button>
            <button class="btn btn--secondary" type="submit" name="action" value="analyze">@L["Analyze selected"]</button>
            <mp-button-spacer />
            <button class="btn btn--secondary" type="submit" name="action" value="ignore">@L["Ignore"]</button>
        </mp-button-row>
    </form>
    }

    <mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
}

@section Scripts {
    <script>
        // While documents are still being processed (OCR), poll their state and reload
        // once suggestions are available — unless the user has started editing a row.
        (function () {
            var pending = Array.prototype.map.call(
                document.querySelectorAll('.inbox-item[data-ocr="pending"]'),
                function (el) { return el.getAttribute("data-doc-id"); });
            if (!pending.length) { return; }

            var dirty = false;
            document.addEventListener("input", function () { dirty = true; }, true);
            document.addEventListener("change", function () { dirty = true; }, true);

            function tick() {
                var qs = pending.map(function (id) { return "ids=" + encodeURIComponent(id); }).join("&");
                fetch("/Inbox?handler=Status&" + qs, { credentials: "same-origin", headers: { "Accept": "application/json" } })
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (rows) {
                        // A row the endpoint no longer returns is gone (deleted, reassigned):
                        // treat that as done so the poll cannot run forever.
                        var seen = {};
                        rows.forEach(function (r) { seen[r.id] = r.state; });
                        var done = pending.some(function (id) { return seen[id] === undefined || seen[id] !== "pending"; });
                        if (!done) { setTimeout(tick, 3000); return; }
                        if (!dirty) { location.reload(); return; }
                        var note = document.getElementById("inbox-refresh");
                        if (note) { note.hidden = false; }
                    })
                    .catch(function () { setTimeout(tick, 5000); });
            }

            setTimeout(tick, 3000);
        })();

        // "Select all on this page" drives the per-row checkboxes of the bulk form.
        (function () {
            var master = document.getElementById("inbox-select-all");
            if (!master) { return; }
            master.addEventListener("change", function () {
                var boxes = document.querySelectorAll('input[name="selectedIds"]');
                for (var i = 0; i < boxes.length; i++) { boxes[i].checked = master.checked; }
            });
        })();
    </script>
}
