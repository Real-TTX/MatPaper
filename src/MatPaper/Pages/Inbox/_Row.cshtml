@using MatPaper.Data
@using MatPaper.Pages.Inbox
@model MatPaper.Pages.Inbox.IndexModel.RowContext
@{
    var m = Model.Page;
    var row = Model.Row;
    var suffix = row.Id.ToString();
    var processing = row.OcrState == OcrState.Pending;
    var failed = row.OcrState == OcrState.Failed;
    var deferred = row.OcrState == OcrState.Deferred;
    var found = !row.IsStaged;
    var ignored = m.ShowingIgnored;
    var selectedLocation = row.StorageLocationId ?? m.DefaultLocationId;

    var originLabel = row.Origin switch
    {
        DocumentOrigin.Mail => L["E-mail"].Value,
        DocumentOrigin.ImportFolder => L["Import folder"].Value,
        DocumentOrigin.CameraScan => L["Camera scan"].Value,
        DocumentOrigin.StorageScan => L["Found"].Value,
        _ => L["Upload"].Value
    };
}

@* An ignored row is read-only: the only thing to do with it is put it back into the
   inbox. It deliberately carries no Confirm form, no title field and no selection
   checkbox, so nothing can archive it or overwrite its metadata by accident. *@

<article class="inbox-item @(processing ? "is-processing" : string.Empty) @(found ? "inbox-item--found" : string.Empty)"
         data-doc-id="@row.Id" data-ocr="@row.OcrState.ToString().ToLowerInvariant()">
    @if (!ignored)
    {
        <form method="post" asp-page-handler="Confirm"
              asp-route-Search="@m.Search" asp-route-Origin="@m.Origin" asp-route-LocationId="@m.LocationId"
              asp-route-Folder="@m.Folder" asp-route-AllOwners="@m.AllOwners" asp-route-Sort="@m.Sort" asp-route-PageNumber="@m.PageNumber">
            <input type="hidden" name="id" value="@row.Id" />

            <div class="inbox-item__head">
                <label class="inbox-item__pick">
                    <input type="checkbox" name="selectedIds" value="@row.Id" form="inbox-bulk"
                           aria-label='@L["Select \"{0}\"", row.Title]' />
                </label>

                <partial name="_RowThumb" model="Model" />

                <input class="form-control inbox-item__title" type="text" name="title" value="@row.Title" aria-label='@L["Title"]' />

                <partial name="_RowBadges" model="Model" />
            </div>

            <partial name="_RowPath" model="Model" />

            @* Every field sits in a cell of one grid, labels on one line, controls of one height. *@
            <div class="inbox-grid">
                <div class="inbox-field inbox-field--corr">
                    <mp-picker asp-for="CorrespondentId" label='@L["Correspondent"]' asp-items="m.CorrespondentOptions"
                               value="@(row.CorrespondentId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                </div>
                <div class="inbox-field">
                    <mp-picker asp-for="DocumentTypeId" label='@L["Type"]' asp-items="m.DocumentTypeOptions"
                               value="@(row.DocumentTypeId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                </div>
                <div class="inbox-field">
                    <div class="form-row">
                        <label for="documentDate_@suffix">@L["Date"]</label>
                        <input class="form-control" type="date" id="documentDate_@suffix" name="documentDate"
                               value="@Fmt.InputDate(row.DocumentDate)" />
                    </div>
                </div>

                <button type="button" class="inbox-more-toggle" aria-expanded="false">
                    <span>@L["More fields"]</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </button>

                <div class="inbox-more">
                    <div class="inbox-field">
                        <mp-picker asp-for="ProjectId" label='@L["Project"]' asp-items="m.ProjectOptions"
                                   value="@(row.ProjectId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                    </div>
                    <div class="inbox-field inbox-field--wide">
                        <mp-picker asp-for="TagIds" label='@L["Tags"]' asp-items="m.TagItems" multiple="true"
                                   value="@string.Join(",", row.TagIds)" id-suffix="@suffix" placeholder='@L["Add tags…"]' />
                    </div>

                    @if (found)
                    {
                        <div class="inbox-field inbox-field--wide">
                            <div class="form-row">
                                <label>@L["Filing"]</label>
                                <div class="checkbox-group inbox-radios">
                                    <label class="form-check">
                                        <input type="radio" name="mode" value="keep" checked />
                                        <span>@L["Keep in place"]</span>
                                    </label>
                                    <label class="form-check">
                                        <input type="radio" name="mode" value="refile" />
                                        <span>@L["Re-file by template"]</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="inbox-field inbox-field--wide">
                            <div class="form-row">
                                <label for="storageLocationId_@suffix">@L["File to"]</label>
                                <select class="form-control" id="storageLocationId_@suffix" name="storageLocationId">
                                    @foreach (var loc in m.StorageLocations)
                                    {
                                        <option value="@loc.Id" selected="@(loc.Id == selectedLocation)">@loc.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (row.CorrespondentId is null)
            {
                <div class="inbox-suggest">
                    <span class="inbox-suggest__label">@L["Correspondent suggestions:"]</span>
                    @if (processing)
                    {
                        <span class="inbox-suggest__note">@L["The text is still being recognised …"]</span>
                    }
                    else if (deferred)
                    {
                        <span class="inbox-suggest__note">@L["Analyze the file first, then there are suggestions."]</span>
                    }
                    else
                    {
                        <div class="suggest-box">
                            <span class="inbox-suggest__note">@L["Looking for suggestions …"]</span>
                        </div>
                        <button type="button" class="btn btn--secondary suggest-btn" data-suggest-correspondent="@row.Id"
                                data-none='@L["No suggestion found."]' hidden>@L["Suggest"]</button>
                    }
                </div>
            }

            <div class="inbox-item__actions">
                <button class="btn btn--primary" type="submit" disabled="@(processing || (!found && !m.HasStorage))"
                        title='@(processing ? L["Still processing"].Value : L["Apply the values above and take the document into the archive"].Value)'>
                    @L["Take into archive"]
                </button>

                <a class="btn btn--secondary inbox-view-btn" href="/Documents/@row.Token/view" target="_blank" rel="noopener"
                   data-viewer-token="@row.Token" data-viewer-title="@row.Title">@L["View"]</a>
                <a class="btn btn--secondary" href="/Documents/Edit?id=@row.Id&returnUrl=%2FInbox">@L["Open"]</a>

                @if (deferred)
                {
                    <button class="btn btn--secondary" type="submit" form="inbox-analyze-@row.Id">@L["Analyze now"]</button>
                }

                <span class="icon-actions inbox-item__tools">
                    @if (found)
                    {
                        <button class="icon-btn" type="submit" form="inbox-ignore-@row.Id" title='@L["Ignore"]'>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <path d="M1 1l22 22" />
                            </svg>
                        </button>
                    }
                    else
                    {
                        <button class="icon-btn" type="submit" form="inbox-block-@row.Id" title='@L["Delete and block"]'
                                data-confirm='@L["Delete this document and put it on the blocklist? It is skipped when it turns up again."]'>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" /><path d="M5.6 5.6l12.8 12.8" />
                            </svg>
                        </button>
                        <button class="icon-btn icon-btn--danger" type="submit" form="inbox-delete-@row.Id" title='@L["Delete"]'
                                data-confirm='@L["Delete this document? The file in the staging area is deleted as well."]'>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6" /><path d="M14 11v6" />
                            </svg>
                        </button>
                    }
                </span>
            </div>
        </form>
    }
    else
    {
        <div class="inbox-item__head inbox-item__head--plain">
            <partial name="_RowThumb" model="Model" />
            <span class="inbox-item__title inbox-item__title--static">@row.Title</span>
            <partial name="_RowBadges" model="Model" />
        </div>

        <partial name="_RowPath" model="Model" />

        <div class="inbox-item__actions">
            <button class="btn btn--secondary" type="submit" form="inbox-restore-@row.Id">@L["Back to the inbox"]</button>
            <a class="btn btn--secondary inbox-view-btn" href="/Documents/@row.Token/view" target="_blank" rel="noopener"
               data-viewer-token="@row.Token" data-viewer-title="@row.Title">@L["View"]</a>
            <a class="btn btn--secondary" href="/Documents/Edit?id=@row.Id&returnUrl=%2FInbox%3FState%3Dignored">@L["Open"]</a>
            @if (deferred)
            {
                <button class="btn btn--secondary" type="submit" form="inbox-analyze-@row.Id">@L["Analyze now"]</button>
            }
        </div>
    }

    @foreach (var handler in new[] { "Delete", "Block", "Ignore", "Restore", "Analyze" })
    {
        <form method="post" id="inbox-@handler.ToLowerInvariant()-@row.Id" asp-page-handler="@handler"
              asp-route-Search="@m.Search" asp-route-Origin="@m.Origin" asp-route-LocationId="@m.LocationId"
              asp-route-Folder="@m.Folder" asp-route-State="@(ignored ? "ignored" : null)"
              asp-route-AllOwners="@m.AllOwners" asp-route-Sort="@m.Sort" asp-route-PageNumber="@m.PageNumber">
            <input type="hidden" name="id" value="@row.Id" />
        </form>
    }
</article>
