@using MatPaper.Data
@using MatPaper.Pages.Inbox
@model MatPaper.Pages.Inbox.IndexModel.RowContext
@{
    var m = Model.Page;
    var row = Model.Row;
    var suffix = row.Id.ToString();
    var processing = row.OcrState == OcrState.Pending;
    var deferred = row.OcrState == OcrState.Deferred;
    var found = !row.IsStaged;
    var ignored = m.ShowingIgnored;
    var selectedLocation = row.StorageLocationId ?? m.DefaultLocationId;
    var back = ignored ? "%2FInbox%3FState%3Dignored" : "%2FInbox";
    var itemClass = "mat-card mp-inbox-item" + (processing ? " is-processing" : string.Empty) + (found ? " mp-inbox-item--found" : string.Empty);
}

@* An ignored row is read-only: the only thing to do with it is put it back into the
   inbox. It deliberately carries no Confirm form, no title field and no selection
   checkbox, so nothing can archive it or overwrite its metadata by accident. *@

<article class="@itemClass" data-doc-id="@row.Id" data-ocr="@row.OcrState.ToString().ToLowerInvariant()">
    <div class="mat-card__body">
        @if (!ignored)
        {
            <form method="post" asp-page-handler="Confirm" class="mp-inbox-form"
                  asp-route-Search="@m.Search" asp-route-Origin="@m.Origin" asp-route-LocationId="@m.LocationId"
                  asp-route-Folder="@m.Folder" asp-route-AllOwners="@m.AllOwners" asp-route-Sort="@m.Sort" asp-route-PageNumber="@m.PageNumber">
                <input type="hidden" name="id" value="@row.Id" />

                <div class="mp-inbox-item__head">
                    <label class="mp-inbox-item__pick">
                        <input type="checkbox" name="selectedIds" value="@row.Id" form="inbox-bulk" data-select-row
                               aria-label='@L["Select \"{0}\"", row.Title]' />
                    </label>

                    <partial name="_RowThumb" model="Model" />

                    <input class="mat-input mp-inbox-item__title" type="text" name="title" value="@row.Title" aria-label='@L["Title"]' />

                    <partial name="_RowBadges" model="Model" />
                </div>

                <partial name="_RowPath" model="Model" />

                @* Every field sits in a cell of one grid, labels on one line, controls of one height. *@
                <div class="mp-inbox-grid">
                    <mp-picker asp-for="CorrespondentId" label='@L["Correspondent"]' asp-items="m.CorrespondentOptions"
                               value="@(row.CorrespondentId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]'
                               suggest-doc="@(!processing && !deferred ? row.Id : (long?)null)" class="mp-inbox-field--corr" />
                    <mp-picker asp-for="DocumentTypeId" label='@L["Type"]' asp-items="m.DocumentTypeOptions"
                               value="@(row.DocumentTypeId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                    <mp-date name="documentDate" id="@($"documentDate_{suffix}")" value="row.DocumentDate" label='@L["Date"]' />

                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm mp-inbox-more-toggle" data-inbox-more aria-expanded="false">
                        <span>@L["More fields"]</span>
                        <mp-icon name="chevron-down" />
                    </button>

                    <div class="mp-inbox-more">
                        <mp-picker asp-for="ProjectId" label='@L["Project"]' asp-items="m.ProjectOptions"
                                   value="@(row.ProjectId?.ToString())" id-suffix="@suffix" placeholder='@L["— None —"]' />
                        <mp-picker asp-for="TagIds" label='@L["Tags"]' asp-items="m.TagItems" multiple="true"
                                   value="@string.Join(",", row.TagIds)" id-suffix="@suffix" placeholder='@L["Add tags…"]' class="mp-inbox-field--wide" />

                        @if (found)
                        {
                            <fieldset class="mat-field mat-fieldset mp-inbox-field--wide">
                                <legend class="mat-label">@L["Filing"]</legend>
                                <div class="mat-checks mat-checks--inline mp-inbox-radios">
                                    <label class="mat-check"><input type="radio" name="mode" value="keep" checked /><span class="mat-check__text">@L["Keep in place"]</span></label>
                                    <label class="mat-check"><input type="radio" name="mode" value="refile" /><span class="mat-check__text">@L["Re-file by template"]</span></label>
                                </div>
                                <span class="mat-error" aria-live="polite"></span>
                            </fieldset>
                        }
                        else
                        {
                            <div class="mat-field mp-inbox-field--wide">
                                <label class="mat-label" for="storageLocationId_@suffix">@L["File to"]</label>
                                <select class="mat-select" id="storageLocationId_@suffix" name="storageLocationId">
                                    @foreach (var loc in m.StorageLocations)
                                    {
                                        <option value="@loc.Id" selected="@(loc.Id == selectedLocation)">@loc.Name</option>
                                    }
                                </select>
                                <span class="mat-error" aria-live="polite"></span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mp-inbox-item__actions">
                    <button class="mat-btn mat-btn--primary" type="submit" disabled="@(processing || (!found && !m.HasStorage))"
                            title='@(processing ? L["Still processing"].Value : L["Apply the values above and take the document into the archive"].Value)'>
                        @Ui.Icon("check")<span>@L["Take into archive"]</span>
                    </button>

                    <mp-button variant="secondary" icon="eye" class="mp-inbox-view-btn" href="@($"/Documents/{row.Token}/view")" target="_blank" rel="noopener"
                               data-viewer-token="@row.Token" data-viewer-title="@row.Title"
                               data-doc-preview="@row.Token" data-doc-preview-title="@row.Title" data-doc-preview-edit="@($"/Documents/Edit?id={row.Id}&returnUrl={back}")" data-doc-preview-share="true">@L["View"]</mp-button>
                    <mp-button variant="secondary" icon="edit" href="@($"/Documents/Edit?id={row.Id}&returnUrl=%2FInbox")">@L["Open"]</mp-button>

                    @if (deferred)
                    {
                        <button class="mat-btn mat-btn--secondary" type="submit" form="inbox-analyze-@row.Id">@Ui.Icon("sparkles")<span>@L["Analyze now"]</span></button>
                    }

                    <span class="mp-inbox-item__tools">
                        @if (found)
                        {
                            <mp-icon-button icon="eye-off" label='@L["Ignore"]' type="submit" form="inbox-ignore-@row.Id" />
                        }
                        else
                        {
                            <mp-icon-button icon="shield" label='@L["Delete and block"]' type="submit" form="inbox-block-@row.Id"
                                            confirm='@L["Delete this document and put it on the blocklist? It is skipped when it turns up again."]' confirm-ok='@L["Delete and block"]' />
                            <mp-icon-button icon="trash" label='@L["Delete"]' type="submit" form="inbox-delete-@row.Id" variant="danger"
                                            confirm='@L["Delete this document? The file in the staging area is deleted as well."]' confirm-ok='@L["Delete"]' />
                        }
                    </span>
                </div>
            </form>
        }
        else
        {
            <div class="mp-inbox-item__head mp-inbox-item__head--plain">
                <partial name="_RowThumb" model="Model" />
                <span class="mp-inbox-item__title mp-inbox-item__title--static">@row.Title</span>
                <partial name="_RowBadges" model="Model" />
            </div>

            <partial name="_RowPath" model="Model" />

            <div class="mp-inbox-item__actions">
                <button class="mat-btn mat-btn--secondary" type="submit" form="inbox-restore-@row.Id">@Ui.Icon("restore")<span>@L["Back to the inbox"]</span></button>
                <mp-button variant="secondary" icon="eye" class="mp-inbox-view-btn" href="@($"/Documents/{row.Token}/view")" target="_blank" rel="noopener"
                           data-viewer-token="@row.Token" data-viewer-title="@row.Title"
                           data-doc-preview="@row.Token" data-doc-preview-title="@row.Title" data-doc-preview-edit="@($"/Documents/Edit?id={row.Id}&returnUrl={back}")" data-doc-preview-share="true">@L["View"]</mp-button>
                <mp-button variant="secondary" icon="edit" href="@($"/Documents/Edit?id={row.Id}&returnUrl=%2FInbox%3FState%3Dignored")">@L["Open"]</mp-button>
                @if (deferred)
                {
                    <button class="mat-btn mat-btn--secondary" type="submit" form="inbox-analyze-@row.Id">@Ui.Icon("sparkles")<span>@L["Analyze now"]</span></button>
                }
            </div>
        }

        @foreach (var handler in new[] { "Delete", "Block", "Ignore", "Restore", "Analyze" })
        {
            <form method="post" id="inbox-@handler.ToLowerInvariant()-@row.Id" asp-page-handler="@handler"
                  asp-route-Search="@m.Search" asp-route-Origin="@m.Origin" asp-route-LocationId="@m.LocationId"
                  asp-route-Folder="@m.Folder" asp-route-State="@(ignored ? "ignored" : null)"
                  asp-route-AllOwners="@m.AllOwners" asp-route-Sort="@m.Sort" asp-route-PageNumber="@m.PageNumber">
                <input type="hidden" name="id" value="@row.Id" />
            </form>
        }
    </div>
</article>
