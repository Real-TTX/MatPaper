@using MatPaper.Data
@model MatPaper.Pages.Inbox.IndexModel.RowContext
@{
    var m = Model.Page;
    var row = Model.Row;
    var originLabel = row.Origin switch
    {
        DocumentOrigin.Mail => L["E-mail"].Value,
        DocumentOrigin.ImportFolder => L["Import folder"].Value,
        DocumentOrigin.CameraScan => L["Camera scan"].Value,
        DocumentOrigin.StorageScan => L["Found"].Value,
        _ => L["Upload"].Value
    };
}
<span class="mp-inbox-item__meta">
    <span class="mat-pill mat-pill--plain">@originLabel</span>
    @if (row.OcrState == OcrState.Pending)
    {
        <span class="mat-pill mat-pill--busy">@L["Processing…"]</span>
    }
    else if (row.OcrState == OcrState.Failed)
    {
        <span class="mat-pill mat-pill--error">@L["OCR failed"]</span>
    }
    else if (row.OcrState == OcrState.Deferred)
    {
        <span class="mat-pill mat-pill--plain">@L["Not analyzed yet"]</span>
    }
    @if (m.AsnEnabled && row.ArchiveSerialNumber is long asn)
    {
        <span class="mat-pill mat-pill--plain mat-mono" data-tip='@L["Archive number"]'>@m.AsnText(asn)</span>
    }
    @if (m.IsAdmin && m.AllOwners && row.OwnerName != null)
    {
        <span class="mat-pill mat-pill--plain">@row.OwnerName</span>
    }
    <span class="mat-muted" title="@row.OriginalFileName">@Fmt.Date(row.AddedDate)</span>
</span>
