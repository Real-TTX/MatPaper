@model MatPaper.Pages.Inbox.IndexModel.RowContext
@{
    var row = Model.Row;
}
@if (!row.IsStaged)
{
    <p class="mp-inbox-item__path">
        <span class="mat-pill mat-pill--plain">@(row.LocationName ?? L["Unknown"].Value)</span>
        <span class="mat-mono">@row.RelativePath</span>
        <small class="mat-muted">@Fmt.Size(row.FileSize)@(row.FileModifiedUtc.HasValue ? " · " + Fmt.Date(row.FileModifiedUtc) : string.Empty)</small>
    </p>
}
