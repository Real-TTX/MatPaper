@page "/"
@model IndexModel
@{
    ViewData["Breadcrumb"] = L["Dashboard"].Value;
}

<div class="quick-actions">
    <a class="btn btn--primary" href="/Documents/Upload">+ @L["Upload"]</a>
    <a class="btn btn--secondary" href="/Documents/Scan">@L["Scan"]</a>
    <a class="btn btn--secondary" href="/Inbox">@L["Inbox"]@(Model.PendingReviewCount > 0 ? $" ({Model.PendingReviewCount})" : "")</a>
    <a class="btn btn--secondary" href="/Documents">@L["All documents"]</a>
</div>

<section class="kpi-grid">
    <a class="kpi-card" href="/Inbox">
        <div class="kpi-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-6l-2 3h-4l-2-3H2" />
                <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
            </svg>
        </div>
        <div class="kpi-card__body">
            <span class="kpi-card__value">@Model.PendingReviewCount</span>
            <span class="kpi-card__label">@L["Needs review"]</span>
        </div>
    </a>

    <a class="kpi-card" href="/Documents">
        <div class="kpi-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
            </svg>
        </div>
        <div class="kpi-card__body">
            <span class="kpi-card__value">@Model.DocumentCount</span>
            <span class="kpi-card__label">@L["Documents"]</span>
        </div>
    </a>
</section>

<section class="dash-panel">
    <h2 class="dash-panel__title">@L["Recent documents"]</h2>
    @if (Model.Recent.Count == 0)
    {
        <p class="form-help">@L["No documents yet."] <a href="/Documents/Upload">@L["Upload your first document"]</a>.</p>
    }
    else
    {
        <div class="dash-recent">
            @foreach (var d in Model.Recent)
            {
                <a class="dash-recent__item" href="/Documents/Edit?id=@d.Id">
                    @if (d.ThumbnailPath != null)
                    {
                        <img class="dash-recent__thumb" src="/Documents/@d.Token/thumb" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="dash-recent__thumb"></span>
                    }
                    <span class="dash-recent__body">
                        <span class="dash-recent__title">@d.Title</span>
                        <span class="dash-recent__meta">
                            @(d.CorrespondentName ?? "—") · @(d.TypeName ?? "—") · @Fmt.Date(d.Date)
                        </span>
                    </span>
                </a>
            }
        </div>
    }
</section>

<footer class="app-footer">
    MatPaper &middot; @L["Version"] @MatPaper.AppInfo.Version
</footer>
