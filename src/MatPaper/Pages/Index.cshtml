@page "/"
@model IndexModel
@{
    ViewData["Breadcrumb"] = L["Dashboard"].Value;
    ViewData["Heading"] = L["Dashboard"].Value;
}

<div class="mat-stack">
    <div class="mat-grid mat-grid--2">
        <a class="mat-card mp-linkcard" href="/Inbox">
            <div class="mat-card__body mp-linkcard__body">
                <span class="mp-linkcard__icon"><mp-icon name="inbox" /></span>
                <span class="mat-stat">
                    <span class="mat-stat__value">@Model.PendingReviewCount</span>
                    <span class="mat-stat__label">@L["Needs review"]</span>
                </span>
            </div>
        </a>

        <a class="mat-card mp-linkcard" href="/Documents">
            <div class="mat-card__body mp-linkcard__body">
                <span class="mp-linkcard__icon"><mp-icon name="file-text" /></span>
                <span class="mat-stat">
                    <span class="mat-stat__value">@Model.DocumentCount</span>
                    <span class="mat-stat__label">@L["Documents"]</span>
                </span>
            </div>
        </a>
    </div>

    <div class="mat-card">
        <div class="mat-card__head">
            <mp-icon name="clock" />
            <h2 class="mat-card__title">@L["Recent documents"]</h2>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon"><mp-icon name="file-text" /></span>
                <div class="mat-empty__title">@L["No documents yet."]</div>
                <mp-button variant="primary" href="/Documents/Upload" icon="plus">@L["Upload your first document"]</mp-button>
            </div>
        }
        else
        {
            <ul class="mat-listgroup mp-recent">
                @foreach (var d in Model.Recent)
                {
                    <li>
                        <a class="mat-listgroup__item" href="/Documents/Edit?id=@d.Id">
                            <span class="mp-thumb" aria-hidden="true">
                                @if (d.ThumbnailPath != null)
                                {
                                    <img src="/Documents/@d.Token/thumb" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <mp-icon name="file-text" />
                                }
                            </span>
                            <span class="mat-listgroup__text">
                                <strong>@d.Title</strong>
                                <small>@(d.CorrespondentName ?? "—") · @(d.TypeName ?? "—") · @Fmt.Date(d.Date)</small>
                            </span>
                            <mp-icon name="chevron-right" />
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
