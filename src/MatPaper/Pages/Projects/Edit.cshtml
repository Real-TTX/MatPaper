@page "/Projects/Edit"
@model MatPaper.Pages.Projects.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["Projects / Edit"].Value : L["Projects / New"].Value;
    ViewData["Title"] = Model.IsEdit ? Model.Input.Name : null;
    ViewData["Heading"] = Model.IsEdit ? Model.Input.Name : L["New project"].Value;
    ViewData["Width"] = "narrow";
}

<div class="mat-stack">
    @if (Model.IsEdit)
    {
        <div class="mat-card">
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>@L["Owner"]</dt>
                    <dd>@(Model.OwnerName ?? "—") @if (Model.IsCommon) { <span class="mat-pill mat-pill--ok">@L["Common area"]</span> }</dd>
                    @if (!Model.CanManage)
                    {
                        <dt>@L["Sharing"]</dt>
                        <dd>@L["Shared with you."]</dd>
                    }
                </dl>
            </div>
        </div>
    }

    <form method="post" class="mat-form" novalidate>
        <input type="hidden" asp-for="Id" />
        <partial name="_ValidationSummary" />

        <div class="mat-card">
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Website relaunch"]' />
                    <mp-field asp-for="Input.Color" kind="color" label='@L["Colour"]' />
                </div>
            </div>
        </div>

        <mp-button-row>
            @if (Model.CanManage)
            {
                <mp-button variant="primary" icon="save">@L["Save"]</mp-button>
            }
            <mp-button variant="secondary" href="/Projects" icon="back">@L["Back"]</mp-button>
            @if (Model.IsEdit && Model.CanManage)
            {
                <mp-button-spacer />
                <mp-button variant="danger" icon="trash" handler="Delete" confirm='@L["Delete this project? This cannot be undone."]' confirm-ok='@L["Delete"]'>@L["Delete"]</mp-button>
            }
        </mp-button-row>
    </form>

    @if (Model.IsEdit && Model.CanManage)
    {
        <div class="mat-card">
            <div class="mat-card__head">
                <mp-icon name="users" />
                <h2 class="mat-card__title">@L["Sharing"]</h2>
            </div>
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">@L["Sharing a project gives the selected users access to every document in it."]</p>

                <form method="post" asp-page-handler="SetCommon">
                    <input type="hidden" asp-for="Id" />
                    <label class="mat-switch">
                        <input type="checkbox" name="isCommon" value="true" checked="@Model.IsCommon" data-autosubmit />
                        <span class="mat-switch__track"></span>
                        <span>@L["Show in the common area (visible to everyone)"]</span>
                    </label>
                </form>

                <h3>@L["Shared with users"]</h3>
                @if (Model.UserShares.Count > 0)
                {
                    <ul class="mat-listgroup">
                        @foreach (var s in Model.UserShares)
                        {
                            <li class="mat-listgroup__item">
                                <span class="mat-listgroup__text"><strong>@s.UserName</strong><small>@(s.CanEdit ? L["can edit documents"] : L["view only"])</small></span>
                                <form method="post" asp-page-handler="RevokeUserShare">
                                    <input type="hidden" asp-for="Id" />
                                    <input type="hidden" name="shareId" value="@s.ShareId" />
                                    <mp-button variant="ghost" size="sm" icon="x" confirm='@($"{L["Remove"]}: {s.UserName}?")' confirm-ok='@L["Remove"]'>@L["Remove"]</mp-button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="mat-muted">@L["Not shared with any user yet."]</p>
                }

                @if (Model.ShareUserOptions.Count > 0)
                {
                    <form method="post" asp-page-handler="ShareUser" class="mat-form mat-form--inline">
                        <input type="hidden" asp-for="Id" />
                        <mp-picker asp-for="ShareUserId" label='@L["Add user"]' asp-items="Model.ShareUserOptions" placeholder='@L["Choose a user…"]' />
                        <div class="mat-field mat-field--auto">
                            <label class="mat-check"><input type="checkbox" name="canEdit" value="true" /><span class="mat-check__text">@L["may edit documents"]</span></label>
                        </div>
                        <div class="mat-field mat-field--auto">
                            <mp-button variant="primary" icon="plus">@L["Share"]</mp-button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</div>
