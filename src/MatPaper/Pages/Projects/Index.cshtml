@page "/Projects"
@model MatPaper.Pages.Projects.IndexModel
@{
    ViewData["Breadcrumb"] = L["Projects"].Value;
}

<div class="mat-list">
    <mp-toolbar id="projects" label='@L["Projects"]' count="Model.TotalCount" singular="{0} project" plural="{0} projects">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
        <mp-toolbar-sort value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="Model.Filters" />

    <mp-table item-count="Model.Rows.Count" empty-text='@L["No projects match your criteria."]' caption='@L["Projects"]'>
        <thead>
            <tr>
                <th scope="col">@L["Name"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in Model.Rows)
            {
                <tr data-row-href="/Projects/Edit?id=@project.Id">
                    <td>
                        <div class="mat-table__name">
                            <mp-icon name="folder" data-colour="@(string.IsNullOrWhiteSpace(project.Color) ? "#808080" : project.Color)" />
                            <a href="/Documents?ProjectIds=@project.Id" data-tip='@L["Show documents"]'>@project.Name</a>
                            @if (project.IsCommon)
                            {
                                <span class="mat-pill mat-pill--ok">@L["Common"]</span>
                            }
                            else if (project.OwnerId != Model.CurrentUserId)
                            {
                                <span class="mat-pill mat-pill--plain">@L["Shared"]@(project.Owner != null ? $": {project.Owner.DisplayName ?? project.Owner.Username}" : "")</span>
                            }
                        </div>
                    </td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <mp-icon-button icon="file-text" label='@L["Documents"]' href='@($"/Documents?ProjectIds={project.Id}")' />
                            <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/Projects/Edit?id={project.Id}")' />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mp-table>

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />

    <div class="mat-actions">
        <mp-button variant="primary" href="/Projects/Edit" icon="plus">@L["New project"]</mp-button>
    </div>
</div>
