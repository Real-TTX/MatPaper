@page "/Projects"
@model MatPaper.Pages.Projects.IndexModel
@{
    ViewData["Breadcrumb"] = "Projects";
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder="Name" />
    <mp-toolbar-select name="Sort" label="Sort" value="@Model.Sort">
        <option value="name_asc">Name (A–Z)</option>
        <option value="name_desc">Name (Z–A)</option>
    </mp-toolbar-select>
</mp-toolbar>

<partial name="_FilterChips" model="Model.Filters" />

<mp-table item-count="Model.Rows.Count" empty-text="No projects match your criteria.">
    <thead>
        <tr>
            <th>Name</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model.Rows)
        {
            var swatch = string.IsNullOrWhiteSpace(project.Color) ? "#808080" : project.Color;
            <tr>
                <td>
                    <a href="/Documents?ProjectIds=@project.Id" title="Show documents" class="tag-label">
                        <span class="tag-label__dot" style="background:@swatch"></span>@project.Name
                    </a>
                    @if (project.IsCommon)
                    {
                        <span class="badge badge--ok" style="margin-left:.5em">Common</span>
                    }
                    else if (project.OwnerId != Model.CurrentUserId)
                    {
                        <span class="badge badge--muted" style="margin-left:.5em">Shared@(project.Owner != null ? $": {project.Owner.DisplayName ?? project.Owner.Username}" : "")</span>
                    }
                </td>
                <td class="is-actions">
                    <span class="icon-actions">
                        <a class="icon-btn" href="/Documents?ProjectIds=@project.Id" title="Documents" aria-label="Documents">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" /></svg>
                        </a>
                        <a class="icon-btn" href="/Projects/Edit?id=@project.Id" title="Edit" aria-label="Edit">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" /></svg>
                        </a>
                    </span>
                </td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/Projects/Edit">New project</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
