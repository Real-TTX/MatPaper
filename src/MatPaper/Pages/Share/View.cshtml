@page "/Share/{token:guid}"
@model MatPaper.Pages.Share.ViewModel
@{
    var title = Model.Document!.Title;
    ViewData["Title"] = title;
    ViewData["Breadcrumb"] = title;
    // A document title is not a translatable path - keep it verbatim in the header.
    ViewData["BreadcrumbLiteral"] = true;
    ViewData["ShellClass"] = "mp-auth--wide";
}

<div class="mat-stack">
    <div class="mat-row mat-row--between">
        <span class="mat-muted">@L["Shared with you"]</span>
        <mp-button variant="primary" href="@($"/Share/{Model.Token}/file?download=true")" icon="download">@L["Download"]</mp-button>
    </div>

    <div class="mp-share__frame">
        @if (Model.IsImage)
        {
            <img src="/Share/@Model.Token/file" alt="@title" />
        }
        else
        {
            <iframe src="/Share/@Model.Token/file" title="@title"></iframe>
        }
    </div>
</div>
