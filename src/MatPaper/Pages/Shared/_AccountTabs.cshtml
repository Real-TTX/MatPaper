@model string
@* The tabs of the account area: own details, look. Language and sign-out stay in the menu. *@
<mp-tabbar label='@L["Account"]'>
    <mp-tab title='@L["Profile"]' href="/Account" active="@(Model == "profile")" />
    <mp-tab title='@L["Appearance"]' href="/Account/Appearance" active="@(Model == "appearance")" />
</mp-tabbar>
