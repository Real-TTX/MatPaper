@* Folder/share picker, driven by browse-dialog.js (a dialog of the toolkit). Render once per page next to a form that has data-browse-url,
   and load ~/js/browse-dialog.js in the page's Scripts section. *@
<dialog class="mat-dialog" id="browse-dialog" aria-labelledby="browse-dialog-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">
            <mp-icon name="folder-open" />
            <h2 class="mat-dialog__title" id="browse-dialog-title"></h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label='@L["Close"]'><mp-icon name="x" /></button>
        </div>
        <div class="mat-dialog__body mat-stack">
            <div class="mp-browse__path mat-mono"></div>
            <ul class="mat-listgroup mp-browse__list"></ul>
        </div>
        <div class="mat-dialog__foot mp-browse__footer">
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="button" class="mat-btn mat-btn--primary mp-browse__use"><mp-icon name="check" /><span>@L["Use this folder"]</span></button>
                <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>@L["Cancel"]</button>
            </div>
        </div>
    </div>
</dialog>
