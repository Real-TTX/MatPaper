@* The texts of the label scanner (code-scan.js) and the script itself; the layout includes this while the archive numbers are on. *@
<div id="code-scan-config" hidden data-url="/Documents/ScanCode"
     data-t-title='@L["Scan a label"]' data-t-close='@L["Close"]' data-t-light='@L["Light"]' data-t-zoom='@L["Zoom"]'
     data-t-hint='@L["Hold the label in the frame"]' data-t-photo='@L["Take a photo"]'
     data-t-no-camera='@L["The camera is not available here (it needs HTTPS). Take a photo of the label instead."]'
     data-t-other='@L["Read \"{0}\" - that is no archive number."]'
     data-t-error='@L["The code could not be read. Please try again."]' data-t-reading='@L["Reading …"]'
     data-t-photo-none='@L["No code found in the photo. Try again, closer to the label."]'
     data-t-open='@L["Open"]' data-t-again='@L["Scan again"]' data-t-again-hint='@L["Hold another label in the frame"]'
     data-t-take-over='@L["Take over"]' data-t-take-over-anyway='@L["Take over anyway"]'
     data-t-free-number='@L["Free: no document has this number yet."]' data-t-belongs-to='@L["Belongs to \"{0}\" already"]'
     data-t-no-document='@L["No document has this number."]'></div>
<script src="~/js/code-scan.js" asp-append-version="true"></script>
