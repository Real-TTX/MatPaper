@* The preview of a document in a dialog, for every page that has an element with data-doc-preview (doc-preview.js). *@
<dialog id="doc-preview" class="mat-dialog mat-dialog--xl mp-docpreview" aria-labelledby="doc-preview-title" data-t-preview='@L["Preview"]'>
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">
            <h2 class="mat-dialog__title" id="doc-preview-title"></h2>
            <div class="mp-docpreview__actions">
                <a class="mat-btn mat-btn--ghost mat-btn--icon" id="doc-preview-edit" data-tip='@L["Edit"]' aria-label='@L["Edit"]'>@Ui.Icon("edit")</a>
                @* The link is made on the server and only the owner may; the script shows the button for those documents. *@
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="doc-preview-share" data-doc-share data-doc-token="" data-doc-title="" data-tip='@L["Share document"]' aria-label='@L["Share document"]' hidden>@Ui.Icon("share-2")</button>
                <a class="mat-btn mat-btn--ghost mat-btn--icon" id="doc-preview-download" data-tip='@L["Download"]' aria-label='@L["Download"]'>@Ui.Icon("download")</a>
                <a class="mat-btn mat-btn--ghost mat-btn--icon" id="doc-preview-open" target="_blank" rel="noopener" data-tip='@L["Open in tab"]' aria-label='@L["Open in tab"]'>@Ui.Icon("external")</a>
            </div>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label='@L["Close"]' autofocus>@Ui.Icon("x")</button>
        </div>
        <div class="mat-dialog__body mp-docpreview__body">
            <iframe class="mp-docpreview__frame" id="doc-preview-frame" title='@L["Document preview"]' src="about:blank"></iframe>
        </div>
    </div>
</dialog>
