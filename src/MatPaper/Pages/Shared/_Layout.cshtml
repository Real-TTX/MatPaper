@using Microsoft.AspNetCore.Html
@using MatPaper.Controls
@using MatPaper.Services
@inject MatPaper.Services.CurrentUser CurrentUser
@inject MatPaper.Services.ThemeService Themes
@inject MatPaper.Services.MenuService MenuSvc
@inject MatPaper.Services.PageRoutes Routes
@inject MatPaper.Controls.Toolkit Toolkit
@inject MatPaper.Configuration.AppConfig AppSettings
@{
    // A page fills these in:
    //   Breadcrumb   "Section / Page" (translated segment by segment; BreadcrumbLiteral = true when a segment is data, e.g. a document title)
    //   Title        the entity of a detail page (it leads the browser title: "Invoice 2026-04 · Documents · MatPaper")
    //   Heading      the h1, when it is not the entity or the last crumb;  PageSub  one line under it
    //   Width        "narrow" (forms, 780 px) or "wide";  OwnHead  the page draws its own head;  ActiveHref  the menu item it belongs to when its address is not in the menu
    var theme = await Themes.ResolveAsync();
    var menus = await MenuSvc.BuildAsync();
    var path = Context.Request.Path.Value ?? "/";
    var active = ViewData["ActiveHref"] as string ?? NavigationMatch.ActiveHref(menus.SelectMany(m => m.Pages).Select(i => i.Href!), path);
    var current = menus.FirstOrDefault(m => m.Contains(active)) ?? menus[0];
    var hasSwitcher = menus.Count > 1;

    var breadcrumbRaw = ViewData["Breadcrumb"] as string ?? "";
    var breadcrumbLiteral = ViewData["BreadcrumbLiteral"] is true;
    var crumbs = breadcrumbRaw
        .Split('/', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => breadcrumbLiteral ? s.Trim() : L[s.Trim()].Value)
        .ToList();
    // The crumbs mirror the URL, so each one but the last can lead back; only when both have the same number of segments, otherwise the mapping would be a guess.
    var pathParts = path.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
    var crumbsLinkable = pathParts.Count == crumbs.Count && crumbs.Count > 1;

    var entity = ViewData["Title"] as string;
    var heading = ViewData["Heading"] as string ?? entity ?? (crumbs.Count > 0 ? crumbs[^1] : "MatPaper");
    var sub = ViewData["PageSub"] as string;
    var ownHead = ViewData["OwnHead"] is true;
    var width = ViewData["Width"] as string;

    // "Vodafone invoice · Documents · MatPaper" reads better in a tab strip and in the browser history than three tabs all called "Documents / Edit".
    var titleParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(entity)) { titleParts.Add(entity.Trim()); }
    if (crumbs.Count > 0) { titleParts.Add(string.Join(" / ", crumbs)); }
    titleParts.Add(Ui.App.Name);
    ViewData["FullTitle"] = string.Join(" · ", titleParts);

    var displayName = CurrentUser.DisplayName ?? CurrentUser.Username ?? L["Account"].Value;
    var role = CurrentUser.Role ?? string.Empty;
    var archiveNumbers = User.Identity?.IsAuthenticated == true && AppSettings.ArchiveNumbersEnabled;

    IHtmlContent Badge(NavBadge badge, bool sum = false)
    {
        var text = badge.IsDot ? string.Empty : badge.Text;
        var label = string.IsNullOrEmpty(badge.Label) ? string.Empty : (badge.IsDot ? badge.Label : " " + badge.Label);
        return new HtmlString($"<span class=\"{badge.Classes(sum)}\">{Ui.Encode(text)}" + (label.Length == 0 ? string.Empty : $"<span class=\"mat-sr-only\">{Ui.Encode(label)}</span>") + "</span>");
    }
}
<!DOCTYPE html>
<html lang="@(global::System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)" @Html.Raw(theme.RootAttributes) @Ui.RootTexts(L)@(Context.Request.Method == "POST" ? Html.Raw(" data-posted") : null)>
<partial name="_Head" model="theme" />
<body>
    <a class="mat-skip" href="#main">@L["Skip to the content"]</a>
    @Html.Raw(Toolkit.Sprite)

    <div class="mat-app">
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a href="/" aria-label='@L["MatPaper, start page"]'>
                    @Ui.Logo()
                    <span>
                        <span class="mat-nav__name">@Ui.App.Name</span>
                        <span class="mat-nav__tagline">@L["Your documents, in order"]</span>
                    </span>
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label='@L["Close the menu"]'>@Ui.Icon("x")</button>
            </div>

            @if (hasSwitcher)
            {
                <div class="mat-nav__switch">
                    <button type="button" class="mat-switcher" data-menu-toggle="nav-switch-menu" data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-switcher__icon">@Ui.Icon(current.Icon)</span>
                        <span class="mat-switcher__text"><small>@L["Menu"]</small><span class="mat-switcher__name">@current.Title</span></span>
                        @Ui.Icon("chevron-down", "mat-switcher__chev")
                        <span class="mat-switcher__dot" hidden="@(!menus.Any(m => m != current && m.NeedsAttention))"></span>
                    </button>
                </div>
            }

            @foreach (var menu in menus)
            {
                <nav class="mat-nav__scroll" aria-label="@(hasSwitcher ? menu.Title : L["Main navigation"].Value)" data-nav-panel="@menu.Id" hidden="@(menu != current)">
                    <ul class="mat-nav__list">
                        @foreach (var group in menu.Groups)
                        {
                            if (group.Title is not null)
                            {
                                <li class="mat-nav__group" role="presentation">@group.Title</li>
                            }

                            foreach (var item in group.Items)
                            {
                                if (item.IsParent)
                                {
                                    var hasActive = item.Contains(active);
                                    var subId = $"nav-sub-{menu.Id}-{item.Key}";
                                    var sum = item.SumOfChildren;
                                    <li class="mat-nav__branch @(hasActive ? "is-open is-current" : "")">
                                        <button type="button" class="mat-nav__item mat-nav__parent" aria-expanded="@(hasActive ? "true" : "false")" aria-controls="@subId" data-nav-branch="@item.Key">
                                            @if (item.Icon is not null) { @Ui.Icon(item.Icon) }<span>@item.Title</span>
                                            @if (item.Badge is not null) { @Badge(item.Badge) }
                                            else if (sum is not null) { @Badge(sum, sum: true) }
                                            @Ui.Icon("chevron-down", "mat-nav__chev")
                                        </button>
                                        <div class="mat-nav__sub" id="@subId">
                                            <ul class="mat-nav__list">
                                                @foreach (var child in item.Children!)
                                                {
                                                    var childActive = child.Href == active;
                                                    <li>
                                                        <a class="mat-nav__item mat-nav__item--sub @(childActive ? "is-active" : "")" href="@child.Href" aria-current="@(childActive ? "page" : null)">
                                                            <span>@child.Title</span>
                                                            @if (child.Badge is not null) { @Badge(child.Badge) }
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </li>
                                }
                                else
                                {
                                    var isActive = item.Href == active;
                                    <li>
                                        <a class="mat-nav__item @(isActive ? "is-active" : "")" href="@item.Href" aria-current="@(isActive ? "page" : null)">
                                            @if (item.Icon is not null) { @Ui.Icon(item.Icon) }<span>@item.Title</span>
                                            @if (item.Badge is not null) { @Badge(item.Badge) }
                                        </a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                </nav>
            }

            <div class="mat-nav__foot">
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-menu-toggle="user-menu" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@Ui.Initials(displayName)</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@displayName</span>
                            <span class="mat-user__role">@role</span>
                        </span>
                        @Ui.Icon("chevron-up", "mat-user__chev")
                    </button>
                    @{
                        var themeLabel = L["Theme: {0}. Click for {1}.", L[theme.Mode switch { "light" => "Light", "dark" => "Dark", _ => "System" }].Value, L[theme.Mode switch { "light" => "Dark", "dark" => "System", _ => "Light" }].Value].Value;
                    }
                    <button type="button" class="mat-theme" data-theme-toggle data-theme-save-url="/Account/Appearance?handler=Mode" data-theme-state="@theme.Mode" aria-label="@themeLabel" title="@themeLabel">
                        <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                        <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                        <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                    </button>
                </div>
                <div class="mat-nav__version">@Ui.App.Name @AppInfo.Version</div>
            </div>
        </aside>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label='@L["Open the menu"]' aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label='@L["Breadcrumb"]'>
                    <ol>
                        @if (crumbs.Count == 0)
                        {
                            <li aria-current="page">@Ui.App.Name</li>
                        }
                        else
                        {
                            <li><a href="/">@Ui.App.Name</a></li>
                            @for (var i = 0; i < crumbs.Count; i++)
                            {
                                if (crumbsLinkable && i < crumbs.Count - 1 && Routes.Exists("/" + string.Join("/", pathParts.Take(i + 1))))
                                {
                                    <li><a href="/@string.Join("/", pathParts.Take(i + 1))">@crumbs[i]</a></li>
                                }
                                else if (i < crumbs.Count - 1)
                                {
                                    <li>@crumbs[i]</li>
                                }
                                else
                                {
                                    <li aria-current="page">@crumbs[i]</li>
                                }
                            }
                        }
                    </ol>
                </nav>
                <div class="mat-topbar__actions">
                    @* Archive numbers switched on: scan the label of a paper with the camera and see its document. *@
                    @if (archiveNumbers)
                    {
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-code-scan="open" aria-label='@L["Scan a label"]' data-tip='@L["Scan a label"]'>@Ui.Icon("scan-barcode")</button>
                    }
                    @* Scan from anywhere: the camera of the phone is in reach there, the menu is not. *@
                    <a class="mat-btn mat-btn--ghost mat-btn--icon" href="/Documents/Upload?camera=true" aria-label='@L["Scan a document"]' data-tip='@L["Scan a document"]'>@Ui.Icon("camera")</a>
                </div>
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "")" id="main">
                <partial name="_Notice" />
                @if (!ownHead)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@heading</h1>
                            @if (!string.IsNullOrEmpty(sub))
                            {
                                <p class="mat-page__sub">@sub</p>
                            }
                        </div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <div class="mat-menu" id="user-menu" role="menu" aria-label="@displayName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@Ui.Initials(displayName)</span>
            <div><strong>@displayName</strong><small>@CurrentUser.Username@(string.IsNullOrEmpty(role) ? "" : " · " + role)</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" href="/Account">@Ui.Icon("user")<span>@L["Show account"]</span></a>
        <a class="mat-menu__item" role="menuitem" href="/Account/Appearance">@Ui.Icon("palette")<span>@L["Appearance"]</span></a>
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="mat-menu__item" role="menuitem">@Ui.Icon("logout")<span>@L["Sign out"]</span></button>
        </form>
    </div>

    @if (hasSwitcher)
    {
        <div class="mat-menu" id="nav-switch-menu" role="menu" aria-label='@L["Menus"]' data-nav-scope="mat-nav" hidden>
            @foreach (var menu in menus)
            {
                <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="@(menu == current ? "true" : "false")" data-nav-set="@menu.Id" data-nav-title="@menu.Title" @(menu.NeedsAttention ? Html.Raw("data-nav-attention") : null)>
                    @Ui.Icon(menu.Icon)<span>@menu.Title</span>
                    @if (menu.NeedsAttention) { <span class="mat-nav__badge mat-nav__badge--dot mat-nav__badge--warn"><span class="mat-sr-only">@L["needs attention"]</span></span> }
                    @Ui.Icon("check", "mat-menu__check")
                </button>
            }
        </div>
    }

    <div id="viewer-i18n" hidden data-close='@L["Close"]' data-download='@L["Download"]' data-page='@L["Page"]'
         data-viewer='@L["Document viewer"]' data-zoom-in='@L["Zoom in"]' data-zoom-out='@L["Zoom out"]'
         data-date-placeholder='@L["Choose a date"]' data-date-today='@L["Today"]' data-date-clear='@L["Clear"]'
         data-date-prev='@L["Previous month"]' data-date-next='@L["Next month"]' data-date-month='@L["Month"]' data-date-year='@L["Year"]'
         data-dl-preparing='@L["Preparing the file …"]' data-dl-save='@L["Save or share"]'
         data-dl-unsupported='@L["This device cannot save files from the app. Open MatPaper in the browser to download."]'
         data-dl-failed='@L["The file could not be saved."]'
         data-share='@L["Share document"]' data-link='@L["Link"]' data-link-copied='@L["Link copied - valid for {0} days"]'
         data-share-failed='@L["The document could not be shared."]' data-share-forbidden='@L["Only the owner can share this document."]'
         data-no-preview='@L["There is no preview for this file type."]' data-failed='@L["The document could not be shown."]'></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Files dropped anywhere on a page go to the inbox (global-drop.js). *@
        <div id="drop-i18n" hidden data-url="/Documents/Upload?handler=Ajax" data-inbox="/Inbox"
             data-t-title='@L["Drop files to add them"]' data-t-hint='@L["PDF, images, XML or ZIP – they land in your inbox"]'
             data-t-adding='@L["Adding documents …"]' data-t-done='@L["Done"]' data-t-close='@L["Close"]'
             data-t-queued='@L["Queued"]' data-t-uploading='@L["Uploading…"]' data-t-added='@L["Added"]'
             data-t-duplicate='@L["Duplicate — skipped"]' data-t-failed='@L["Failed"]' data-t-network-error='@L["Network error"]'
             data-t-show-existing='@L["Show existing document"]' data-t-summary-added='@L["{0} added"]'
             data-t-summary-duplicates='@L["{0} duplicate(s) skipped"]' data-t-summary-failed='@L["{0} failed"]'
             data-t-archive-skipped='@L["{0} file(s) are no documents"]' data-t-to-inbox='@L["Review them in your inbox →"]'
             data-t-reload='@L["Reload"]' data-t-too-many='@L["Only the first {0} files are added."]'
             data-t-processing='@L["Processing …"]'></div>
        <partial name="_DocPreviewDialog" />
    }
    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/matpaper.js" asp-append-version="true"></script>
    <script src="~/js/doc-viewer.js" asp-append-version="true"></script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>
    <script src="~/js/global-drop.js" asp-append-version="true"></script>
    <script src="~/js/doc-preview.js" asp-append-version="true"></script>
    @if (archiveNumbers)
    {
        <partial name="_CodeScanConfig" />
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
