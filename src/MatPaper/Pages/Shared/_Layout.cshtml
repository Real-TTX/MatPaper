@using MatPaper.Services
@inject MatPaper.Services.CurrentUser CurrentUser
@inject MatPaper.Data.AppDbContext Db
@inject MatPaper.Services.ThemeService Themes
@using MatPaper.Data
@using Microsoft.EntityFrameworkCore
@{
    // Breadcrumbs are set as "Section / Page" strings — some from views, some from page
    // models. Translating segment by segment localizes both without touching every model;
    // an unknown segment (e.g. a document title) simply passes through.
    var breadcrumbRaw = ViewData["Breadcrumb"] as string ?? "";
    var breadcrumbLiteral = ViewData["BreadcrumbLiteral"] is true;
    var breadcrumbParts = breadcrumbRaw
        .Split('/', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => breadcrumbLiteral ? s.Trim() : L[s.Trim()].Value)
        .ToList();
    var breadcrumb = string.Join(" / ", breadcrumbParts);

    // The crumbs mirror the URL, so each one but the last can lead back. Only when both
    // have the same number of segments, otherwise the mapping would be a guess.
    var pathParts = (Context.Request.Path.Value ?? "")
        .Split('/', StringSplitOptions.RemoveEmptyEntries)
        .ToList();
    var breadcrumbLinkable = pathParts.Count == breadcrumbParts.Count && breadcrumbParts.Count > 1;
    var accountName = CurrentUser.DisplayName ?? CurrentUser.Username ?? "Account";
    var avatarLetter = string.IsNullOrEmpty(accountName) ? "?" : accountName.Substring(0, 1).ToUpperInvariant();

    // Resolved before any markup, so the first byte already carries the right colours.
    var theme = await Themes.ResolveAsync();

    var pendingCount = 0;
    if (CurrentUser.UserId is long uid)
    {
        pendingCount = await Db.Documents.InInboxOf(uid, CurrentUser.IsAdmin).CountAsync();
    }
}
@functions {
    // "Vodafone invoice · Documents · MatPaper" reads better in a tab strip and in the
    // browser history than three tabs all called "Documents / Edit".
    static string PageTitle(string? entity, string breadcrumb)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(entity))
        {
            parts.Add(entity.Trim());
        }
        if (!string.IsNullOrEmpty(breadcrumb))
        {
            parts.Add(breadcrumb);
        }
        parts.Add("MatPaper");
        return string.Join(" · ", parts);
    }
}

<!DOCTYPE html>
<html lang="@(global::System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)" data-theme-mode="@theme.Mode" data-mode="@(theme.Mode == "dark" ? "dark" : "light")" data-scheme="@theme.Scheme" data-accent="@theme.Accent" data-theme-source="@(theme.UserHasMode ? "user" : "default")" data-theme-save="/Account/Appearance?handler=Mode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="MatPaper" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <title>@PageTitle(ViewData["Title"] as string, breadcrumb)</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/picker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/icons/logo.svg" />
    <partial name="_ThemeHead" model="theme" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <noscript><style>form.toolbar{visibility:visible!important}</style></noscript>
</head>
<body>
    <div class="app-shell">
        <div class="app-shell__backdrop" id="sidebar-backdrop" hidden></div>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar__brand">
                <svg class="sidebar__brand-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill="var(--color-primary)" />
                    <path d="M6.5 16.8V8.2l5.5 5.4 5.5-5.4v8.6" fill="none"
                          stroke="var(--color-primary-contrast)" stroke-width="1.9"
                          stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="12" cy="18.4" r="1.05" fill="var(--color-primary-contrast)" />
                </svg>
                <span class="sidebar__brand-text">MatPaper</span>
            </div>

            <nav class="sidebar__nav" aria-label='@L["Main navigation"]'>
                <a class="nav-upload" href="/Documents/Upload">
                    <svg class="nav-upload__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    <span>@L["Document"]</span>
                </a>
                <a class="nav-item" href="/">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="9" rx="1" />
                        <rect x="14" y="3" width="7" height="5" rx="1" />
                        <rect x="14" y="12" width="7" height="9" rx="1" />
                        <rect x="3" y="16" width="7" height="5" rx="1" />
                    </svg>
                    <span>@L["Dashboard"]</span>
                </a>
                <a class="nav-item" href="/Inbox">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 12h-6l-2 3h-4l-2-3H2" />
                        <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
                    </svg>
                    <span>@L["Inbox"]</span>
                    @if (pendingCount > 0)
                    {
                        <span class="nav-item__badge">@pendingCount</span>
                    }
                </a>
                <a class="nav-item" href="/Documents">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                        <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
                        <path d="M9 13h6M9 17h4" />
                    </svg>
                    <span>@L["Documents"]</span>
                </a>
                <a class="nav-item" href="/Correspondents">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <span>@L["Correspondents"]</span>
                </a>
                <a class="nav-item" href="/Tags">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.59 13.41 11 3.82A2 2 0 0 0 9.59 3H4a1 1 0 0 0-1 1v5.59A2 2 0 0 0 3.82 11l9.59 9.59a2 2 0 0 0 2.83 0l4.35-4.35a2 2 0 0 0 0-2.83z" />
                        <path d="M7 7h.01" />
                    </svg>
                    <span>@L["Tags"]</span>
                </a>
                <a class="nav-item" href="/Projects">
                    <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    </svg>
                    <span>@L["Projects"]</span>
                </a>
                @if (CurrentUser.IsAdmin)
                {
                    <a class="nav-item" href="/System">
                        <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                        </svg>
                        <span>@L["System"]</span>
                    </a>
                }
            </nav>

            <div class="sidebar__footer">
                <a class="account" href="/Account" title='@L["Account"]'>
                    <span class="account__avatar" aria-hidden="true">@avatarLetter</span>
                    <span class="account__body">
                        <span class="account__name">@accountName</span>
                        @if (!string.IsNullOrEmpty(CurrentUser.Role))
                        {
                            <span class="account__role">@CurrentUser.Role</span>
                        }
                    </span>
                </a>
                <form class="account__logout-form" method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="account__logout" title='@L["Sign out"]' aria-label='@L["Sign out"]'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <path d="M16 17l5-5-5-5M21 12H9" />
                        </svg>
                        <span class="account__logout-label">@L["Sign out"]</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-header">
                <button type="button" class="hamburger" id="sidebar-toggle" aria-label='@L["Toggle navigation"]' aria-controls="sidebar" aria-expanded="false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12h18M3 6h18M3 18h18" />
                    </svg>
                </button>
                <nav class="breadcrumb" aria-label='@L["Breadcrumb"]'>
                    @for (var i = 0; i < breadcrumbParts.Count; i++)
                    {
                        if (i > 0)
                        {
                            <span class="breadcrumb__sep" aria-hidden="true">/</span>
                        }

                        if (breadcrumbLinkable && i < breadcrumbParts.Count - 1)
                        {
                            <a class="breadcrumb__link" href="/@string.Join("/", pathParts.Take(i + 1))">@breadcrumbParts[i]</a>
                        }
                        else
                        {
                            <span class="@(i == breadcrumbParts.Count - 1 ? "breadcrumb__current" : "")">@breadcrumbParts[i]</span>
                        }
                    }
                </nav>
                @* Phones: scan from anywhere (the sidebar button is out of reach there). *@
                <a class="header-add" href="/Documents/Upload?camera=true" title='@L["Scan a document"]' aria-label='@L["Scan a document"]'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </a>
            </header>

            <main class="app-content">
                <partial name="_Notice" />
                @RenderBody()
            </main>
        </div>
    </div>


    <dialog id="mp-confirm" class="confirm">
        <form method="dialog" class="confirm__inner" data-no-busy>
            <p class="confirm__text"></p>
            <div class="confirm__actions">
                <button class="btn btn--secondary" value="cancel">@L["Cancel"]</button>
                <button class="btn btn--primary confirm__ok" value="ok">@L["Confirm"]</button>
            </div>
        </form>
    </dialog>

    @if (Context.Request.Method == "POST")
    {
        @* A page answered by a handler button (Test, Preview, ...) keeps "?handler=..." in its address, and
           the form without an action would post "Save" to that same handler. Drop it from the address. *@
        <script>
            (function () {
                var url = new URL(location.href);
                if (url.searchParams.has("handler")) {
                    url.searchParams.delete("handler");
                    history.replaceState(null, "", url.pathname + url.search + url.hash);
                }
            })();
        </script>
    }

    <div id="viewer-i18n" hidden data-close='@L["Close"]' data-download='@L["Download"]' data-page='@L["Page"]'
         data-share='@L["Share document"]' data-link='@L["Link"]' data-link-copied='@L["Link copied - valid for {0} days"]'
         data-share-failed='@L["The document could not be shared."]' data-share-forbidden='@L["Only the owner can share this document."]'
         data-no-preview='@L["There is no preview for this file type."]' data-failed='@L["The document could not be shown."]'></div>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/doc-viewer.js" asp-append-version="true"></script>
    <script src="~/js/picker.js" asp-append-version="true"></script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
