@using MatPaper.Controls
@inject MatPaper.Services.ThemeService Themes
@inject MatPaper.Controls.Toolkit Toolkit
@{
    // Sign-in, setup, a shared link, "no access": no menu, a centred card on the plain page background with the logo above the title (SHELL-11).
    // The page fills in Heading (the h1; default: its breadcrumb) and PageSub (the muted line under it); ShellClass widens the card (a shared document).
    var breadcrumb = ViewData["Breadcrumb"] as string ?? "";
    var theme = await Themes.ResolveAsync();
    var heading = ViewData["Heading"] as string ?? ViewData["Title"] as string ?? (string.IsNullOrEmpty(breadcrumb) ? Ui.App.Name : breadcrumb);
    var sub = ViewData["PageSub"] as string;
    ViewData["FullTitle"] = string.IsNullOrEmpty(breadcrumb) ? Ui.App.Name : $"{breadcrumb} · {Ui.App.Name}";
    var authUiCulture = global::System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@authUiCulture" @Html.Raw(theme.RootAttributes) @Ui.RootTexts(L)>
<partial name="_Head" model="theme" />
<body>
    <a class="mat-skip" href="#main">@L["Skip to the content"]</a>
    @Html.Raw(Toolkit.Sprite)
    <main class="mat-auth" id="main">
        <div class="mat-auth__card @(ViewData["ShellClass"] as string)">
            <div class="mat-auth__brand">
                @Ui.Logo("xl")
                <h1>@heading</h1>
                @if (!string.IsNullOrEmpty(sub))
                {
                    <p class="mat-muted">@sub</p>
                }
            </div>

            <partial name="_Notice" />
            @RenderBody()
        </div>

        <form class="mp-lang" method="post" action="/Account/Language" role="group" aria-label='@L["Language"]'>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="mat-seg">
                <button type="submit" name="culture" value="de-DE" class="mat-seg__btn" aria-pressed="@(authUiCulture == "de" ? "true" : "false")">Deutsch</button>
                <button type="submit" name="culture" value="en-US" class="mat-seg__btn" aria-pressed="@(authUiCulture == "en" ? "true" : "false")">English</button>
            </div>
        </form>
    </main>

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/matpaper.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
