@{
    var breadcrumb = ViewData["Breadcrumb"] as string ?? "";
}
<!DOCTYPE html>
<html lang="@(global::System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(breadcrumb) ? "MatPaper" : $"{breadcrumb} · MatPaper")</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-shell">
        <div class="auth-brand">
            <svg class="auth-brand__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
            </svg>
            <span class="auth-brand__text">MatPaper</span>
        </div>

        @RenderBody()

        @{
            var authUiCulture = global::System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        }
        <form class="lang-switch lang-switch--auth" method="post" action="/Account/Language" role="group" aria-label='@L["Language"]'>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <button type="submit" name="culture" value="de-DE"
                    class="lang-switch__btn@(authUiCulture == "de" ? " is-active" : "")">DE</button>
            <button type="submit" name="culture" value="en-US"
                    class="lang-switch__btn@(authUiCulture == "en" ? " is-active" : "")">EN</button>
        </form>
    </main>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
