@*
    The page-level "what just happened" message (SHELL-12). Rendered once by the layouts; page models fill it with page.Notify(...) / page.NotifyNow(...).
    Something done is a toast (the toolkit shows it and removes the element); something to read - a warning, a failure - is an alert at the top of the content.
    Field errors do NOT belong here: they stay at the field and in the validation summary.
*@
@{
    var noticeText = (ViewData[MatPaper.Services.NoticeExtensions.TextKey]
        ?? TempData[MatPaper.Services.NoticeExtensions.TextKey]) as string;
    var noticeKind = ((ViewData[MatPaper.Services.NoticeExtensions.KindKey]
        ?? TempData[MatPaper.Services.NoticeExtensions.KindKey]) as string ?? "Ok").ToLowerInvariant();
}

@if (!string.IsNullOrWhiteSpace(noticeText))
{
    if (noticeKind is "danger" or "warn")
    {
        var tone = noticeKind == "danger" ? "danger" : "warning";
        <div class="mat-alert mat-alert--@tone" role="alert">
            @MatPaper.Controls.Ui.Icon(noticeKind == "danger" ? "x-circle" : "alert")
            <div class="mat-alert__body">@noticeText</div>
        </div>
    }
    else
    {
        <span data-toast="@noticeText" data-tone="@(noticeKind == "ok" ? "success" : "")" hidden></span>
    }
}
