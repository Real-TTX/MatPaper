@model MatPaper.Services.QuickConnectionConfig
@* "New connection ..." without leaving the page: the connection selects named in the model get an extra entry that opens this dialog (a dialog of the toolkit).
   It creates a password connection (NAS share, mailbox) through /System/Connections/Edit?handler=Quick and selects it. Cloud drives need a sign-in at Google
   or Microsoft, so for those the dialog only points to the connections page. See quick-connection.js. *@
<dialog id="quick-connection" class="mat-dialog mat-dialog--sm" aria-labelledby="quick-connection-title" data-static
        data-smb="@string.Join(",", Model.Smb)" data-mail="@string.Join(",", Model.Mail)" data-cloud="@string.Join(",", Model.Cloud)"
        data-t-new='@L["New connection …"]' data-t-saving='@L["Saving …"]' data-t-failed='@L["The connection could not be saved."]'>
    <form method="dialog" class="mat-dialog__form" novalidate>
        <div class="mat-dialog__head">
            <mp-icon name="plug" />
            <h2 class="mat-dialog__title" id="quick-connection-title">@L["New connection"]</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-qc="close" aria-label='@L["Close"]'><mp-icon name="x" /></button>
        </div>

        <div class="mat-dialog__body mat-form" data-qc="fields">
            <div class="mat-field" data-qc-only="mail">
                <label class="mat-label" for="qc-kind">@L["Type"]</label>
                <select class="mat-select" id="qc-kind" name="Input.Kind">
                    <option value="1">IMAP</option>
                    <option value="2">POP3</option>
                </select>
            </div>
            <div class="mat-field">
                <label class="mat-label" for="qc-name">@L["Name"]</label>
                <input class="mat-input" id="qc-name" name="Input.Name" autocomplete="off" />
            </div>
            <div class="mat-field">
                <label class="mat-label" for="qc-host">@L["Host"]</label>
                <input class="mat-input" id="qc-host" name="Input.Host" autocomplete="off" />
            </div>
            <div class="mat-field" data-qc-only="smb">
                <label class="mat-label" for="qc-share">@L["SMB share"]</label>
                <input class="mat-input" id="qc-share" name="Input.Share" placeholder="Documents" autocomplete="off" />
            </div>
            <div class="mat-field" data-qc-only="smb">
                <label class="mat-label" for="qc-path">@L["Folder in share"]</label>
                <input class="mat-input" id="qc-path" name="Input.SmbPath" placeholder="MatPaper" autocomplete="off" />
            </div>
            <div class="mat-field" data-qc-only="smb">
                <label class="mat-label" for="qc-domain">@L["Domain"]</label>
                <input class="mat-input" id="qc-domain" name="Input.Domain" autocomplete="off" />
            </div>
            <div class="mat-field" data-qc-only="mail">
                <label class="mat-label" for="qc-port">@L["Port"]</label>
                <input class="mat-input" id="qc-port" name="Input.Port" type="number" value="993" inputmode="numeric" />
            </div>
            <div class="mat-field" data-qc-only="mail">
                <label class="mat-check"><input type="checkbox" id="qc-ssl" checked /><span class="mat-check__text">@L["Use SSL/TLS"]</span></label>
            </div>
            <div class="mat-field">
                <label class="mat-label" for="qc-user">@L["Username"]</label>
                <input class="mat-input" id="qc-user" name="Input.Username" autocomplete="off" />
            </div>
            <div class="mat-field">
                <label class="mat-label" for="qc-pass">@L["Password"]</label>
                <input class="mat-input" id="qc-pass" name="Input.Password" type="password" autocomplete="new-password" />
            </div>
            <div class="mat-alert mat-alert--danger" role="alert" data-qc="errors" hidden><mp-icon name="x-circle" /><div class="mat-alert__body"></div></div>
        </div>

        <div class="mat-dialog__body mat-stack" data-qc="cloud" hidden>
            <p>@L["Google Drive and OneDrive need a sign-in at Google or Microsoft. Create that connection under System → Connections, then pick it here."]</p>
            <div><mp-button variant="primary" href="/System/Connections/Edit" target="_blank" rel="noopener" icon="external">@L["Open the connections"]</mp-button></div>
        </div>

        <div class="mat-dialog__foot">
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="button" class="mat-btn mat-btn--primary" data-qc="save"><mp-icon name="save" /><span>@L["Save connection"]</span></button>
                <button type="button" class="mat-btn mat-btn--secondary" data-qc="close">@L["Cancel"]</button>
            </div>
        </div>
    </form>
</dialog>
<script src="~/js/quick-connection.js" asp-append-version="true" defer></script>
