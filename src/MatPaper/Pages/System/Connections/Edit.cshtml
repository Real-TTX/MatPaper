@page "/System/Connections/Edit"
@model MatPaper.Pages.System.Connections.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["System / Connections / Edit"].Value : L["System / Connections / New"].Value;
    ViewData["Heading"] = Model.IsEdit ? Model.Input.Name : L["New connection"].Value;
    ViewData["Width"] = "narrow";
}

<form method="post" class="mat-form" novalidate>
    <input type="hidden" asp-for="Id" />
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Connection"]</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Gmail archive"]' full="true" />

                <mp-field asp-for="Input.Kind" kind="select" label='@L["Type"]'>
                    <option value="1">IMAP</option>
                    <option value="2">POP3</option>
                    <option value="0">@L["SMB / CIFS network share"]</option>
                    <option value="3">Google Drive</option>
                    <option value="4">OneDrive</option>
                </mp-field>

                <mp-field asp-for="Input.AuthMode" kind="select" label='@L["Sign-in"]'>
                    <option value="0">@L["Password / app password"]</option>
                    <option value="1">@L["OAuth (Google, Microsoft)"]</option>
                </mp-field>
            </div>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Endpoint"]</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Kind" data-show-value="0,1,2">
                    <mp-field asp-for="Input.Host" label='@L["Host"]' placeholder="imap.gmail.com" full="true" mono="true" />
                </div>

                <div class="mat-form__grid mat-field--full" data-show-if="Input.Kind" data-show-value="0">
                    <mp-field asp-for="Input.Share" label='@L["SMB share"]' placeholder="documents" />
                    <mp-field asp-for="Input.SmbPath" label='@L["Folder in share"]' placeholder="MatPaper" mono="true"
                              help='@L["Optional. Locations and import tasks using this connection start in this folder."]' />
                    <mp-field asp-for="Input.Domain" label='@L["Domain"]' help='@L["Optional (Windows domain or workgroup)."]' />
                </div>

                <div class="mat-form__grid mat-field--full" data-show-if="Input.Kind" data-show-value="1,2">
                    <mp-field asp-for="Input.Port" kind="number" label='@L["Port"]' inputmode="numeric" />
                    <mp-field asp-for="Input.UseSsl" kind="switch" label='@L["Use SSL/TLS"]' />
                    <p class="mat-hint mat-field--full">@L["Gmail: imap.gmail.com:993. Office 365: outlook.office365.com:993."]</p>
                </div>

                <div class="mat-form__grid mat-field--full" data-show-if="Input.Kind" data-show-value="3">
                    <mp-field asp-for="Input.RootFolderId" label='@L["Root folder ID"]' full="true" mono="true"
                              help='@L["Optional: Drive folder ID. Empty means the whole My Drive."]' />
                </div>

                <div class="mat-form__grid mat-field--full" data-show-if="Input.Kind" data-show-value="4">
                    <mp-field asp-for="Input.OneDriveDriveId" label='@L["Drive ID"]' autocomplete="off" mono="true"
                              help='@L["Optional: ID of another drive, e.g. a SharePoint library. Empty means your OneDrive."]' />
                    <mp-field asp-for="Input.OneDriveRootItemId" label='@L["Root folder ID"]' autocomplete="off" mono="true"
                              help='@L["Optional: folder ID. Empty means the drive root."]' />
                </div>
            </div>
        </div>
    </div>

    <div class="mat-card" data-show-if="Input.AuthMode" data-show-value="0">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Sign-in"]</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mp-field asp-for="Input.Username" label='@L["Username"]' placeholder='@L["e.g. scan-user"]' autocomplete="off" />
                <mp-field asp-for="Input.Password" kind="password" label='@L["Password"]' autocomplete="new-password"
                          help='@(Model.IsEdit ? L["Leave blank to keep the stored password."].Value : L["For Gmail, use an app password."].Value)' />
            </div>
        </div>
    </div>

    <div class="mat-card" data-show-if="Input.AuthMode" data-show-value="1">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["OAuth"]</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mp-field asp-for="Input.Provider" kind="select" label='@L["Provider"]'>
                    <option value="1">Google</option>
                    <option value="2">Microsoft</option>
                </mp-field>

                <mp-field asp-for="Input.OAuthEmail" kind="email" label='@L["Account e-mail address"]' placeholder="name@gmail.com" />
                <mp-field asp-for="Input.OAuthClientId" label='@L["Client ID"]' autocomplete="off" mono="true" />
                <mp-field asp-for="Input.OAuthClientSecret" kind="password" label='@L["Client secret"]' autocomplete="off"
                          help='@(Model.IsEdit ? L["Leave blank to keep the stored secret."].Value : null)' />

                <div class="mat-field mat-field--full">
                    @if (string.IsNullOrEmpty(Model.RedirectUri))
                    {
                        <span class="mat-label">@L["Redirect URI"]</span>
                        <div class="mat-alert mat-alert--warning" role="status">
                            <mp-icon name="alert" />
                            <div class="mat-alert__body">@L["Set the public address under System, Settings so a redirect URI can be shown."] <a href="/System/Settings">@L["Open settings"]</a></div>
                        </div>
                    }
                    else
                    {
                        <label class="mat-label" for="oauth-redirect-uri">@L["Redirect URI"]</label>
                        <div class="mat-input-group">
                            <input class="mat-input mat-mono" id="oauth-redirect-uri" type="text" value="@Model.RedirectUri" readonly />
                            <button type="button" class="mat-btn mat-btn--secondary" data-copy="#oauth-redirect-uri"><mp-icon name="copy" /><span>@L["Copy"]</span></button>
                        </div>
                        <span class="mat-hint">@L["Register this exact URI with your Google Cloud / Azure app."]</span>
                    }
                </div>

                @if (Model.IsEdit)
                {
                    <div class="mat-field mat-field--full mat-stack">
                        @if (Model.IsConnected)
                        {
                            <div class="mat-alert mat-alert--success" role="status">
                                <mp-icon name="check-circle" />
                                <div class="mat-alert__body">@L["Connected as {0}", Model.ConnectedAccount ?? "—"]@(Model.ConnectedUtc.HasValue ? " · " + Fmt.Date(Model.ConnectedUtc) : "")</div>
                            </div>
                        }
                        else
                        {
                            <p class="mat-muted">@L["Not connected yet. Save, then press Connect."]</p>
                        }
                        <div>
                            <mp-button variant="secondary" handler="Connect" icon="link" disabled="@string.IsNullOrEmpty(Model.RedirectUri)">@(Model.IsConnected ? L["Reconnect"].Value : L["Connect"].Value)</mp-button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <mp-button-row>
        <mp-button variant="primary" icon="save">@L["Save"]</mp-button>
        <mp-button variant="secondary" href="/System/Connections" icon="back">@L["Back"]</mp-button>
        @if (Model.IsEdit)
        {
            <mp-button-spacer />
            <mp-button variant="danger" icon="trash" handler="Delete"
                       confirm='@L["Delete this connection? Storage locations and import tasks using it will stop working."]' confirm-ok='@L["Delete"]'>@L["Delete"]</mp-button>
        }
    </mp-button-row>
</form>
