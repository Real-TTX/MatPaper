@page "/System/Credentials/Edit"
@model MatPaper.Pages.System.Credentials.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["System / Credentials / Edit"].Value : L["System / Credentials / New"].Value;
}

<form class="form" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. NAS account"]' />
    <mp-field asp-for="Input.Username" label='@L["Username"]' placeholder='@L["e.g. scan-user"]' />
    <mp-field asp-for="Input.Domain" label='@L["Domain"]' help='@L["Optional (Windows domain or workgroup)."]' />
    <mp-field asp-for="Input.Password" kind="password" label='@L["Password"]'
              help='@(Model.IsEdit ? L["Leave blank to keep the stored password."].Value : L["Required."].Value)' />

    <mp-button-row>
        <mp-button variant="primary" type="submit">@L["Save"]</mp-button>
        <mp-button variant="secondary" href="/System/Credentials">@L["Back"]</mp-button>
        <mp-button-spacer />
        @if (Model.IsEdit)
        {
            <mp-button variant="danger" type="submit" handler="Delete"
                       confirm='@L["Delete this credential? Import tasks using it will fall back to their own username/password."]'>@L["Delete"]</mp-button>
        }
    </mp-button-row>
</form>
