@page "/System/Credentials/Edit"
@model MatPaper.Pages.System.Credentials.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? "System / Credentials / Edit" : "System / Credentials / New";
}

<form class="form" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <mp-field asp-for="Input.Name" label="Name" placeholder="e.g. NAS account" />
    <mp-field asp-for="Input.Username" label="Username" placeholder="e.g. scan-user" />
    <mp-field asp-for="Input.Domain" label="Domain" help="Optional (Windows domain or workgroup)." />
    <mp-field asp-for="Input.Password" kind="password" label="Password"
              help="@(Model.IsEdit ? "Leave blank to keep the stored password." : "Required.")" />

    <mp-button-row>
        <mp-button variant="primary" type="submit">Save</mp-button>
        <mp-button variant="secondary" href="/System/Credentials">Back</mp-button>
        <mp-button-spacer />
        @if (Model.IsEdit)
        {
            <mp-button variant="danger" type="submit" handler="Delete"
                       confirm="Delete this credential? Import tasks using it will fall back to their own username/password.">Delete</mp-button>
        }
    </mp-button-row>
</form>
