@page "/System/Credentials"
@model MatPaper.Pages.System.Credentials.IndexModel
@{
    ViewData["Breadcrumb"] = "System / Credentials";
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder="Name or username" />
</mp-toolbar>

<p class="form-help">Reusable access credentials for import tasks (mailboxes and SMB/CIFS shares). Passwords are stored encrypted.</p>

<mp-table item-count="Model.Rows.Count" empty-text="No credentials yet.">
    <thead>
        <tr>
            <th>Name</th>
            <th>Username</th>
            <th>Domain</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Rows)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Username</td>
                <td>@(string.IsNullOrWhiteSpace(c.Domain) ? "—" : c.Domain)</td>
                <td class="is-actions"><a href="/System/Credentials/Edit?id=@c.Id">Edit</a></td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/System/Credentials/Edit">New credential</a>
</div>
