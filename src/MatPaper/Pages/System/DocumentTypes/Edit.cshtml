@page "/System/DocumentTypes/Edit"
@model MatPaper.Pages.System.DocumentTypes.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["System / Document types / Edit"].Value : L["System / Document types / New"].Value;
    ViewData["Heading"] = Model.IsEdit ? L["Edit document type"].Value : L["New document type"].Value;
    ViewData["Width"] = "narrow";
}

<form method="post" class="mat-form" novalidate>
    <input type="hidden" asp-for="Id" />
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Rechnung"]' full="true" />
                <mp-field asp-for="Input.MatchPattern" label='@L["Alternative names / keywords"]' help='@L["Alternative terms or a regex, comma-separated, e.g. invoice, faktura."]' full="true" />
            </div>
        </div>
    </div>

    <mp-button-row>
        <mp-button variant="primary" icon="save">@L["Save"]</mp-button>
        <mp-button variant="secondary" href="/System/DocumentTypes" icon="back">@L["Back"]</mp-button>
        @if (Model.IsEdit)
        {
            <mp-button-spacer />
            <mp-button variant="danger" icon="trash" handler="Delete" confirm='@L["Delete this document type? This cannot be undone."]' confirm-ok='@L["Delete"]'>@L["Delete"]</mp-button>
        }
    </mp-button-row>
</form>
