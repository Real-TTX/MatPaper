@page "/System/DocumentTypes/Edit"
@model MatPaper.Pages.System.DocumentTypes.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["System / Document types / Edit"].Value : L["System / Document types / New"].Value;
    var matchPatternHelp = L["Comma-separated alternative names or a regex, matched against a document's text to auto-assign this type — e.g. invoice, faktura."].Value;
}

<form method="post" class="form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Rechnung"]' />
    <mp-field asp-for="Input.MatchPattern" label='@L["Alternative names / keywords"]'
              help="@matchPatternHelp" />

    <mp-button-row>
        <mp-button variant="primary" type="submit">@L["Save"]</mp-button>
        <mp-button variant="secondary" href="/System/DocumentTypes">@L["Back"]</mp-button>
        <mp-button-spacer />
        @if (Model.IsEdit)
        {
            <mp-button variant="danger" type="submit" handler="Delete" confirm='@L["Delete this document type? This cannot be undone."]'>@L["Delete"]</mp-button>
        }
    </mp-button-row>
</form>
