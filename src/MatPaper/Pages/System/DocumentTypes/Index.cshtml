@page "/System/DocumentTypes"
@model MatPaper.Pages.System.DocumentTypes.IndexModel
@{
    ViewData["Breadcrumb"] = L["System / Document types"].Value;
}

<mp-toolbar count="Model.TotalCount">
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
    <mp-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="name_asc">@L["Name (A–Z)"]</option>
        <option value="name_desc">@L["Name (Z–A)"]</option>
    </mp-toolbar-select>
</mp-toolbar>

@{
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search));
}
<partial name="_FilterChips" model="activeFilters" />

<mp-table item-count="Model.Rows.Count" empty-text='@L["No document types match your criteria."]'>
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Rows)
        {
            <tr data-row-href="/System/DocumentTypes/Edit?id=@t.Id" tabindex="0">
                <td>@t.Name</td>
                <td class="is-actions"><a class="icon-btn" href="/System/DocumentTypes/Edit?id=@t.Id" title='@L["Edit"]' aria-label='@L["Edit"]'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg></a></td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/System/DocumentTypes/Edit">@L["New document type"]</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
