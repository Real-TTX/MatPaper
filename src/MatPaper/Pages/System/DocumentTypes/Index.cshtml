@page "/System/DocumentTypes"
@model MatPaper.Pages.System.DocumentTypes.IndexModel
@{
    ViewData["Breadcrumb"] = L["System / Document types"].Value;
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search));
}

<div class="mat-list">
    <mp-toolbar id="doctypes" label='@L["Document types"]' count="Model.TotalCount" singular="{0} document type" plural="{0} document types">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
        <mp-toolbar-sort value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="activeFilters" />

    <mp-table item-count="Model.Rows.Count" empty-text='@L["No document types match your criteria."]' caption='@L["Document types"]'>
        <thead>
            <tr>
                <th scope="col">@L["Name"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Rows)
            {
                <tr data-row-href="/System/DocumentTypes/Edit?id=@t.Id">
                    <td><div class="mat-table__name"><a href="/System/DocumentTypes/Edit?id=@t.Id">@t.Name</a></div></td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/System/DocumentTypes/Edit?id={t.Id}")' />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mp-table>

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />

    <div class="mat-actions">
        <mp-button variant="primary" href="/System/DocumentTypes/Edit" icon="plus">@L["New document type"]</mp-button>
    </div>
</div>
