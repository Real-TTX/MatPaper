@page "/System/ExportTasks/Details"
@model MatPaper.Pages.System.ExportTasks.DetailsModel
@using MatPaper.Data
@using MatPaper.Services
@{
    var t = Model.Task;
    var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone);
    ViewData["Heading"] = t.Name;
    ViewData["Title"] = t.Name;
}

<div class="mat-stack">
    <div class="mat-card">
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>@L["Type"]</dt>
                <dd>
                    <span class="mat-pill mat-pill--plain">@(t.Type == ExportTaskType.Backup ? L["Full backup"].Value : L["Export documents"].Value)</span>
                    @if (t.IsEnabled) { <span class="mat-pill mat-pill--ok">@L["Enabled"]</span> }
                    else { <span class="mat-pill mat-pill--warn">@L["Disabled"]</span> }
                </dd>
                <dt>@L["Schedule"]</dt>
                <dd>
                    <span class="@(sched.IsValid ? "" : "mat-pill mat-pill--warn")">@sched.Text</span>
                    @if (sched.NextUtc is DateTime nextUtc && t.IsEnabled)
                    {
                        <small class="mat-muted"> · @L["next:"] @Fmt.DateTime(nextUtc)</small>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <partial name="_TaskRunsPanel" model="Model.Runs" />

    <div class="mat-grid">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@(t.Type == ExportTaskType.Backup ? L["Backup settings"].Value : L["Which documents"].Value)</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var (label, value) in Model.What)
                    {
                        <dt>@label</dt>
                        <dd>@value</dd>
                    }
                </dl>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Where to"]</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var (label, value) in Model.Destination)
                    {
                        <dt>@label</dt>
                        <dd class="mat-mono">@value</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    @if (Model.LastRun is { } last && (!string.IsNullOrWhiteSpace(last.Log) || Model.Runs.IsRunning))
    {
        <div class="mat-card" data-live="log">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Log of the latest run"]</h2></div>
            <div class="mat-card__body mat-stack">
                <pre class="mat-code mp-log">@last.Log</pre>
                <a href="/System/TaskRuns/Details?id=@last.Id">@Fmt.DateTimeSeconds(last.StartedAt)</a>
            </div>
        </div>
    }

    <mp-button-row>
        <mp-button variant="primary" href="@($"/System/ExportTasks/Edit?id={t.Id}")" icon="edit">@L["Edit"]</mp-button>
        <mp-button variant="secondary" href="/System/ExportTasks" icon="back">@L["Back"]</mp-button>
    </mp-button-row>
</div>
