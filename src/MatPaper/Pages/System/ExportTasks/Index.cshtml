@page "/System/ExportTasks"
@model MatPaper.Pages.System.ExportTasks.IndexModel
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = L["System / Export tasks"].Value;
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
    <mp-toolbar-select name="Type" label='@L["Type"]' value="@Model.Type">
        <option value="all">@L["All"]</option>
        <option value="export">@L["Export documents"]</option>
        <option value="backup">@L["Full backup"]</option>
    </mp-toolbar-select>
    <mp-toolbar-select name="Status" label='@L["Status"]' value="@Model.Status">
        <option value="all">@L["All"]</option>
        <option value="enabled">@L["Enabled"]</option>
        <option value="disabled">@L["Disabled"]</option>
    </mp-toolbar-select>
    <mp-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="name_asc">@L["Name (A–Z)"]</option>
        <option value="name_desc">@L["Name (Z–A)"]</option>
        <option value="run_desc">@L["Last run (newest first)"]</option>
        <option value="run_asc">@L["Last run (oldest first)"]</option>
    </mp-toolbar-select>
</mp-toolbar>

@{
    var typeLabel = Model.Type switch { "export" => L["Export documents"].Value, "backup" => L["Full backup"].Value, _ => null };
    var statusLabel = Model.Status switch { "enabled" => L["Enabled"].Value, "disabled" => L["Disabled"].Value, _ => null };
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search),
        new MatPaper.Services.FilterSpec("Type", L["Type"].Value, typeLabel),
        new MatPaper.Services.FilterSpec("Status", L["Status"].Value, statusLabel));
}
<partial name="_FilterChips" model="activeFilters" />

<mp-list-bar count="Model.TotalCount" singular="{0} export rule" plural="{0} export rules" current-page="Model.PageNumber" total-pages="Model.TotalPages" />

<mp-table item-count="Model.Rows.Count" empty-text='@L["No export tasks match your criteria."]'>
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Type"]</th>
            <th>@L["Enabled"]</th>
            <th>@L["Schedule"]</th>
            <th>@L["Last run"]</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Rows)
        {
            <tr data-row-href="/System/ExportTasks/Details?id=@t.Id" tabindex="0">
                <td>@t.Name</td>
                <td>@(t.Type == MatPaper.Data.ExportTaskType.Backup ? L["Full backup"].Value : L["Export documents"].Value)</td>
                <td>
                    @if (t.IsEnabled)
                    {
                        <span class="badge badge--ok">@L["Enabled"]</span>
                    }
                    else
                    {
                        <span class="badge badge--warn">@L["Disabled"]</span>
                    }
                </td>
                <td>
                    @{ var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone); }
                    <span class="@(sched.IsValid ? "" : "badge badge--warn")">@sched.Text</span>
                    @if (sched.NextUtc is DateTime nextUtc)
                    {
                        <br /><span class="form-help" style="margin:0">@L["next:"] @Fmt.DateTime(nextUtc)</span>
                    }
                </td>
                <td>
                    @if (t.LastRunState is null)
                    {
                        <span class="badge badge--muted">@L["Never"]</span>
                    }
                    else
                    {
                        @switch (t.LastRunState)
                        {
                            case MatPaper.Data.TaskRunState.Success:
                                <span class="badge badge--ok">@L["Success"]</span>
                                break;
                            case MatPaper.Data.TaskRunState.Failed:
                                <span class="badge badge--off">@L["Failed"]</span>
                                break;
                            case MatPaper.Data.TaskRunState.Cancelled:
                                <span class="badge badge--warn">@L["Cancelled"]</span>
                                break;
                            default:
                                <span class="badge badge--muted">@L["Running"]</span>
                                break;
                        }
                        <span>&nbsp;@Fmt.DateTime(t.LastRunStartedAt)</span>
                    }
                </td>
                <td class="is-actions">
                    <form method="post" action="/System/ExportTasks/Edit?id=@t.Id&handler=Run" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="icon-btn" type="submit" title='@L["Run now"]' aria-label='@L["Run now"]'>
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                        </button>
                    </form>
                    <a class="icon-btn" href="/System/ExportTasks/Edit?id=@t.Id" title='@L["Edit"]' aria-label='@L["Edit"]'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg></a>
                </td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/System/ExportTasks/Edit">@L["New export task"]</a>
</div>

<mp-list-bar position="bottom" />
