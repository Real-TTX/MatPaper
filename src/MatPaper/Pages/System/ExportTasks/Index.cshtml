@page "/System/ExportTasks"
@model MatPaper.Pages.System.ExportTasks.IndexModel
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = L["System / Export tasks"].Value;
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
</mp-toolbar>

<mp-table item-count="Model.Rows.Count" empty-text='@L["No export tasks match your criteria."]'>
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Type"]</th>
            <th>@L["Enabled"]</th>
            <th>@L["Schedule"]</th>
            <th>@L["Last run"]</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Rows)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.Type</td>
                <td>
                    @if (t.IsEnabled)
                    {
                        <span class="badge badge--ok">@L["Enabled"]</span>
                    }
                    else
                    {
                        <span class="badge badge--off">@L["Disabled"]</span>
                    }
                </td>
                <td>
                    @{ var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone); }
                    <span class="@(sched.IsValid ? "" : "badge badge--off")">@sched.Text</span>
                    @if (sched.NextUtc is DateTime nextUtc)
                    {
                        <br /><span class="form-help" style="margin:0">@L["next:"] @Fmt.DateTime(nextUtc)</span>
                    }
                </td>
                <td>
                    @if (t.LastRunState is null)
                    {
                        <span class="badge badge--muted">@L["Never"]</span>
                    }
                    else
                    {
                        @switch (t.LastRunState)
                        {
                            case MatPaper.Data.TaskRunState.Success:
                                <span class="badge badge--ok">@L["Success"]</span>
                                break;
                            case MatPaper.Data.TaskRunState.Failed:
                                <span class="badge badge--off">@L["Failed"]</span>
                                break;
                            default:
                                <span class="badge badge--muted">@L["Running"]</span>
                                break;
                        }
                        <span>&nbsp;@Fmt.DateTime(t.LastRunStartedAt)</span>
                    }
                </td>
                <td class="is-actions">
                    <a href="/System/ExportTasks/Edit?id=@t.Id">@L["Edit"]</a>
                </td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/System/ExportTasks/Edit">@L["New export task"]</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
