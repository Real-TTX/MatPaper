@page "/System/ExportTasks"
@model MatPaper.Pages.System.ExportTasks.IndexModel
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = L["System / Export tasks"].Value;
    var typeLabel = Model.Type switch { "export" => L["Export documents"].Value, "backup" => L["Full backup"].Value, _ => null };
    var statusLabel = Model.Status switch { "enabled" => L["Enabled"].Value, "disabled" => L["Disabled"].Value, _ => null };
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search),
        new MatPaper.Services.FilterSpec("Type", L["Type"].Value, typeLabel),
        new MatPaper.Services.FilterSpec("Status", L["Status"].Value, statusLabel));
}

<div class="mat-list">
    <mp-toolbar id="exporttasks" label='@L["Export tasks"]' count="Model.TotalCount" singular="{0} export rule" plural="{0} export rules">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
        <mp-toolbar-select name="Type" label='@L["Type"]' value="@Model.Type">
            <option value="all">@L["All"]</option>
            <option value="export">@L["Export documents"]</option>
            <option value="backup">@L["Full backup"]</option>
        </mp-toolbar-select>
        <mp-toolbar-select name="Status" label='@L["Status"]' value="@Model.Status">
            <option value="all">@L["All"]</option>
            <option value="enabled">@L["Enabled"]</option>
            <option value="disabled">@L["Disabled"]</option>
        </mp-toolbar-select>
        <mp-toolbar-sort value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
            <option value="run_desc">@L["Last run (newest first)"]</option>
            <option value="run_asc">@L["Last run (oldest first)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="activeFilters" />

    <mp-table item-count="Model.Rows.Count" empty-text='@L["No export tasks match your criteria."]' caption='@L["Export tasks"]'>
        <thead>
            <tr>
                <th scope="col">@L["Name"]</th>
                <th scope="col" class="mat-hide-sm">@L["Type"]</th>
                <th scope="col">@L["Enabled"]</th>
                <th scope="col" class="mat-hide-sm">@L["Schedule"]</th>
                <th scope="col">@L["Last run"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Rows)
            {
                var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone);
                <tr data-row-href="/System/ExportTasks/Details?id=@t.Id">
                    <td><div class="mat-table__name"><a href="/System/ExportTasks/Details?id=@t.Id">@t.Name</a></div></td>
                    <td class="mat-hide-sm">@(t.Type == MatPaper.Data.ExportTaskType.Backup ? L["Full backup"].Value : L["Export documents"].Value)</td>
                    <td>
                        @if (t.IsEnabled)
                        {
                            <span class="mat-pill mat-pill--ok">@L["Enabled"]</span>
                        }
                        else
                        {
                            <span class="mat-pill mat-pill--warn">@L["Disabled"]</span>
                        }
                    </td>
                    <td class="mat-hide-sm">
                        <span class="@(sched.IsValid ? "" : "mat-pill mat-pill--warn")">@sched.Text</span>
                        @if (sched.NextUtc is DateTime nextUtc)
                        {
                            <small class="mat-muted mp-block">@L["next:"] @Fmt.DateTime(nextUtc)</small>
                        }
                    </td>
                    <td>
                        @if (t.LastRunState is null)
                        {
                            <span class="mat-pill mat-pill--plain">@L["Never"]</span>
                        }
                        else
                        {
                            @switch (t.LastRunState)
                            {
                                case MatPaper.Data.TaskRunState.Success:
                                    <span class="mat-pill mat-pill--ok">@L["Success"]</span>
                                    break;
                                case MatPaper.Data.TaskRunState.Failed:
                                    <span class="mat-pill mat-pill--error">@L["Failed"]</span>
                                    break;
                                case MatPaper.Data.TaskRunState.Cancelled:
                                    <span class="mat-pill mat-pill--warn">@L["Cancelled"]</span>
                                    break;
                                default:
                                    <span class="mat-pill mat-pill--busy">@L["Running"]</span>
                                    break;
                            }
                            <small class="mat-muted">@Fmt.DateTime(t.LastRunStartedAt)</small>
                        }
                    </td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <form method="post" action="/System/ExportTasks/Edit?id=@t.Id&handler=Run" class="mp-contents">
                                @Html.AntiForgeryToken()
                                <mp-icon-button icon="play" label='@L["Run now"]' type="submit" />
                            </form>
                            <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/System/ExportTasks/Edit?id={t.Id}")' />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mp-table>

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />

    <div class="mat-actions">
        <mp-button variant="primary" href="/System/ExportTasks/Edit" icon="plus">@L["New export task"]</mp-button>
    </div>
</div>
