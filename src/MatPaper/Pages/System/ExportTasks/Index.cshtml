@page "/System/ExportTasks"
@model MatPaper.Pages.System.ExportTasks.IndexModel
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = "System / Export tasks";
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder="Name" />
</mp-toolbar>

<mp-table item-count="Model.Rows.Count" empty-text="No export tasks match your criteria.">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Enabled</th>
            <th>Schedule</th>
            <th>Last run</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Rows)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.Type</td>
                <td>
                    @if (t.IsEnabled)
                    {
                        <span class="badge badge--ok">Enabled</span>
                    }
                    else
                    {
                        <span class="badge badge--off">Disabled</span>
                    }
                </td>
                <td>
                    @{ var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone); }
                    <span class="@(sched.IsValid ? "" : "badge badge--off")">@sched.Text</span>
                    @if (sched.NextUtc is DateTime nextUtc)
                    {
                        <br /><span class="form-help" style="margin:0">next: @Fmt.DateTime(nextUtc)</span>
                    }
                </td>
                <td>
                    @if (t.LastRunState is null)
                    {
                        <span class="badge badge--muted">Never</span>
                    }
                    else
                    {
                        @switch (t.LastRunState)
                        {
                            case MatPaper.Data.TaskRunState.Success:
                                <span class="badge badge--ok">Success</span>
                                break;
                            case MatPaper.Data.TaskRunState.Failed:
                                <span class="badge badge--off">Failed</span>
                                break;
                            default:
                                <span class="badge badge--muted">Running</span>
                                break;
                        }
                        <span>&nbsp;@Fmt.DateTime(t.LastRunStartedAt)</span>
                    }
                </td>
                <td class="is-actions">
                    <a href="/System/ExportTasks/Edit?id=@t.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/System/ExportTasks/Edit">New export task</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
