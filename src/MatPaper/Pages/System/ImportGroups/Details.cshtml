@page "/System/ImportGroups/Details"
@model MatPaper.Pages.System.ImportGroups.DetailsModel
@using MatPaper.Data
@using MatPaper.Services
@{
    var g = Model.Group;
    var sched = CronSchedule.Describe(g.CronExpression, Fmt.TimeZone);
    ViewData["Heading"] = g.Name;
    ViewData["Title"] = g.Name;

    string TypeLabel(ImportTaskType type) => type switch
    {
        ImportTaskType.Imap => "IMAP",
        ImportTaskType.Pop3 => "POP3",
        ImportTaskType.Smb => L["SMB share"].Value,
        _ => L["Watched folder"].Value
    };
}

<div class="mat-stack">
    <div class="mat-card">
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>@L["Group"]</dt>
                <dd>
                    @if (g.IsEnabled) { <span class="mat-pill mat-pill--ok">@L["Enabled"]</span> }
                    else { <span class="mat-pill mat-pill--warn">@L["Disabled"]</span> }
                </dd>
                <dt>@L["Schedule"]</dt>
                <dd>
                    <span class="@(sched.IsValid ? "" : "mat-pill mat-pill--warn")">@sched.Text</span>
                    @if (sched.NextUtc is DateTime nextUtc && g.IsEnabled)
                    {
                        <small class="mat-muted"> · @L["next:"] @Fmt.DateTime(nextUtc)</small>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <partial name="_TaskRunsPanel" model="Model.Runs" />

    <div class="mat-grid">
        @if (Model.Source.Count > 0)
        {
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@L["Source of all rules"]</h2></div>
                <div class="mat-card__body">
                    <dl class="mat-kv">
                        @foreach (var (label, value) in Model.Source)
                        {
                            <dt>@label</dt>
                            <dd>@value</dd>
                        }
                    </dl>
                </div>
            </div>
        }
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Target of all rules"]</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var (label, value) in Model.Target)
                    {
                        <dt>@label</dt>
                        <dd>@value</dd>
                    }
                </dl>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__head">
                <h2 class="mat-card__title">@L["Rules"]</h2>
                <span class="mat-pill mat-pill--plain">@Model.Members.Count</span>
            </div>
            <div class="mat-card__body">
                @if (Model.Members.Count == 0)
                {
                    <p class="mat-muted">@L["No rules in this group yet."]</p>
                }
                else
                {
                    <dl class="mat-kv">
                        @for (var i = 0; i < Model.Members.Count; i++)
                        {
                            var m = Model.Members[i];
                            <dt>@(i + 1)</dt>
                            <dd>
                                <a href="/System/ImportTasks/Details?id=@m.Id">@m.Name</a>
                                <small class="mat-muted">@TypeLabel(m.Type)</small>
                                @if (!m.IsEnabled) { <span class="mat-pill mat-pill--warn">@L["Disabled"]</span> }
                            </dd>
                        }
                    </dl>
                }
            </div>
        </div>
    </div>

    <div class="mat-card" data-live="docs">
        <div class="mat-card__head">
            <h2 class="mat-card__title">@L["Imported documents"]</h2>
            <span class="mat-pill mat-pill--plain">@Model.DocumentCount</span>
        </div>
        @if (Model.Documents.Count == 0)
        {
            <div class="mat-card__body"><p class="mat-muted">@L["Nothing imported by this task yet."]</p></div>
        }
        else
        {
            <ul class="mat-listgroup mat-listgroup--flush mp-docs">
                @foreach (var d in Model.Documents)
                {
                    <li class="mat-listgroup__item">
                        <a class="mp-thumb" href="/Documents/Edit?id=@d.Id" tabindex="-1" aria-hidden="true">
                            @if (d.HasThumbnail)
                            {
                                <img src="/Documents/@d.Token/thumb" loading="lazy" alt="" />
                            }
                            else
                            {
                                <mp-icon name="file-text" />
                            }
                        </a>
                        <span class="mat-listgroup__text"><a href="/Documents/Edit?id=@d.Id">@d.Title</a><small>@d.FileName</small></span>
                        <span class="mp-when">
                            <small class="mat-muted">@Fmt.DateTime(d.Imported)</small>
                            @if (d.IsStaged || d.Review == ReviewState.Pending)
                            {
                                <span class="mat-pill mat-pill--warn">@L["Inbox"]</span>
                            }
                        </span>
                    </li>
                }
            </ul>
            @if (Model.DocumentCount > Model.Documents.Count)
            {
                <div class="mat-card__foot"><small class="mat-muted">@L["The latest {0} of {1} are shown.", Model.Documents.Count, Model.DocumentCount]</small></div>
            }
        }
    </div>

    @if (Model.LastRun is { } last && (!string.IsNullOrWhiteSpace(last.Log) || Model.Runs.IsRunning))
    {
        <div class="mat-card" data-live="log">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Log of the latest run"]</h2></div>
            <div class="mat-card__body mat-stack">
                <pre class="mat-code mp-log">@last.Log</pre>
                <a href="/System/TaskRuns/Details?id=@last.Id">@Fmt.DateTimeSeconds(last.StartedAt)</a>
            </div>
        </div>
    }

    <mp-button-row>
        <mp-button variant="primary" href="@($"/System/ImportGroups/Edit?id={g.Id}")" icon="edit">@L["Edit"]</mp-button>
        <mp-button variant="secondary" href="/System/ImportTasks" icon="back">@L["Back"]</mp-button>
    </mp-button-row>
</div>
