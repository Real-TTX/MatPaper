@page "/System/ImportGroups/Details"
@model MatPaper.Pages.System.ImportGroups.DetailsModel
@using MatPaper.Data
@using MatPaper.Services
@{
    var g = Model.Group;
    var sched = CronSchedule.Describe(g.CronExpression, Fmt.TimeZone);

    string TypeLabel(ImportTaskType type) => type switch
    {
        ImportTaskType.Imap => "IMAP",
        ImportTaskType.Pop3 => "POP3",
        ImportTaskType.Smb => L["SMB share"].Value,
        _ => L["Watched folder"].Value
    };
}

<div class="task-head">
    <div class="task-head__main">
        <h2 class="task-head__title">@g.Name</h2>
        <div class="task-head__meta">
            <span class="badge badge--muted">@L["Group"]</span>
            @if (g.IsEnabled)
            {
                <span class="badge badge--ok">@L["Enabled"]</span>
            }
            else
            {
                <span class="badge badge--warn">@L["Disabled"]</span>
            }
            <span class="@(sched.IsValid ? "" : "badge badge--warn")">@sched.Text</span>
            @if (sched.NextUtc is DateTime nextUtc && g.IsEnabled)
            {
                <span class="form-help" style="margin:0">@L["next:"] @Fmt.DateTime(nextUtc)</span>
            }
        </div>
    </div>
    <div class="task-head__actions">
        <a class="btn btn--secondary" href="/System/ImportGroups/Edit?id=@g.Id">@L["Edit"]</a>
        <a class="btn btn--secondary" href="/System/ImportTasks">@L["Back"]</a>
    </div>
</div>

<partial name="_TaskRunsPanel" model="Model.Runs" />

<div class="task-grid">
    <section class="task-card">
        <h3>@L["Target of all rules"]</h3>
        <dl class="task-facts">
            @foreach (var (label, value) in Model.Target)
            {
                <dt>@label</dt>
                <dd>@value</dd>
            }
        </dl>
    </section>
    <section class="task-card">
        <h3>@L["Rules"] <span class="task-card__count">@Model.Members.Count</span></h3>
        @if (Model.Members.Count == 0)
        {
            <p class="form-help">@L["No rules in this group yet."]</p>
        }
        else
        {
            <dl class="task-facts">
                @for (var i = 0; i < Model.Members.Count; i++)
                {
                    var m = Model.Members[i];
                    <dt>@(i + 1)</dt>
                    <dd>
                        <a href="/System/ImportTasks/Details?id=@m.Id">@m.Name</a>
                        <span class="form-help" style="margin:0">@TypeLabel(m.Type)</span>
                        @if (!m.IsEnabled) { <span class="badge badge--warn">@L["Disabled"]</span> }
                    </dd>
                }
            </dl>
        }
    </section>
</div>

<section class="task-card task-card--wide" data-live="docs">
    <h3>
        @L["Imported documents"]
        <span class="task-card__count">@Model.DocumentCount</span>
    </h3>
    @if (Model.Documents.Count == 0)
    {
        <p class="form-help">@L["Nothing imported by this task yet."]</p>
    }
    else
    {
        <ul class="task-docs">
            @foreach (var d in Model.Documents)
            {
                <li class="task-docs__item">
                    <a class="task-docs__thumb" href="/Documents/Edit?id=@d.Id" tabindex="-1" aria-hidden="true">
                        @if (d.HasThumbnail)
                        {
                            <img src="/Documents/@d.Token/thumb" loading="lazy" alt="" />
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" /></svg>
                        }
                    </a>
                    <div class="task-docs__text">
                        <a href="/Documents/Edit?id=@d.Id">@d.Title</a>
                        <span class="form-help" style="margin:0">@d.FileName</span>
                    </div>
                    <div class="task-docs__when">
                        <span>@Fmt.DateTime(d.Imported)</span>
                        @if (d.IsStaged || d.Review == ReviewState.Pending)
                        {
                            <span class="badge badge--warn">@L["Inbox"]</span>
                        }
                    </div>
                </li>
            }
        </ul>
        @if (Model.DocumentCount > Model.Documents.Count)
        {
            <p class="form-help">@L["The latest {0} of {1} are shown.", Model.Documents.Count, Model.DocumentCount]</p>
        }
    }
</section>

@if (Model.LastRun is { } last && (!string.IsNullOrWhiteSpace(last.Log) || Model.Runs.IsRunning))
{
    <section class="task-card task-card--wide" data-live="log">
        <h3>@L["Log of the latest run"]</h3>
        <pre class="task-log">@last.Log</pre>
        <p class="runs-panel__more"><a href="/System/TaskRuns/Details?id=@last.Id">@Fmt.DateTimeSeconds(last.StartedAt)</a></p>
    </section>
}
