@page "/System/ImportGroups/Edit"
@model MatPaper.Pages.System.ImportGroups.EditModel
@using MatPaper.Data
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["System / Import tasks / Group"].Value : L["System / Import tasks / New group"].Value;
    ViewData["Heading"] = Model.IsEdit ? Model.Input.Name : L["New group"].Value;
    ViewData["Width"] = "narrow";
}

<div data-tabs class="mat-stack">
    <div class="mat-tabs" role="tablist" aria-label='@L["Group"]'>
        <button type="button" class="mat-tab" role="tab" id="grp-tab-general" aria-controls="grp-panel-general" aria-selected="true">@L["General"]</button>
        <button type="button" class="mat-tab" role="tab" id="grp-tab-source" aria-controls="grp-panel-source" aria-selected="false" tabindex="-1">@L["Source"]</button>
        <button type="button" class="mat-tab" role="tab" id="grp-tab-target" aria-controls="grp-panel-target" aria-selected="false" tabindex="-1">@L["Target"]</button>
        @if (Model.IsEdit)
        {
            <button type="button" class="mat-tab" role="tab" id="grp-tab-rules" aria-controls="grp-panel-rules" aria-selected="false" tabindex="-1">@L["Rules"] <span class="mat-badge mat-badge--soft">@Model.Members.Count</span></button>
        }
    </div>

    <form method="post" class="mat-form" novalidate
          data-browse-url="/System/ImportGroups/Edit?handler=Browse"
          data-t-loading='@L["Loading…"]' data-t-empty='@L["Nothing found."]'
          data-t-folders='@L["Folders"]' data-t-shares='@L["Shares"]' data-t-up='@L["One level up"]'
          data-t-showing='@L["showing the first {0}"]' data-t-more='@L["scan stopped at {0} — there may be more"]'
          data-t-show-more='@L["Show more"]' data-t-request-failed='@L["The request failed — please reload the page."]'>
        <input type="hidden" asp-for="Id" />
        <partial name="_ValidationSummary" />

        <div class="mat-tabpanel" role="tabpanel" id="grp-panel-general" aria-labelledby="grp-tab-general">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@L["Group"]</h2></div>
                <div class="mat-card__body">
                    <div class="mat-form__grid">
                        <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Invoices"]' full="true" />
                        <mp-field asp-for="Input.IsEnabled" kind="switch" label='@L["Enabled"]' full="true" />
                        <div class="mat-field--full"><mp-schedule asp-for="Input.CronExpression" label='@L["Schedule"]' /></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mat-tabpanel" role="tabpanel" id="grp-panel-source" aria-labelledby="grp-tab-source" hidden>
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@L["Source of all rules"]</h2></div>
                <div class="mat-card__body mat-stack">
                    <p class="mat-muted">@L["One connection and one folder for the whole group: the rules only say what to pick up. A mailbox is opened once per run for all rules."]</p>
                    <div class="mat-form__grid">
                        <mp-field asp-for="Input.SourceType" kind="select" label='@L["Type"]' asp-items="Model.SourceTypeOptions" full="true" />

                        <div class="mat-form__grid mat-field--full" data-show-if="Input.SourceType" data-show-value="0,1">
                            <mp-picker asp-for="Input.MailConnectionId" label='@L["Saved connection"]' asp-items="Model.MailConnectionOptions" placeholder='@L["— Choose —"]' create="false" />
                        </div>
                        <div class="mat-form__grid mat-field--full" data-show-if="Input.SourceType" data-show-value="0">
                            <mp-field asp-for="Input.MailFolder" label='@L["Mailbox folder"]' placeholder="INBOX" full="true"
                                      browse="mail-folders" browse-label='@L["Show folders…"]' />
                        </div>

                        <div class="mat-form__grid mat-field--full" data-show-if="Input.SourceType" data-show-value="3">
                            <mp-picker asp-for="Input.SmbConnectionId" label='@L["Saved connection"]' asp-items="Model.SmbConnectionOptions" placeholder='@L["— Choose —"]' create="false" />
                            <mp-field asp-for="Input.SourceShare" label='@L["SMB share"]' placeholder="documents"
                                      browse="smb-shares" browse-label='@L["List shares"]' />
                        </div>

                        <div class="mat-form__grid mat-field--full" data-show-if="Input.SourceType" data-show-value="2">
                            <mp-field asp-for="Input.SourcePath" label='@L["Folder"]' placeholder="/mnt/scan" full="true" mono="true"
                                      browse="local-folders" browse-root="/" browse-label='@L["Browse…"]' />
                        </div>
                        <div class="mat-form__grid mat-field--full" data-show-if="Input.SourceType" data-show-value="3">
                            <mp-field asp-for="Input.SourcePath" control-id="Input_SourcePath_smb" label='@L["Folder"]' placeholder="/mnt/scan" full="true" mono="true"
                                      browse="smb-folders" browse-label='@L["Browse…"]' />
                        </div>
                    </div>
                    <div data-show-if="Input.SourceType" data-show-value="0,1,2,3">
                        <mp-button variant="secondary" handler="Test" icon="plug">@L["Test connection"]</mp-button>
                    </div>
                </div>
            </div>
        </div>

        <div class="mat-tabpanel" role="tabpanel" id="grp-panel-target" aria-labelledby="grp-tab-target" hidden>
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@L["Target of all rules"]</h2></div>
                <div class="mat-card__body mat-stack">
                    <p class="mat-muted">@L["What a rule leaves empty it takes from here. Switches and tags are added to the rule's own."]</p>
                    <div class="mat-form__grid">
                        <mp-picker asp-for="Input.StorageLocationId" label='@L["Storage location"]' asp-items="Model.StorageLocationOptions" placeholder='@L["— default —"]' />
                        <mp-picker asp-for="Input.OwnerUserId" label='@L["Inbox of"]' asp-items="Model.UserOptions" placeholder='@L["— Task creator —"]' />
                        <mp-picker asp-for="Input.ProjectId" label='@L["Project"]' asp-items="Model.ProjectOptions" placeholder='@L["— None —"]' />
                        <mp-picker asp-for="TagIds" label='@L["Tags"]' asp-items="Model.TagOptions" multiple="true" placeholder='@L["Add tags…"]' />
                        <mp-field asp-for="Input.IsCommon" kind="switch" label='@L["Common area (visible to everyone)"]' full="true" />
                        <mp-field asp-for="Input.SkipInbox" kind="switch" label='@L["Skip inbox (mark imported documents as reviewed)"]' full="true" />
                    </div>
                </div>
            </div>
        </div>

        <mp-button-row>
            <mp-button variant="primary" icon="save">@L["Save"]</mp-button>
            <mp-button variant="secondary" href="@(Model.IsEdit ? "/System/ImportGroups/Details?id=" + Model.Id : "/System/ImportTasks")" icon="back">@L["Back"]</mp-button>
            @if (Model.IsEdit)
            {
                <mp-button-spacer />
                <mp-button variant="danger" icon="trash" handler="Delete"
                           confirm='@L["Delete this group? Its rules stay as single rules."]' confirm-ok='@L["Delete"]'>@L["Delete"]</mp-button>
            }
        </mp-button-row>
    </form>

    @if (Model.IsEdit)
    {
        <div class="mat-tabpanel" role="tabpanel" id="grp-panel-rules" aria-labelledby="grp-tab-rules" hidden>
            <div class="mat-card">
                <div class="mat-card__head">
                    <h2 class="mat-card__title">@L["Rules"]</h2>
                    <span class="mat-pill mat-pill--plain">@Model.Members.Count</span>
                </div>
                <div class="mat-card__body mat-stack">
                    <p class="mat-muted">@L["They run from top to bottom. What a rule above takes, the ones below leave alone."]</p>

                    @if (Model.Members.Count == 0)
                    {
                        <p class="mat-muted">@L["No rules in this group yet."]</p>
                    }
                    else
                    {
                        <mp-table item-count="Model.Members.Count" caption='@L["Rules"]'>
                            <thead>
                                <tr><th scope="col" class="mat-num">#</th><th scope="col">@L["Name"]</th><th scope="col">@L["Last run"]</th><th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th></tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Members.Count; i++)
                                {
                                    var m = Model.Members[i];
                                    <tr>
                                        <td class="mat-num mat-mono">@(i + 1)</td>
                                        <td>
                                            <div class="mat-table__name">
                                                <a href="/System/ImportTasks/Details?id=@m.Id">@m.Name</a>
                                                @if (!m.IsEnabled) { <span class="mat-pill mat-pill--warn">@L["Disabled"]</span> }
                                            </div>
                                        </td>
                                        <td>
                                            @if (m.LastState is TaskRunState state && m.LastStartedAt is DateTime started)
                                            {
                                                <span class="mat-pill @(state == TaskRunState.Success ? "mat-pill--ok" : state == TaskRunState.Failed ? "mat-pill--error" : "mat-pill--busy")">@(state == TaskRunState.Success ? L["Success"].Value : state == TaskRunState.Failed ? L["Failed"].Value : state == TaskRunState.Cancelled ? L["Cancelled"].Value : L["Running"].Value)</span>
                                                <small class="mat-muted">@Fmt.DateTime(started)</small>
                                            }
                                            else { <span class="mat-muted">—</span> }
                                        </td>
                                        <td class="mat-table__cell-actions">
                                            <div class="mat-table__actions">
                                                <form method="post" asp-page-handler="Move" asp-route-id="@Model.Id" asp-route-ruleId="@m.Id" asp-route-delta="-1" class="mp-contents">
                                                    <mp-icon-button icon="arrow-up" label='@L["Move up"]' type="submit" disabled="@(i == 0)" />
                                                </form>
                                                <form method="post" asp-page-handler="Move" asp-route-id="@Model.Id" asp-route-ruleId="@m.Id" asp-route-delta="1" class="mp-contents">
                                                    <mp-icon-button icon="arrow-down" label='@L["Move down"]' type="submit" disabled="@(i == Model.Members.Count - 1)" />
                                                </form>
                                                <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/System/ImportTasks/Edit?id={m.Id}")' />
                                                <form method="post" asp-page-handler="Remove" asp-route-id="@Model.Id" asp-route-ruleId="@m.Id" class="mp-contents">
                                                    <mp-icon-button icon="x" label='@L["Take out of the group"]' type="submit" confirm='@($"{L["Take out of the group"]}: {m.Name}?")' confirm-ok='@L["Take out of the group"]' />
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </mp-table>
                    }

                    <div class="mat-actions">
                        <mp-button variant="primary" href="@($"/System/ImportTasks/Edit?group={Model.Id}")" icon="plus">@L["New rule in this group"]</mp-button>
                        @if (Model.SingleRules.Count > 0)
                        {
                            <form method="post" asp-page-handler="Add" asp-route-id="@Model.Id" class="mat-form mat-form--inline">
                                <div class="mat-field">
                                    <label class="mat-label mat-sr-only" for="grp-add-rule">@L["Add an existing rule"]</label>
                                    <select class="mat-select" id="grp-add-rule" name="ruleId">
                                        @foreach (var r in Model.SingleRules)
                                        {
                                            <option value="@r.Id">@r.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="mat-field mat-field--auto"><mp-button variant="secondary" icon="plus">@L["Add an existing rule"]</mp-button></div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<partial name="_BrowseDialog" />

@section Scripts {
    <script src="~/js/browse-dialog.js" asp-append-version="true"></script>
}
