@page "/System/ImportGroups/Edit"
@model MatPaper.Pages.System.ImportGroups.EditModel
@using MatPaper.Data
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["System / Import tasks / Group"].Value : L["System / Import tasks / New group"].Value;
}

<div data-tabs class="is-booting">
<div class="tabs__bar" role="tablist">
    <button type="button" class="tabs__tab" data-tab="general" role="tab"><span class="wizard__num">1</span>@L["General"]</button>
    <button type="button" class="tabs__tab" data-tab="source" role="tab"><span class="wizard__num">2</span>@L["Source"]</button>
    <button type="button" class="tabs__tab" data-tab="target" role="tab"><span class="wizard__num">3</span>@L["Target"]</button>
    @if (Model.IsEdit)
    {
        <button type="button" class="tabs__tab" data-tab="rules" role="tab"><span class="wizard__num">4</span>@L["Rules"] <span class="task-card__count">@Model.Members.Count</span></button>
    }
</div>

<form class="form form--wide" method="post"
      data-browse-url="/System/ImportGroups/Edit?handler=Browse"
      data-t-loading='@L["Loading…"]' data-t-empty='@L["Nothing found."]'
      data-t-folders='@L["Folders"]' data-t-shares='@L["Shares"]' data-t-up='@L["One level up"]'
      data-t-showing='@L["showing the first {0}"]' data-t-more='@L["scan stopped at {0} — there may be more"]'
      data-t-show-more='@L["Show more"]' data-t-request-failed='@L["The request failed — please reload the page."]'>
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <section class="form-section tabs__panel" data-tab-panel="general">
        <h2 class="form-section__title">@L["Group"]</h2>
        <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Invoices"]' />
        <mp-field asp-for="Input.IsEnabled" kind="checkbox" label='@L["Enabled"]' />
        <mp-schedule asp-for="Input.CronExpression" label='@L["Schedule"]' />
    </section>

    <section class="form-section tabs__panel" data-tab-panel="source" hidden>
        <h2 class="form-section__title">@L["Source of all rules"]</h2>
        <p class="form-help">@L["One connection and one folder for the whole group: the rules only say what to pick up. A mailbox is opened once per run for all rules."]</p>
        <mp-field asp-for="Input.SourceType" kind="select" label='@L["Type"]' asp-items="Model.SourceTypeOptions" />

        <div data-show-when-field="Input.SourceType" data-show-when-value="0,1">
            <mp-picker asp-for="Input.MailConnectionId" label='@L["Saved connection"]' asp-items="Model.MailConnectionOptions" placeholder='@L["— Choose —"]' create="false" />
        </div>
        <div data-show-when-field="Input.SourceType" data-show-when-value="0">
            <div class="form-row">
                <label asp-for="Input.MailFolder">@L["Mailbox folder"]</label>
                <div class="input-with-action">
                    <input class="form-control" asp-for="Input.MailFolder" placeholder="INBOX" />
                    <button class="btn btn--secondary" type="button" data-browse="mail-folders"
                            data-browse-target="Input_MailFolder" data-browse-flat>@L["Show folders…"]</button>
                </div>
            </div>
        </div>

        <div data-show-when-field="Input.SourceType" data-show-when-value="3">
            <mp-picker asp-for="Input.SmbConnectionId" label='@L["Saved connection"]' asp-items="Model.SmbConnectionOptions" placeholder='@L["— Choose —"]' create="false" />
            <div class="form-row">
                <label asp-for="Input.SourceShare">@L["SMB share"]</label>
                <div class="input-with-action">
                    <input class="form-control" asp-for="Input.SourceShare" placeholder="documents" />
                    <button class="btn btn--secondary" type="button" data-browse="smb-shares"
                            data-browse-target="Input_SourceShare" data-browse-flat data-browse-title='@L["Shares"]'>@L["List shares"]</button>
                </div>
                <span class="field-error" asp-validation-for="Input.SourceShare"></span>
            </div>
        </div>

        <div data-show-when-field="Input.SourceType" data-show-when-value="2,3">
            <div class="form-row">
                <label asp-for="Input.SourcePath">@L["Folder"]</label>
                <div class="input-with-action">
                    <input class="form-control" asp-for="Input.SourcePath" placeholder="/mnt/scan" />
                    <span data-show-when-field="Input.SourceType" data-show-when-value="2">
                        <button class="btn btn--secondary" type="button" data-browse="local-folders"
                                data-browse-target="Input_SourcePath" data-browse-root="/">@L["Browse…"]</button>
                    </span>
                    <span data-show-when-field="Input.SourceType" data-show-when-value="3">
                        <button class="btn btn--secondary" type="button" data-browse="smb-folders"
                                data-browse-target="Input_SourcePath">@L["Browse…"]</button>
                    </span>
                </div>
                <span class="field-error" asp-validation-for="Input.SourcePath"></span>
            </div>
        </div>

        <div data-show-when-field="Input.SourceType" data-show-when-value="0,1,2,3">
            <mp-button-row>
                <mp-button variant="secondary" type="submit" handler="Test">@L["Test connection"]</mp-button>
            </mp-button-row>
        </div>
    </section>

    <section class="form-section tabs__panel" data-tab-panel="target" hidden>
        <h2 class="form-section__title">@L["Target of all rules"]</h2>
        <p class="form-help">@L["What a rule leaves empty it takes from here. Switches and tags are added to the rule's own."]</p>
        <mp-picker asp-for="Input.StorageLocationId" label='@L["Storage location"]' asp-items="Model.StorageLocationOptions" placeholder='@L["— default —"]' />
        <mp-picker asp-for="Input.OwnerUserId" label='@L["Inbox of"]' asp-items="Model.UserOptions" placeholder='@L["— Task creator —"]' />
        <mp-picker asp-for="Input.ProjectId" label='@L["Project"]' asp-items="Model.ProjectOptions" placeholder='@L["— None —"]' />
        <mp-picker asp-for="TagIds" label='@L["Tags"]' asp-items="Model.TagOptions" multiple="true" placeholder='@L["Add tags…"]' />
        <mp-field asp-for="Input.IsCommon" kind="checkbox" label='@L["Common area (visible to everyone)"]' />
        <mp-field asp-for="Input.SkipInbox" kind="checkbox" label='@L["Skip inbox (mark imported documents as reviewed)"]' />
    </section>

    <mp-button-row>
        <mp-button variant="primary" type="submit">@L["Save"]</mp-button>
        <mp-button variant="secondary" href="@(Model.IsEdit ? "/System/ImportGroups/Details?id=" + Model.Id : "/System/ImportTasks")">@L["Back"]</mp-button>
        <mp-button-spacer />
        @if (Model.IsEdit)
        {
            <mp-button variant="danger" type="submit" handler="Delete"
                       confirm='@L["Delete this group? Its rules stay as single rules."]'>@L["Delete"]</mp-button>
        }
    </mp-button-row>
</form>

@if (Model.IsEdit)
{
    <section class="task-card task-card--wide tabs__panel" data-tab-panel="rules" hidden>
        <h3>@L["Rules"] <span class="task-card__count">@Model.Members.Count</span></h3>
        <p class="form-help">@L["They run from top to bottom. What a rule above takes, the ones below leave alone."]</p>

        @if (Model.Members.Count == 0)
        {
            <p class="form-help">@L["No rules in this group yet."]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table group-rules">
                    <thead><tr><th>#</th><th>@L["Name"]</th><th>@L["Last run"]</th><th class="is-actions"></th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < Model.Members.Count; i++)
                        {
                            var m = Model.Members[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <a href="/System/ImportTasks/Details?id=@m.Id">@m.Name</a>
                                    @if (!m.IsEnabled) { <span class="badge badge--warn">@L["Disabled"]</span> }
                                </td>
                                <td>
                                    @if (m.LastState is TaskRunState state && m.LastStartedAt is DateTime started)
                                    {
                                        <span class="badge @(state == TaskRunState.Success ? "badge--ok" : state == TaskRunState.Failed ? "badge--off" : "badge--muted")">@state</span>
                                        <span>&nbsp;@Fmt.DateTime(started)</span>
                                    }
                                    else { <span>—</span> }
                                </td>
                                <td class="is-actions group-rules__actions">
                                    <form method="post" asp-page-handler="Move" asp-route-id="@Model.Id" asp-route-ruleId="@m.Id" asp-route-delta="-1" style="display:inline">
                                        <button class="icon-btn" type="submit" title='@L["Move up"]' aria-label='@L["Move up"]' disabled="@(i == 0)">▲</button>
                                    </form>
                                    <form method="post" asp-page-handler="Move" asp-route-id="@Model.Id" asp-route-ruleId="@m.Id" asp-route-delta="1" style="display:inline">
                                        <button class="icon-btn" type="submit" title='@L["Move down"]' aria-label='@L["Move down"]' disabled="@(i == Model.Members.Count - 1)">▼</button>
                                    </form>
                                    <a class="icon-btn" href="/System/ImportTasks/Edit?id=@m.Id" title='@L["Edit"]' aria-label='@L["Edit"]'>✎</a>
                                    <form method="post" asp-page-handler="Remove" asp-route-id="@Model.Id" asp-route-ruleId="@m.Id" style="display:inline">
                                        <button class="icon-btn" type="submit" title='@L["Take out of the group"]' aria-label='@L["Take out of the group"]'>✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="group-add">
            <a class="btn btn--primary" href="/System/ImportTasks/Edit?group=@Model.Id">@L["New rule in this group"]</a>
            @if (Model.SingleRules.Count > 0)
            {
                <form method="post" asp-page-handler="Add" asp-route-id="@Model.Id" class="group-add__existing">
                    <select class="form-control" name="ruleId" aria-label='@L["Add an existing rule"]'>
                        @foreach (var r in Model.SingleRules)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                    <button class="btn btn--secondary" type="submit">@L["Add an existing rule"]</button>
                </form>
            }
        </div>
    </section>
}
</div>

<partial name="_BrowseDialog" />

@section Scripts {
    <script src="~/js/browse-dialog.js" asp-append-version="true"></script>
    <script src="~/js/tabs.js" asp-append-version="true"></script>
}
