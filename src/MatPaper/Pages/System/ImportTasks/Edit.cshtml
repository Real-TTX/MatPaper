@page "/System/ImportTasks/Edit"
@model MatPaper.Pages.System.ImportTasks.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? L["System / Import tasks / Edit"].Value : L["System / Import tasks / New"].Value;
    ViewData["Title"] = Model.IsEdit ? Model.Input.Name : null;
    ViewData["Heading"] = Model.IsEdit ? Model.Input.Name : L["New import task"].Value;
    ViewData["Width"] = "narrow";
    var inGroup = Model.Input.GroupId is not null;
    var hasGroups = Model.GroupOptions.Any(o => o.Value != string.Empty);
}

@* The wizard walks through assignment → type → connection → credentials → source → rules → preview → filing. Steps that do not apply to the chosen type
   hide themselves (see import-wizard.js); everything stays one form, so Save works from anywhere. *@
<form class="mat-form mp-wizard is-booting" id="import-wizard" method="post" data-mode="wizard" novalidate
      data-group-sources='@Html.Raw(global::System.Text.Json.JsonSerializer.Serialize(Model.GroupSources))'
      data-browse-url="/System/ImportTasks/Edit?handler=Browse"
      data-preview-url="/System/ImportTasks/Edit?handler=Preview"
      data-t-loading='@L["Loading…"]' data-t-empty='@L["Nothing found."]'
      data-t-no-match='@L["No items match the current rules."]'
      data-t-matches='@L["{0} match(es)"]' data-t-scanned='@L["{0} scanned"]'
      data-t-folders='@L["Folders"]' data-t-shares='@L["Shares"]'
      data-t-showing='@L["showing the first {0}"]' data-t-more='@L["scan stopped at {0} — there may be more"]'
      data-t-col-subject='@L["Subject"]' data-t-col-from='@L["From"]' data-t-col-date='@L["Date"]' data-t-col-attachments='@L["Attachments"]'
      data-t-col-name='@L["Name"]' data-t-col-path='@L["Path"]' data-t-col-size='@L["Size"]'
      data-t-show-more='@L["Show more"]' data-t-up='@L["One level up"]' data-t-request-failed='@L["The request failed — please reload the page."]'>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_ValidationSummary" />

    @* Enter in a text field must save, not fire the first submit button in the markup. *@
    <button type="submit" class="mat-sr-only" tabindex="-1" aria-hidden="true">@L["Save"]</button>
    <input type="hidden" asp-for="ActiveStep" id="wizard-active-step" />

    <nav class="mat-tabs mat-tabs--pills mp-wizard__steps" id="wizard-steps" aria-label='@L["Steps"]'>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="0"><span class="mp-wizard__num"></span><span>@L["Assignment"]</span></button>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="1"><span class="mp-wizard__num"></span><span>@L["Type"]</span></button>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="2"><span class="mp-wizard__num"></span><span>@L["Connection"]</span></button>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="3"><span class="mp-wizard__num"></span><span>@L["Credentials"]</span></button>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="4"><span class="mp-wizard__num"></span><span>@L["Source"]</span></button>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="5"><span class="mp-wizard__num"></span><span>@L["Rules"]</span></button>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="6"><span class="mp-wizard__num"></span><span>@L["Preview"]</span></button>
        <button type="button" class="mat-tab mp-wizard__step" data-goto="7"><span class="mp-wizard__num"></span><span>@L["Filing"]</span></button>
    </nav>

    @* ---------- 0 Assignment: on its own or in a group ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="0" hidden="@(Model.ActiveStep != 0)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Where does the rule belong?"]</h2></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-choices" id="scope-tiles">
                <label class="mat-choice">
                    <input type="radio" name="rule-scope" value="single" checked="@(!inGroup)" />
                    <mp-icon name="file-text" />
                    <span class="mat-choice__text"><strong>@L["Single rule"]</strong><small>@L["Has its own schedule and target."]</small></span>
                </label>
                <label class="mat-choice">
                    <input type="radio" name="rule-scope" value="group" checked="@inGroup" disabled="@(!hasGroups)" />
                    <mp-icon name="layers" />
                    <span class="mat-choice__text"><strong>@L["In a group"]</strong><small>@(hasGroups ? L["Schedule, order and target come from the group."].Value : L["Create a group first."].Value)</small></span>
                </label>
            </div>
            <div id="group-pick" hidden="@(!inGroup)" data-group-types='@Html.Raw(global::System.Text.Json.JsonSerializer.Serialize(Model.GroupTypes))'>
                <mp-field asp-for="Input.GroupId" kind="select" label='@L["Which group?"]' asp-items="Model.GroupOptions" />
            </div>
        </div>
    </section>

    @* ---------- 1 Type ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="1" hidden="@(Model.ActiveStep != 1)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["What should be imported?"]</h2></div>
        <div class="mat-card__body mat-stack">
            <div id="type-pick">
                <div class="mat-choices">
                    <label class="mat-choice">
                        <input type="radio" asp-for="Input.Type" value="2" />
                        <mp-icon name="folder" />
                        <span class="mat-choice__text"><strong>@L["Watch folder"]</strong><small>@L["A folder inside the container, e.g. a scanner drop."]</small></span>
                    </label>
                    <label class="mat-choice">
                        <input type="radio" asp-for="Input.Type" value="3" />
                        <mp-icon name="server" />
                        <span class="mat-choice__text"><strong>@L["Network share (SMB)"]</strong><small>@L["A NAS share, reached directly over the network."]</small></span>
                    </label>
                    <label class="mat-choice">
                        <input type="radio" asp-for="Input.Type" value="0" />
                        <mp-icon name="mail" />
                        <span class="mat-choice__text"><strong>@L["IMAP mailbox"]</strong><small>@L["Attachments from a mailbox; folders stay on the server."]</small></span>
                    </label>
                    <label class="mat-choice">
                        <input type="radio" asp-for="Input.Type" value="1" />
                        <mp-icon name="mail" />
                        <span class="mat-choice__text"><strong>@L["POP3 mailbox"]</strong><small>@L["Simple mailbox without folders."]</small></span>
                    </label>
                </div>
            </div>
            <p class="mat-muted" id="type-fixed-note" hidden>@L["The group already decides what is imported here."]</p>

            <mp-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Scanner watch folder"]' />
        </div>
    </section>

    @* ---------- 2 Connection ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="2" data-for-type="0,1,3" data-hide-with-source hidden="@(Model.ActiveStep != 2)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Where does it connect to?"]</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="3">
                    <mp-field asp-for="Input.SmbConnectionId" kind="select" label='@L["Saved connection"]' asp-items="Model.SmbConnectionOptions" />
                    <div class="mat-form__grid mat-field--full" data-show-if="Input.SmbConnectionId" data-show-value="">
                        <mp-field asp-for="Input.SmbHost" label='@L["Host"]' placeholder="nas.local" mono="true" />
                    </div>
                </div>

                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="0,1">
                    <mp-field asp-for="Input.MailConnectionId" kind="select" label='@L["Saved connection"]' asp-items="Model.MailConnectionOptions" />
                    <div class="mat-form__grid mat-field--full" data-show-if="Input.MailConnectionId" data-show-value="">
                        <mp-field asp-for="Input.Host" label='@L["Host"]' placeholder="mail.example.com" mono="true" />
                        <mp-field asp-for="Input.Port" kind="number" label='@L["Port"]' inputmode="numeric" />
                        <mp-field asp-for="Input.UseSsl" kind="switch" label='@L["Use SSL"]' full="true" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ---------- 3 Credentials ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="3" data-for-type="0,1,3" data-hide-with-source hidden="@(Model.ActiveStep != 3)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["How does it sign in?"]</h2></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-form__grid">
                @* SMB: manual sign-in only when no saved connection is chosen. *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="3">
                    <div class="mat-form__grid mat-field--full" data-show-if="Input.SmbConnectionId" data-show-value="">
                        <mp-field asp-for="Input.SmbUsername" label='@L["Username"]' autocomplete="off" />
                        <mp-field asp-for="Input.SmbDomain" label='@L["Domain"]' placeholder='@L["Optional"]' />
                        <mp-field asp-for="Input.SmbPassword" kind="password" label='@L["Password"]' autocomplete="new-password"
                                  placeholder='@(Model.IsEdit ? L["Leave blank to keep current"].Value : "")' />
                    </div>
                </div>

                @* Mail: manual sign-in only when no saved connection is chosen. *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="0,1">
                    <div class="mat-form__grid mat-field--full" data-show-if="Input.MailConnectionId" data-show-value="">
                        <mp-field asp-for="Input.Username" label='@L["Username"]' autocomplete="off" />
                        <mp-field asp-for="Input.Password" kind="password" label='@L["Password"]' autocomplete="new-password"
                                  placeholder='@(Model.IsEdit ? L["Leave blank to keep current"].Value : "")' />
                    </div>
                </div>
            </div>

            <div><mp-button variant="secondary" handler="Test" icon="plug">@L["Test connection"]</mp-button></div>
        </div>
    </section>

    @* ---------- 4 Source ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="4" data-hide-with-source hidden="@(Model.ActiveStep != 4)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Which folder should be watched?"]</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                @* Filesystem *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="2">
                    <mp-field asp-for="Input.SourcePath" label='@L["Folder"]' placeholder="/mnt/scan" full="true" mono="true"
                              browse="local-folders" browse-root="/" browse-label='@L["Browse…"]' />
                </div>

                @* SMB *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="3">
                    <mp-field asp-for="Input.SmbShare" label='@L["SMB share"]' placeholder="documents" full="true"
                              browse="smb-shares" browse-label='@L["List shares"]' />
                    <mp-field asp-for="Input.SmbPath" label='@L["Folder in share"]' placeholder="inbox/scans" full="true" mono="true"
                              browse="smb-folders" browse-label='@L["Browse…"]' />
                </div>

                @* IMAP *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="0">
                    <mp-field asp-for="Input.Folder" label='@L["Mailbox folder"]' placeholder="INBOX" full="true"
                              browse="mail-folders" browse-label='@L["Show folders…"]' />
                </div>

                @* POP3 *@
                <div class="mat-field--full" data-show-if="Input.Type" data-show-value="1">
                    <p class="mat-muted">@L["POP3 has no folders — the whole mailbox is checked."]</p>
                </div>
            </div>
        </div>
    </section>

    @* ---------- 5 Rules ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="5" hidden="@(Model.ActiveStep != 5)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["What should be picked up?"]</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                @* Files *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="2">
                    <mp-field asp-for="Input.Pattern" label='@L["File pattern"]' placeholder="*" mono="true" full="true"
                              help='@L["A ZIP archive is opened: the PDFs, images and XML files in it are imported."]' />
                    <mp-field asp-for="Input.Recursive" kind="switch" label='@L["Include subfolders"]' full="true" />
                    <mp-field asp-for="Input.PostAction" kind="select" label='@L["After import"]'>
                        <option value="none">@L["Do nothing"]</option>
                        <option value="delete">@L["Delete"]</option>
                        <option value="move">@L["Move"]</option>
                    </mp-field>
                    <mp-field asp-for="Input.MoveToPath" label='@L["Move to path"]' mono="true"
                              show-when-field="Input.PostAction" show-when-value="move" placeholder="/mnt/scan/done" />
                </div>

                @* SMB *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="3">
                    <mp-field asp-for="Input.SmbPattern" label='@L["File pattern"]' placeholder="*" mono="true" full="true"
                              help='@L["A ZIP archive is opened: the PDFs, images and XML files in it are imported."]' />
                    <mp-field asp-for="Input.SmbRecursive" kind="switch" label='@L["Include subfolders"]' full="true" />
                    <mp-field asp-for="Input.SmbPostAction" kind="select" label='@L["After import"]'>
                        <option value="none">@L["Leave on share"]</option>
                        <option value="delete">@L["Delete"]</option>
                        <option value="move">@L["Move to subfolder"]</option>
                    </mp-field>
                    <mp-field asp-for="Input.SmbMoveToPath" label='@L["Move to subfolder"]' mono="true"
                              show-when-field="Input.SmbPostAction" show-when-value="move" placeholder="imported" />
                </div>

                @* Mail *@
                <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="0,1">
                    <div class="mat-field--full" data-show-if="Input.Type" data-show-value="0">
                        <mp-field asp-for="Input.OnlyUnread" kind="switch" label='@L["Only unread mail"]'
                                  help='@L["The mail server picks the unread ones (UNSEEN), so read mail is not even looked at."]' />
                    </div>
                    <mp-field asp-for="Input.MailFilterMode" kind="select" label='@L["Messages"]' full="true">
                        <option value="all">@L["Import all"]</option>
                        <option value="filter">@L["Filter…"]</option>
                    </mp-field>
                    <div class="mat-form__grid mat-field--full" data-show-if="Input.MailFilterMode" data-show-value="filter">
                        <mp-field asp-for="Input.FromFilter" label='@L["From contains"]' />
                        <mp-field asp-for="Input.ToFilter" label='@L["To contains"]' />
                        <mp-field asp-for="Input.SubjectFilter" label='@L["Subject contains"]' full="true" />
                        <div class="mat-field--full" data-show-if="Input.Type" data-show-value="0">
                            <mp-field asp-for="Input.MailFilterWhere" kind="select" label='@L["Filter on"]'>
                                <option value="auto">@L["Automatic (the server; Gmail: here)"]</option>
                                <option value="server">@L["The mail server (fast, finds whole words on Gmail)"]</option>
                                <option value="local">@L["Here (reads every header, exact but slow)"]</option>
                            </mp-field>
                        </div>
                        <mp-field asp-for="Input.SenderRegex" label='@L["Sender regex (advanced)"]' mono="true" />
                        <mp-field asp-for="Input.SubjectRegex" label='@L["Subject regex (advanced)"]' mono="true" />
                    </div>

                    <mp-field asp-for="Input.AttachmentExtensions" label='@L["Attachment extensions"]' full="true" mono="true"
                              help='@L["A .zip in the list is opened: the documents in it are imported, as far as their type is listed."]' />
                    <div class="mat-btn-group mat-field--full" role="group" aria-label='@L["Presets"]'>
                        <button type="button" class="mat-btn mat-btn--secondary" data-ext-preset=".pdf" aria-pressed="false">@L["PDF only"]</button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-ext-preset=".xml" aria-pressed="false">@L["XML only (e-invoice)"]</button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-ext-preset=".pdf,.xml,.png,.jpg,.jpeg,.tif,.tiff,.zip" aria-pressed="false">@L["All documents"]</button>
                    </div>
                    <mp-field asp-for="Input.ImportBodyAsPdf" kind="switch" label='@L["Also import the mail body as a PDF"]' full="true" />

                    <div class="mat-form__grid mat-field--full" data-show-if="Input.Type" data-show-value="0">
                        <mp-field asp-for="Input.MailMarkSeen" kind="switch" label='@L["Mark as read"]' />
                        <mp-field asp-for="Input.MailMarkFlagged" kind="switch" label='@L["Mark as important (star)"]' />
                    </div>
                    <mp-field asp-for="Input.MailPostAction" kind="select" label='@L["Then"]'>
                        <option value="none">@L["Leave on server"]</option>
                        <option value="move">@L["Move to folder (IMAP only)"]</option>
                        <option value="delete">@L["Delete"]</option>
                    </mp-field>
                    <mp-field asp-for="Input.MailMoveToFolder" label='@L["Move to folder"]' placeholder="Archive/Imported" mono="true"
                              show-when-field="Input.MailPostAction" show-when-value="move"
                              browse="mail-folders" browse-label='@L["Show folders…"]' />
                </div>

                <mp-field asp-for="Input.LookbackMode" kind="select" label='@L["Period"]'>
                    <option value="all">@L["Everything"]</option>
                    <option value="days">@L["Only the last days"]</option>
                    <option value="date">@L["Only from a date on"]</option>
                </mp-field>
                <mp-field asp-for="Input.LookbackDays" kind="number" label='@L["Days"]' inputmode="numeric"
                          show-when-field="Input.LookbackMode" show-when-value="days" />
                <mp-field asp-for="Input.LookbackDate" kind="date" label='@L["From"]'
                          show-when-field="Input.LookbackMode" show-when-value="date" />

                <mp-field asp-for="Input.MaxPerRun" kind="number" label='@L["At most per run"]' inputmode="numeric" full="true"
                          help='@L["0 = no limit. To try a rule out: import 10 now, the next run takes the next 10."]' />
            </div>
        </div>
    </section>

    @* ---------- 6 Preview ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="6" hidden="@(Model.ActiveStep != 6)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["What would be imported right now?"]</h2></div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">@L["A dry run: nothing is imported, moved, deleted or marked as read."]</p>

            <mp-field asp-for="Input.PreviewWindow" kind="select" label='@L["Look at the newest"]'>
                @foreach (var window in MatPaper.Pages.System.ImportTasks.EditModel.PreviewWindows)
                {
                    <option value="@window">@window</option>
                }
            </mp-field>

            <div><mp-button variant="secondary" type="button" id="preview-run" icon="play">@L["Run preview"]</mp-button></div>

            <div class="mp-preview" id="preview-result" hidden></div>
        </div>
    </section>

    @* ---------- 7 Filing ---------- *@
    <section class="mat-card mp-wizard__panel" data-step="7" hidden="@(Model.ActiveStep != 7)">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Where do the documents go?"]</h2></div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted" id="group-target-note" hidden="@(!inGroup)">@L["The target of this rule is set by its group."]</p>
            <div class="mat-form__grid" data-show-if="Input.GroupId" data-show-value="">
                <mp-field asp-for="Input.StorageLocationId" kind="select" label='@L["Storage location"]' asp-items="Model.StorageLocationOptions" />
                <mp-field asp-for="Input.OwnerUserId" kind="select" label='@L["Inbox of"]' asp-items="Model.UserOptions" />
                <mp-field asp-for="Input.IsCommon" kind="switch" label='@L["Common area (visible to everyone)"]' full="true" />
                <mp-field asp-for="Input.SkipInbox" kind="switch" label='@L["Skip inbox (mark imported documents as reviewed)"]' full="true" />
            </div>

            <h3>@L["Preset metadata"]</h3>
            <div class="mat-form__grid">
                <mp-picker asp-for="Input.CorrespondentId" label='@L["Correspondent"]'
                           asp-items="Model.CorrespondentOptions.Where(o => o.Value != string.Empty)" placeholder='@L["— None —"]' />
                <mp-picker asp-for="Input.DocumentTypeId" label='@L["Document type"]'
                           asp-items="Model.DocumentTypeOptions.Where(o => o.Value != string.Empty)" placeholder='@L["— None —"]' />
                <mp-picker asp-for="Input.ProjectId" label='@L["Project"]'
                           asp-items="Model.ProjectOptions.Where(o => o.Value != string.Empty)" placeholder='@L["— None —"]' />
                <mp-picker asp-for="TagIds" label='@L["Tags"]' multiple="true" placeholder='@L["Add tags…"]'
                           asp-items="Model.TagOptions.Select(t => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(t.Name, t.Id.ToString(), t.Selected))"
                           help='@L["Every document this task imports gets these tags."]' />
            </div>

            <h3>@L["When does it run?"]</h3>
            <div class="mat-form__grid">
                <div class="mat-field--full" data-show-if="Input.GroupId" data-show-value="">
                    <mp-schedule asp-for="Input.CronExpression" label='@L["Schedule"]' />
                </div>
                <mp-field asp-for="Input.IsEnabled" kind="switch" label='@L["Enabled"]' full="true" />
            </div>
        </div>
    </section>

    <mp-button-row>
        <mp-button variant="primary" icon="save">@L["Save"]</mp-button>
        <mp-button variant="secondary" type="button" id="wizard-back" icon="chevron-left">@L["Back"]</mp-button>
        <mp-button variant="secondary" type="button" id="wizard-next" icon="chevron-right">@L["Next"]</mp-button>
        <mp-button variant="ghost" href="@(Model.IsEdit ? $"/System/ImportTasks/Details?id={Model.Id}" : "/System/ImportTasks")">@L["Cancel"]</mp-button>
        @if (Model.IsEdit)
        {
            <mp-button-spacer />
            <mp-button variant="danger" icon="trash" handler="Delete"
                       confirm='@L["Delete this import task? This cannot be undone."]' confirm-ok='@L["Delete"]'>@L["Delete"]</mp-button>
        }
    </mp-button-row>
</form>

@* Source picker, filled from the Browse handler. *@
<partial name="_BrowseDialog" />

@section Scripts {
    <script src="~/js/browse-dialog.js" asp-append-version="true"></script>
    <script src="~/js/import-wizard.js" asp-append-version="true"></script>
}

@{
    var quickConnections = new MatPaper.Services.QuickConnectionConfig(new[] { "Input.SmbConnectionId" }, new[] { "Input.MailConnectionId" }, new string[0]);
}
<partial name="_QuickConnection" model="quickConnections" />
