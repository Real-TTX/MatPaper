@page "/System/ImportTasks/Edit"
@model MatPaper.Pages.System.ImportTasks.EditModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? "System / Import tasks / Edit" : "System / Import tasks / New";
}

@if (TempData["TaskMessage"] is string queued && !string.IsNullOrEmpty(queued))
{
    <div class="form-summary">@queued</div>
}

@if (!string.IsNullOrEmpty(Model.Notice))
{
    <div class="form-summary">
        <span class="badge @(Model.NoticeOk ? "badge--ok" : "badge--off")">@(Model.NoticeOk ? "OK" : "Failed")</span>
        @Model.Notice
    </div>
}

<form class="form" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <section class="form-section">
        <h2 class="form-section__title">Overview</h2>

        <mp-field asp-for="Input.Name" label="Name" placeholder="e.g. Scanner watch folder" />

        <mp-field asp-for="Input.Type" kind="select" label="Type">
            <option value="2">Filesystem (watch folder)</option>
            <option value="3">SMB / CIFS network share</option>
            <option value="0">IMAP mailbox</option>
            <option value="1">POP3 mailbox</option>
        </mp-field>

        <mp-field asp-for="Input.IsEnabled" kind="checkbox" label="Enabled" />

        <mp-schedule asp-for="Input.CronExpression" label="Schedule" />
    </section>

    <section class="form-section">
        <h2 class="form-section__title">Source</h2>

        @* --- Filesystem --- *@
        <div data-show-when-field="Input.Type" data-show-when-value="2">
            <mp-field asp-for="Input.SourcePath" label="Source path" placeholder="/mnt/scan" />
            <mp-field asp-for="Input.Pattern" label="Pattern" placeholder="*" />
            <mp-field asp-for="Input.Recursive" kind="checkbox" label="Recursive" />
            <mp-field asp-for="Input.PostAction" kind="select" label="After import">
                <option value="none">Do nothing</option>
                <option value="delete">Delete</option>
                <option value="move">Move</option>
            </mp-field>
            <mp-field asp-for="Input.MoveToPath" label="Move to path"
                      show-when-field="Input.PostAction" show-when-value="move" placeholder="/mnt/scan/done" />
        </div>

        @* --- Saved credential (mail + SMB) --- *@
        <div data-show-when-field="Input.Type" data-show-when-value="0,1,3">
            <mp-field asp-for="Input.CredentialId" kind="select" label="Saved credential"
                      asp-items="Model.CredentialOptions" />
        </div>

        @* --- SMB / CIFS --- *@
        <div data-show-when-field="Input.Type" data-show-when-value="3">
            <mp-field asp-for="Input.SmbHost" label="Host" placeholder="nas.local" />
            <mp-field asp-for="Input.SmbShare" label="Share" placeholder="documents" />
            <mp-field asp-for="Input.SmbPath" label="Path in share" placeholder="inbox/scans" />
            <mp-field asp-for="Input.SmbDomain" label="Domain" />
            <mp-field asp-for="Input.SmbUsername" label="Username" />
            <mp-field asp-for="Input.SmbPassword" kind="password" label="Password" />
            <mp-field asp-for="Input.SmbPattern" label="Pattern" placeholder="*" />
            <mp-field asp-for="Input.SmbRecursive" kind="checkbox" label="Recursive" />
            <mp-field asp-for="Input.SmbPostAction" kind="select" label="After import">
                <option value="none">Leave on share</option>
                <option value="delete">Delete</option>
                <option value="move">Move to subfolder</option>
            </mp-field>
            <mp-field asp-for="Input.SmbMoveToPath" label="Move to subfolder"
                      show-when-field="Input.SmbPostAction" show-when-value="move" placeholder="imported" />
        </div>

        @* --- Mail (IMAP / POP3) --- *@
        <div data-show-when-field="Input.Type" data-show-when-value="0,1">
            <mp-field asp-for="Input.Host" label="Host" placeholder="mail.example.com" />
            <mp-field asp-for="Input.Port" kind="number" label="Port" />
            <mp-field asp-for="Input.UseSsl" kind="checkbox" label="Use SSL" />
            <mp-field asp-for="Input.Username" label="Username" />
            <mp-field asp-for="Input.Password" kind="password" label="Password" />
            <mp-field asp-for="Input.Folder" label="Folder"
                      show-when-field="Input.Type" show-when-value="0" />

            <mp-field asp-for="Input.MailFilterMode" kind="select" label="Messages">
                <option value="all">Import all</option>
                <option value="filter">Filter…</option>
            </mp-field>
            <div data-show-when-field="Input.MailFilterMode" data-show-when-value="filter">
                <mp-field asp-for="Input.FromFilter" label="From contains" />
                <mp-field asp-for="Input.ToFilter" label="To contains" />
                <mp-field asp-for="Input.SubjectFilter" label="Subject contains" />
                <mp-field asp-for="Input.SenderRegex" label="Sender regex (advanced)" />
                <mp-field asp-for="Input.SubjectRegex" label="Subject regex (advanced)" />
            </div>

            <mp-field asp-for="Input.AttachmentExtensions" label="Attachment extensions" />
            <mp-field asp-for="Input.ImportBodyAsPdf" kind="checkbox" label="Also import the mail body as a PDF" />

            <mp-field asp-for="Input.MailPostAction" kind="select" label="After import">
                <option value="markseen">Mark seen (IMAP only)</option>
                <option value="move">Move to folder (IMAP only)</option>
                <option value="delete">Delete</option>
                <option value="none">Leave on server</option>
            </mp-field>
            <mp-field asp-for="Input.MailMoveToFolder" label="Move to folder"
                      show-when-field="Input.MailPostAction" show-when-value="move" placeholder="Archive/Imported" />
        </div>
    </section>

    <section class="form-section">
        <h2 class="form-section__title">Defaults for imported documents</h2>

        <mp-field asp-for="Input.StorageLocationId" kind="select" label="Storage location"
                  asp-items="Model.StorageLocationOptions" />
        <mp-field asp-for="Input.CorrespondentId" kind="select" label="Correspondent"
                  asp-items="Model.CorrespondentOptions" />
        <mp-field asp-for="Input.DocumentTypeId" kind="select" label="Document type"
                  asp-items="Model.DocumentTypeOptions" />
        <mp-field asp-for="Input.ProjectId" kind="select" label="Project"
                  asp-items="Model.ProjectOptions" />

        <mp-field asp-for="Input.SkipInbox" kind="checkbox" label="Skip inbox (mark imported documents as reviewed)" />

        @if (Model.TagOptions.Count > 0)
        {
            <div class="form-row">
                <label>Tags</label>
                <div class="checkbox-group">
                    @foreach (var tag in Model.TagOptions)
                    {
                        <label class="form-check">
                            <input type="checkbox" name="TagIds" value="@tag.Id" checked="@tag.Selected" />
                            <span>@tag.Name</span>
                        </label>
                    }
                </div>
            </div>
        }
    </section>

    <mp-button-row>
        <mp-button variant="primary" type="submit">Save</mp-button>
        <mp-button variant="secondary" href="/System/ImportTasks">Back</mp-button>
        @if (Model.IsEdit)
        {
            <mp-button variant="secondary" type="submit" handler="Run">Run now</mp-button>
        }
        <span data-show-when-field="Input.Type" data-show-when-value="0,1,3">
            <mp-button variant="secondary" type="submit" handler="Test">Test connection</mp-button>
        </span>
        <mp-button-spacer />
        @if (Model.IsEdit)
        {
            <mp-button variant="danger" type="submit" handler="Delete"
                       confirm="Delete this import task? This cannot be undone.">Delete</mp-button>
        }
    </mp-button-row>
</form>

@section Scripts {
    <script>
        // POP3 has no "seen" flag, so hide the "Mark seen" post-action for POP3.
        (function () {
            var type = document.querySelector('[name="Input.Type"]');
            var post = document.querySelector('[name="Input.MailPostAction"]');
            if (!type || !post) { return; }
            var imapOnly = [post.querySelector('option[value="markseen"]'), post.querySelector('option[value="move"]')];
            function sync() {
                var isPop3 = type.value === "1";
                imapOnly.forEach(function (o) { if (o) { o.hidden = isPop3; o.disabled = isPop3; } });
                if (isPop3 && (post.value === "markseen" || post.value === "move")) {
                    post.value = "none";
                    post.dispatchEvent(new Event("change", { bubbles: true }));
                }
            }
            type.addEventListener("change", sync);
            sync();
        })();
    </script>
}
