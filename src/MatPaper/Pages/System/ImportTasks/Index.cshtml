@page "/System/ImportTasks"
@model MatPaper.Pages.System.ImportTasks.IndexModel
@using MatPaper.Data
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = L["System / Import tasks"].Value;

    string TypeLabel(ImportTaskType type) => type switch
    {
        ImportTaskType.Imap => "IMAP",
        ImportTaskType.Pop3 => "POP3",
        ImportTaskType.Smb => L["SMB share"].Value,
        _ => L["Watched folder"].Value
    };

    string StatePill(TaskRunState state) => state switch
    {
        TaskRunState.Success => "mat-pill mat-pill--ok",
        TaskRunState.Failed => "mat-pill mat-pill--error",
        TaskRunState.Cancelled => "mat-pill mat-pill--warn",
        _ => "mat-pill mat-pill--busy"
    };

    string StateText(TaskRunState state) => state switch
    {
        TaskRunState.Success => L["Success"].Value,
        TaskRunState.Failed => L["Failed"].Value,
        TaskRunState.Cancelled => L["Cancelled"].Value,
        _ => L["Running"].Value
    };

    var typeFilter = Enum.TryParse<ImportTaskType>(Model.Type, true, out var chosenType) && Enum.IsDefined(chosenType) ? TypeLabel(chosenType) : null;
    var statusFilter = Model.Status switch { "enabled" => L["Enabled"].Value, "disabled" => L["Disabled"].Value, _ => null };
    var groupFilter = Model.Group == "none"
        ? L["Without group"].Value
        : Model.GroupOptions.FirstOrDefault(o => o.Id.ToString() == Model.Group)?.Name;
    var activeFilters = FilterChipBar.From(ViewContext.HttpContext.Request,
        new FilterSpec("Search", L["Search"].Value, Model.Search),
        new FilterSpec("Type", L["Type"].Value, typeFilter),
        new FilterSpec("Status", L["Status"].Value, statusFilter),
        new FilterSpec("Group", L["Group"].Value, groupFilter));

    // The cells every row has: enabled, schedule, last run.
    void Enabled(bool on)
    {
        if (on) { <span class="mat-pill mat-pill--ok">@L["Enabled"]</span> }
        else { <span class="mat-pill mat-pill--warn">@L["Disabled"]</span> }
    }

    void LastRun(TaskRunState? state, DateTime? started)
    {
        if (state is TaskRunState s && started is DateTime at)
        {
            <span class="@StatePill(s)">@StateText(s)</span> <small class="mat-muted">@Fmt.DateTime(at)</small>
        }
        else { <span class="mat-muted">—</span> }
    }

    async Task Actions(string runUrl, string runLabel, string editUrl)
    {
        <div class="mat-table__actions">
            <form method="post" action="@runUrl" class="mp-contents">
                @Html.AntiForgeryToken()
                <mp-icon-button icon="play" label="@runLabel" type="submit" />
            </form>
            <mp-icon-button icon="edit" label='@L["Edit"]' href="@editUrl" />
        </div>
    }
}

<div class="mat-list">
    <mp-toolbar id="importtasks" label='@L["Import tasks"]' count="Model.TotalCount" singular="{0} import rule" plural="{0} import rules">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
        <mp-toolbar-select name="Type" label='@L["Type"]' value="@Model.Type">
            <option value="all">@L["All"]</option>
            <option value="Imap">IMAP</option>
            <option value="Pop3">POP3</option>
            <option value="Smb">@L["SMB share"]</option>
            <option value="Filesystem">@L["Watched folder"]</option>
        </mp-toolbar-select>
        <mp-toolbar-select name="Status" label='@L["Status"]' value="@Model.Status">
            <option value="all">@L["All"]</option>
            <option value="enabled">@L["Enabled"]</option>
            <option value="disabled">@L["Disabled"]</option>
        </mp-toolbar-select>
        @if (Model.GroupOptions.Count > 0)
        {
            <mp-toolbar-select name="Group" label='@L["Group"]' value="@Model.Group">
                <option value="all">@L["All"]</option>
                <option value="none">@L["Without group"]</option>
                @foreach (var option in Model.GroupOptions)
                {
                    <option value="@option.Id">@option.Name</option>
                }
            </mp-toolbar-select>
        }
        <mp-toolbar-sort value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
            <option value="run_desc">@L["Last run (newest first)"]</option>
            <option value="run_asc">@L["Last run (oldest first)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="activeFilters" />

    @* One table: a group is a header row, its rules sit indented below it in the order they run; single rules follow. *@
    <mp-table item-count="Model.TotalCount + Model.Groups.Count" empty-text='@L["No import tasks match your criteria."]' caption='@L["Import tasks"]'>
        <thead>
            <tr>
                <th scope="col">@L["Name"]</th>
                <th scope="col" class="mat-hide-sm">@L["Type"]</th>
                <th scope="col">@L["Enabled"]</th>
                <th scope="col" class="mat-hide-sm">@L["Schedule"]</th>
                <th scope="col">@L["Last run"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model.Groups)
            {
                var gs = CronSchedule.Describe(g.CronExpression, Fmt.TimeZone);
                <tr class="mp-import-group" data-row-href="/System/ImportGroups/Details?id=@g.Id">
                    <td>
                        <div class="mat-table__name">
                            <mp-icon name="layers" />
                            <a href="/System/ImportGroups/Details?id=@g.Id">@g.Name</a>
                            <span class="mat-badge mat-badge--soft">@g.Rules.Count</span>
                        </div>
                    </td>
                    <td class="mat-hide-sm">@L["Group"]</td>
                    <td>@{ Enabled(g.IsEnabled); }</td>
                    <td class="mat-hide-sm">
                        <span class="@(gs.IsValid ? "" : "mat-pill mat-pill--warn")">@gs.Text</span>
                        @if (gs.NextUtc is DateTime gnext)
                        {
                            <small class="mat-muted mp-block">@L["next:"] @Fmt.DateTime(gnext)</small>
                        }
                    </td>
                    <td>@{ LastRun(g.LastState, g.LastStartedAt); }</td>
                    <td class="mat-table__cell-actions">@{ await Actions($"/System/ImportGroups/Edit?id={g.Id}&handler=Run", L["Run group now"].Value, $"/System/ImportGroups/Edit?id={g.Id}"); }</td>
                </tr>

                @for (var i = 0; i < g.Rules.Count; i++)
                {
                    var t = g.Rules[i];
                    <tr class="mp-import-child" data-row-href="/System/ImportTasks/Details?id=@t.Id">
                        <td><div class="mat-table__name"><span class="mat-badge mat-badge--soft">@(i + 1)</span><a href="/System/ImportTasks/Details?id=@t.Id">@t.Name</a></div></td>
                        <td class="mat-hide-sm">@TypeLabel(t.Type)</td>
                        <td>@{ Enabled(t.IsEnabled); }</td>
                        <td class="mat-hide-sm"><small class="mat-muted">@L["with the group"]</small></td>
                        <td>@{ LastRun(t.LastState, t.LastStartedAt); }</td>
                        <td class="mat-table__cell-actions">@{ await Actions($"/System/ImportTasks/Edit?id={t.Id}&handler=Run", L["Run now"].Value, $"/System/ImportTasks/Edit?id={t.Id}"); }</td>
                    </tr>
                }
            }

            @foreach (var t in Model.Singles)
            {
                var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone);
                <tr data-row-href="/System/ImportTasks/Details?id=@t.Id">
                    <td><div class="mat-table__name"><a href="/System/ImportTasks/Details?id=@t.Id">@t.Name</a></div></td>
                    <td class="mat-hide-sm">@TypeLabel(t.Type)</td>
                    <td>@{ Enabled(t.IsEnabled); }</td>
                    <td class="mat-hide-sm">
                        <span class="@(sched.IsValid ? "" : "mat-pill mat-pill--warn")">@sched.Text</span>
                        @if (sched.NextUtc is DateTime nextUtc)
                        {
                            <small class="mat-muted mp-block">@L["next:"] @Fmt.DateTime(nextUtc)</small>
                        }
                    </td>
                    <td>@{ LastRun(t.LastState, t.LastStartedAt); }</td>
                    <td class="mat-table__cell-actions">@{ await Actions($"/System/ImportTasks/Edit?id={t.Id}&handler=Run", L["Run now"].Value, $"/System/ImportTasks/Edit?id={t.Id}"); }</td>
                </tr>
            }
        </tbody>
    </mp-table>

    <div class="mat-actions">
        <mp-button variant="primary" href="/System/ImportTasks/Edit" icon="plus">@L["New import task"]</mp-button>
        <mp-button variant="secondary" href="/System/ImportGroups/Edit" icon="layers">@L["New group"]</mp-button>
    </div>
</div>
