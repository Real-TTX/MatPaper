@page "/System/ImportTasks"
@model MatPaper.Pages.System.ImportTasks.IndexModel
@using MatPaper.Data
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = L["System / Import tasks"].Value;
}

@functions {
    string TypeLabel(MatPaper.Data.ImportTaskType type) => type switch
    {
        MatPaper.Data.ImportTaskType.Imap => "IMAP",
        MatPaper.Data.ImportTaskType.Pop3 => "POP3",
        MatPaper.Data.ImportTaskType.Smb => L["SMB share"].Value,
        _ => L["Watched folder"].Value
    };
}

<mp-toolbar count="Model.TotalCount">
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
</mp-toolbar>

@{
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search));
}
<partial name="_FilterChips" model="activeFilters" />

<mp-table item-count="Model.Rows.Count" empty-text='@L["No import tasks match your criteria."]'>
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Type"]</th>
            <th>@L["Enabled"]</th>
            <th>@L["Schedule"]</th>
            <th>@L["Last run"]</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Rows)
        {
            <tr data-row-href="/System/ImportTasks/Edit?id=@t.Id" tabindex="0">
                <td>@t.Name</td>
                <td>@TypeLabel(t.Type)</td>
                <td>
                    @if (t.IsEnabled)
                    {
                        <span class="badge badge--ok">@L["Enabled"]</span>
                    }
                    else
                    {
                        <span class="badge badge--warn">@L["Disabled"]</span>
                    }
                </td>
                <td>
                    @{ var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone); }
                    <span class="@(sched.IsValid ? "" : "badge badge--warn")">@sched.Text</span>
                    @if (sched.NextUtc is DateTime nextUtc)
                    {
                        <br /><span class="form-help" style="margin:0">@L["next:"] @Fmt.DateTime(nextUtc)</span>
                    }
                </td>
                <td>
                    @if (t.LastState is TaskRunState state && t.LastStartedAt is DateTime started)
                    {
                        var css = state switch
                        {
                            TaskRunState.Success => "badge--ok",
                            TaskRunState.Failed => "badge--off",
                            _ => "badge--muted"
                        };
                        <span class="badge @css">@state</span>
                        <span>&nbsp;@Fmt.DateTime(started)</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td class="is-actions">
                    <form method="post" action="/System/ImportTasks/Edit?id=@t.Id&handler=Run" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="icon-btn" type="submit" title='@L["Run now"]' aria-label='@L["Run now"]'>
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                        </button>
                    </form>
                    <a href="/System/ImportTasks/Edit?id=@t.Id">@L["Edit"]</a>
                </td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/System/ImportTasks/Edit">@L["New import task"]</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
