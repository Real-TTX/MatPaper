@page "/System/ImportTasks"
@model MatPaper.Pages.System.ImportTasks.IndexModel
@using MatPaper.Data
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = L["System / Import tasks"].Value;

    string TypeLabel(ImportTaskType type) => type switch
    {
        ImportTaskType.Imap => "IMAP",
        ImportTaskType.Pop3 => "POP3",
        ImportTaskType.Smb => L["SMB share"].Value,
        _ => L["Watched folder"].Value
    };

    string StateBadge(TaskRunState state) => state switch
    {
        TaskRunState.Success => "badge--ok",
        TaskRunState.Failed => "badge--off",
        _ => "badge--muted"
    };
}

<mp-toolbar count="Model.TotalCount">
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
</mp-toolbar>

@{
    var activeFilters = FilterChipBar.From(ViewContext.HttpContext.Request,
        new FilterSpec("Search", L["Search"].Value, Model.Search));
}
<partial name="_FilterChips" model="activeFilters" />

@* One table: a group is a header row, its rules sit indented below it in the order they run; single rules follow. *@
<mp-table item-count="Model.TotalCount + Model.Groups.Count" empty-text='@L["No import tasks match your criteria."]'>
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Type"]</th>
            <th>@L["Enabled"]</th>
            <th>@L["Schedule"]</th>
            <th>@L["Last run"]</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model.Groups)
        {
            var gs = CronSchedule.Describe(g.CronExpression, Fmt.TimeZone);
            <tr class="import-row import-row--group" data-row-href="/System/ImportGroups/Details?id=@g.Id" tabindex="0">
                <td>
                    <span class="import-row__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5z" /><path d="M3 12l9 5 9-5" /><path d="M3 16l9 5 9-5" /></svg>
                    </span>
                    <a href="/System/ImportGroups/Details?id=@g.Id">@g.Name</a>
                    <span class="import-row__count">@g.Rules.Count</span>
                </td>
                <td>@L["Group"]</td>
                <td>
                    @if (g.IsEnabled) { <span class="badge badge--ok">@L["Enabled"]</span> }
                    else { <span class="badge badge--warn">@L["Disabled"]</span> }
                </td>
                <td>
                    <span class="@(gs.IsValid ? "" : "badge badge--warn")">@gs.Text</span>
                    @if (gs.NextUtc is DateTime gnext)
                    {
                        <br /><span class="form-help" style="margin:0">@L["next:"] @Fmt.DateTime(gnext)</span>
                    }
                </td>
                <td>
                    @if (g.LastState is TaskRunState gstate && g.LastStartedAt is DateTime gstarted)
                    {
                        <span class="badge @StateBadge(gstate)">@gstate</span>
                        <span>&nbsp;@Fmt.DateTime(gstarted)</span>
                    }
                    else { <span>—</span> }
                </td>
                <td class="is-actions">
                    <form method="post" action="/System/ImportGroups/Edit?id=@g.Id&handler=Run" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="icon-btn" type="submit" title='@L["Run group now"]' aria-label='@L["Run group now"]'>
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                        </button>
                    </form>
                    <a class="icon-btn" href="/System/ImportGroups/Edit?id=@g.Id" title='@L["Edit"]' aria-label='@L["Edit"]'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg></a>
                </td>
            </tr>

            @for (var i = 0; i < g.Rules.Count; i++)
            {
                var t = g.Rules[i];
                <tr class="import-row import-row--child@(i == g.Rules.Count - 1 ? " is-last" : "")" data-row-href="/System/ImportTasks/Details?id=@t.Id" tabindex="0">
                    <td><span class="import-row__order">@(i + 1)</span><a href="/System/ImportTasks/Details?id=@t.Id">@t.Name</a></td>
                    <td>@TypeLabel(t.Type)</td>
                    <td>
                        @if (t.IsEnabled) { <span class="badge badge--ok">@L["Enabled"]</span> }
                        else { <span class="badge badge--warn">@L["Disabled"]</span> }
                    </td>
                    <td><span class="form-help" style="margin:0">@L["with the group"]</span></td>
                    <td>
                        @if (t.LastState is TaskRunState state && t.LastStartedAt is DateTime started)
                        {
                            <span class="badge @StateBadge(state)">@state</span>
                            <span>&nbsp;@Fmt.DateTime(started)</span>
                        }
                        else { <span>—</span> }
                    </td>
                    <td class="is-actions">
                        <form method="post" action="/System/ImportTasks/Edit?id=@t.Id&handler=Run" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button class="icon-btn" type="submit" title='@L["Run now"]' aria-label='@L["Run now"]'>
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                            </button>
                        </form>
                        <a class="icon-btn" href="/System/ImportTasks/Edit?id=@t.Id" title='@L["Edit"]' aria-label='@L["Edit"]'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg></a>
                    </td>
                </tr>
            }
        }

        @foreach (var t in Model.Singles)
        {
            var sched = CronSchedule.Describe(t.CronExpression, Fmt.TimeZone);
            <tr class="import-row" data-row-href="/System/ImportTasks/Details?id=@t.Id" tabindex="0">
                <td><a href="/System/ImportTasks/Details?id=@t.Id">@t.Name</a></td>
                <td>@TypeLabel(t.Type)</td>
                <td>
                    @if (t.IsEnabled) { <span class="badge badge--ok">@L["Enabled"]</span> }
                    else { <span class="badge badge--warn">@L["Disabled"]</span> }
                </td>
                <td>
                    <span class="@(sched.IsValid ? "" : "badge badge--warn")">@sched.Text</span>
                    @if (sched.NextUtc is DateTime nextUtc)
                    {
                        <br /><span class="form-help" style="margin:0">@L["next:"] @Fmt.DateTime(nextUtc)</span>
                    }
                </td>
                <td>
                    @if (t.LastState is TaskRunState state && t.LastStartedAt is DateTime started)
                    {
                        <span class="badge @StateBadge(state)">@state</span>
                        <span>&nbsp;@Fmt.DateTime(started)</span>
                    }
                    else { <span>—</span> }
                </td>
                <td class="is-actions">
                    <form method="post" action="/System/ImportTasks/Edit?id=@t.Id&handler=Run" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="icon-btn" type="submit" title='@L["Run now"]' aria-label='@L["Run now"]'>
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                        </button>
                    </form>
                    <a class="icon-btn" href="/System/ImportTasks/Edit?id=@t.Id" title='@L["Edit"]' aria-label='@L["Edit"]'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg></a>
                </td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/System/ImportTasks/Edit">@L["New import task"]</a>
    <a class="btn btn--secondary" href="/System/ImportGroups/Edit">@L["New group"]</a>
</div>
