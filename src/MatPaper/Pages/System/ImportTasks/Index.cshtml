@page "/System/ImportTasks"
@model MatPaper.Pages.System.ImportTasks.IndexModel
@using MatPaper.Data
@using MatPaper.Services
@{
    ViewData["Breadcrumb"] = L["System / Import tasks"].Value;
}

<mp-toolbar count="Model.TotalCount">
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
</mp-toolbar>

@{
    var activeFilters = FilterChipBar.From(ViewContext.HttpContext.Request,
        new FilterSpec("Search", L["Search"].Value, Model.Search));
}
<partial name="_FilterChips" model="activeFilters" />

@foreach (var g in Model.Groups)
{
    var sched = CronSchedule.Describe(g.CronExpression, Fmt.TimeZone);
    <section class="import-group">
        <div class="import-group__head">
            <h2 class="import-group__title"><a href="/System/ImportGroups/Edit?id=@g.Id">@g.Name</a></h2>
            @if (!g.IsEnabled) { <span class="badge badge--warn">@L["Disabled"]</span> }
            <span class="import-group__meta">
                @L["Group"] · @sched.Text@(sched.NextUtc is DateTime next ? $" · {L["next:"].Value} {Fmt.DateTime(next)}" : "")
                @if (g.LastState is TaskRunState state && g.LastStartedAt is DateTime started)
                {
                    <text> · </text><span class="badge @(state == TaskRunState.Success ? "badge--ok" : state == TaskRunState.Failed ? "badge--off" : "badge--muted")">@state</span><text> @Fmt.DateTime(started)</text>
                }
            </span>
            <form method="post" action="/System/ImportGroups/Edit?id=@g.Id&handler=Run" style="display:inline">
                @Html.AntiForgeryToken()
                <button class="btn btn--secondary" type="submit">@L["Run group now"]</button>
            </form>
            <a class="btn btn--secondary" href="/System/ImportGroups/Edit?id=@g.Id">@L["Edit"]</a>
        </div>
        @if (g.Rules.Count == 0)
        {
            <p class="form-help" style="padding:0.7rem 0.9rem;border:1px solid var(--color-border);border-top:0;margin:0">@L["No rules in this group yet."]</p>
        }
        else
        {
            <partial name="_RuleTable" model="new MatPaper.Pages.System.ImportTasks.IndexModel.RuleTable(g.Rules, true)" />
        }
    </section>
}

@if (Model.Singles.Count > 0 || Model.Groups.Count == 0)
{
    <section class="import-group import-group--singles">
        @if (Model.Groups.Count > 0)
        {
            <div class="import-group__head">
                <h2 class="import-group__title">@L["Single rules"]</h2>
                <span class="import-group__meta">@L["Each with its own schedule"]</span>
            </div>
        }
        <partial name="_RuleTable" model="new MatPaper.Pages.System.ImportTasks.IndexModel.RuleTable(Model.Singles, false)" />
    </section>
}

<div class="list-actions">
    <a class="btn btn--primary" href="/System/ImportTasks/Edit">@L["New import task"]</a>
    <a class="btn btn--secondary" href="/System/ImportGroups/Edit">@L["New group"]</a>
</div>
