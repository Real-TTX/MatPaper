@page "/System/Inbox"
@model MatPaper.Pages.System.Inbox.IndexModel
@{
    ViewData["Breadcrumb"] = L["System / Import inbox"].Value;
}

@if (TempData["InboxMessage"] is string message && !string.IsNullOrEmpty(message))
{
    <div class="form-summary">@message</div>
}

<form class="form" method="post">
    <div class="form-row">
        <label for="ScanLocationId">@L["Storage location"]</label>
        <select class="form-control" id="ScanLocationId" name="ScanLocationId">
            @foreach (var loc in Model.StorageLocations)
            {
                <option value="@loc.Id" selected="@(loc.Id == Model.ScanLocationId)">@loc.Name</option>
            }
        </select>
        <p class="form-help">@L["Discover files on disk under this location and add unknown ones to the inbox."]</p>
    </div>
    <mp-button-row>
        <mp-button variant="primary" handler="Scan">@L["Scan now"]</mp-button>
    </mp-button-row>
</form>

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["File name"]' />
    <mp-toolbar-select name="LocationId" label='@L["Location"]' value="@(Model.LocationId?.ToString() ?? string.Empty)">
        <option value="">@L["All locations"]</option>
        @foreach (var loc in Model.StorageLocations)
        {
            <option value="@loc.Id">@loc.Name</option>
        }
    </mp-toolbar-select>
</mp-toolbar>

<form method="post">
    <mp-table item-count="Model.Rows.Count" empty-text='@L["Inbox is empty — scan a storage location to discover files."]'>
        <thead>
            <tr>
                <th><input type="checkbox" id="select-all" aria-label='@L["Select all"]' /></th>
                <th>@L["File name"]</th>
                <th>@L["Relative path"]</th>
                <th>@L["Location"]</th>
                <th>@L["Size"]</th>
                <th>@L["Modified"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Rows)
            {
                <tr>
                    <td><input type="checkbox" class="row-select" name="SelectedIds" value="@item.Id" /></td>
                    <td>@item.FileName</td>
                    <td>@item.RelativePath</td>
                    <td>@(item.StorageLocation?.Name ?? "—")</td>
                    <td>@Fmt.Size(item.FileSize)</td>
                    <td>@Fmt.Date(item.FileModifiedUtc)</td>
                </tr>
            }
        </tbody>
    </mp-table>

    @if (Model.Rows.Count > 0)
    {
        <div class="form">
            <h2>@L["Assign metadata to selected items"]</h2>

            <div class="form-row">
                <label for="CorrespondentId">@L["Correspondent"]</label>
                <select class="form-control" id="CorrespondentId" name="CorrespondentId">
                    <option value="">@L["— None —"]</option>
                    @foreach (var c in Model.Correspondents)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <label for="DocumentTypeId">@L["Document type"]</label>
                <select class="form-control" id="DocumentTypeId" name="DocumentTypeId">
                    <option value="">@L["— None —"]</option>
                    @foreach (var t in Model.DocumentTypes)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <label for="ProjectId">@L["Project"]</label>
                <select class="form-control" id="ProjectId" name="ProjectId">
                    <option value="">@L["— None —"]</option>
                    @foreach (var p in Model.Projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>

            @if (Model.Tags.Count > 0)
            {
                <div class="form-row">
                    <label>@L["Tags"]</label>
                    <div class="checkbox-group">
                        @foreach (var tag in Model.Tags)
                        {
                            <label class="form-check">
                                <input type="checkbox" name="TagIds" value="@tag.Id" />
                                <span>@tag.Name</span>
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="form-row">
                <label>@L["Filing"]</label>
                <div class="checkbox-group">
                    <label class="form-check">
                        <input type="radio" name="Refile" value="false" checked />
                        <span>@L["Keep in place"]</span>
                    </label>
                    <label class="form-check">
                        <input type="radio" name="Refile" value="true" />
                        <span>@L["Re-file by template"]</span>
                    </label>
                </div>
                <p class="form-help">
                    @L["Keep in place registers files where they are. Re-file moves them into the location's path template."]
                </p>
            </div>

            <mp-button-row>
                <mp-button variant="primary" handler="Import">@L["Import selected"]</mp-button>
                <mp-button-spacer />
                <mp-button variant="danger" handler="Dismiss"
                           confirm='@L["Dismiss the selected inbox items? They will be hidden from the inbox."]'>@L["Dismiss selected"]</mp-button>
            </mp-button-row>
        </div>
    }
</form>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />

<script>
    (function () {
        var selectAll = document.getElementById('select-all');
        if (!selectAll) { return; }
        selectAll.addEventListener('change', function () {
            var boxes = document.querySelectorAll('.row-select');
            for (var i = 0; i < boxes.length; i++) {
                boxes[i].checked = selectAll.checked;
            }
        });
    })();
</script>
