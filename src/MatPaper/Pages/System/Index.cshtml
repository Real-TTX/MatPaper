@page
@model MatPaper.Pages.System.IndexModel
@{
    ViewData["Breadcrumb"] = L["System"].Value;
    ViewData["Heading"] = L["Administration"].Value;
    ViewData["PageSub"] = L["Users, storage, automation and the settings of this instance."].Value;

    async Task Card(string href, string icon, string title, string description)
    {
        <a class="mat-card mp-linkcard" href="@href">
            <div class="mat-card__body mp-linkcard__body">
                <span class="mp-linkcard__icon"><mp-icon name="@icon" /></span>
                <span class="mp-linkcard__text"><strong>@title</strong><span class="mat-muted">@description</span></span>
            </div>
        </a>
    }
}

<div class="mat-grid">
    @{ await Card("/System/Users", "user", L["Users"].Value, L["Manage local accounts and roles"].Value); }
    @{ await Card("/System/StorageLocations", "hard-drive", L["Storage locations"].Value, L["Manage storage locations and search them for files"].Value); }
    @{ await Card("/System/DocumentTypes", "shapes",L["Document types"].Value, L["Manage the document type vocabulary"].Value); }
    @{ await Card("/System/Connections", "plug", L["Connections"].Value, L["Reusable connections for mailboxes, shares and cloud drives"].Value); }
    @{ await Card("/System/ImportTasks", "download", L["Import tasks"].Value, L["Scheduled imports from folders and mailboxes"].Value); }
    @{ await Card("/System/ExportTasks", "upload", L["Export tasks"].Value, L["Scheduled database and document backups"].Value); }
    @{ await Card("/System/ArchiveNumbers", "scan-barcode", L["Archive numbers"].Value, L["Labels, separator sheets and barcodes for the paper originals"].Value); }
    @{ await Card("/System/Blocklist", "shield", L["Blocklist"].Value, L["Deleted documents that are not imported again"].Value); }
    @{ await Card("/System/TaskRuns", "clock", L["Task history"].Value, L["Results and logs of import/export runs"].Value); }
    @{ await Card("/System/Settings", "sliders", L["Settings"].Value, L["Public address, time zone and language"].Value); }
</div>
