@page "/System/Settings"
@model MatPaper.Pages.System.Settings.IndexModel
@{
    ViewData["Breadcrumb"] = L["System / Settings"].Value;
    ViewData["PageSub"] = L["Public address, time zone and language"].Value;
    ViewData["Width"] = "narrow";
}

<div class="mat-stack">
    <form method="post" class="mat-form" novalidate>
        <partial name="_ValidationSummary" />

        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Public address"]</h2></div>
            <div class="mat-card__body mat-stack">
                @if (Model.PublicUrlFromEnv is not null)
                {
                    <div class="mat-field">
                        <label class="mat-label" for="locked-public-url">@L["Public address"]</label>
                        <input class="mat-input" id="locked-public-url" type="text" value="@Model.PublicUrlFromEnv" disabled />
                        <span class="mat-hint">@L["Set by the environment variable {0}; change it there.", "MATPAPER_PUBLIC_URL"]</span>
                    </div>
                }
                else
                {
                    <mp-field asp-for="Input.PublicBaseUrl" kind="url" label='@L["Public address"]' placeholder="https://papers.example.com"
                              autocomplete="off" help='@L["Needed for sign-in with Google and Microsoft (OAuth)."]' />
                }

                @if (!string.IsNullOrEmpty(Model.RedirectUri))
                {
                    <div class="mat-field">
                        <label class="mat-label" for="redirect-uri">@L["Redirect URI"]</label>
                        <div class="mat-input-group">
                            <input class="mat-input mat-mono" id="redirect-uri" type="text" value="@Model.RedirectUri" readonly />
                            <button type="button" class="mat-btn mat-btn--secondary" data-copy="#redirect-uri"><mp-icon name="copy" /><span>@L["Copy"]</span></button>
                        </div>
                        <span class="mat-hint">@L["Register this exact URI with your Google Cloud / Azure app."]</span>
                    </div>
                }
            </div>
        </div>

        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Display"]</h2></div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    @if (Model.TimeZoneFromEnv is not null)
                    {
                        <div class="mat-field mat-field--full">
                            <label class="mat-label" for="locked-time-zone">@L["Time zone"]</label>
                            <input class="mat-input" id="locked-time-zone" type="text" value="@Model.TimeZoneFromEnv" disabled />
                            <span class="mat-hint">@L["Set by the environment variable {0}; change it there.", "MATPAPER_TZ"]</span>
                        </div>
                    }
                    else
                    {
                        <mp-picker asp-for="Input.TimeZone" asp-items="Model.TimeZoneOptions" value="@Model.Input.TimeZone" label='@L["Time zone"]' />
                    }

                    <mp-field asp-for="Input.Culture" kind="select" label='@L["Default language"]' asp-items="Model.CultureOptions" />
                    <mp-field asp-for="Input.ThemeMode" kind="select" label='@L["Default mode"]' asp-items="Model.ThemeModeOptions" />
                    <mp-field asp-for="Input.ThemeScheme" kind="select" label='@L["Default colour scheme"]' asp-items="Model.ThemeSchemeOptions" />
                    <mp-field asp-for="Input.ThemeAccent" kind="select" label='@L["Default accent colour"]' asp-items="Model.ThemeAccentOptions"
                              help='@L["Used for the sign-in page and for users without their own choice."]' />
                </div>
            </div>
        </div>

        <mp-button-row>
            <mp-button variant="primary" icon="save">@L["Save"]</mp-button>
            <mp-button variant="secondary" href="/System" icon="back">@L["Back"]</mp-button>
        </mp-button-row>
    </form>

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["About this instance"]</h2></div>
        <div class="mat-card__body mat-stack">
            <dl class="mat-kv">
                <dt>@L["Version"]</dt>
                <dd class="mat-mono">@Model.Version</dd>
                <dt>@L["Current time"]</dt>
                <dd>@Model.NowInZone (@Model.ActiveTimeZone)</dd>
                <dt>@L["Data folder"]</dt>
                <dd class="mat-mono">@Model.DataDir</dd>
                <dt>@L["Configuration file"]</dt>
                <dd class="mat-mono">@Model.ConfigPath</dd>
                <dt>@L["Inbox folder"]</dt>
                <dd><span class="mat-mono">@Model.InboxPath</span>@if (Model.InboxFromEnv is not null) { <span class="mat-muted"> · @L["set by {0}", "MATPAPER_INBOX"]</span> }</dd>
                <dt>@L["Database"]</dt>
                <dd class="mat-mono">@Model.Database</dd>
            </dl>
            <p class="mat-muted">@L["Changes to these values need a restart."]</p>
        </div>
    </div>
</div>
