@page "/System/StorageLocations/Details"
@model MatPaper.Pages.System.StorageLocations.DetailsModel
@using MatPaper.Data
@{
    var l = Model.Location;
    ViewData["Heading"] = l.Name;
    ViewData["Title"] = l.Name;
    ViewData["PageSub"] = l.DisplayRoot;
}

<div class="mat-stack">
    <partial name="_TaskRunsPanel" model="Model.Runs" />

    <div class="mat-grid">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Location"]</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>@L["Type"]</dt>
                    <dd>
                        <span class="mat-pill mat-pill--plain">@(l.Kind == StorageKind.Smb ? "SMB" : l.Kind == StorageKind.Cloud ? L["Cloud drive"].Value : L["Local"].Value)</span>
                        @if (l.IsDefault) { <span class="mat-pill mat-pill--ok">@L["Default"]</span> }
                    </dd>
                    @foreach (var (label, value) in Model.Place)
                    {
                        <dt>@label</dt>
                        <dd class="mat-mono">@value</dd>
                    }
                </dl>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Files"]</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var (label, value) in Model.Files)
                    {
                        <dt>@label</dt>
                        <dd>@value</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Documents"]</h2></div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>@L["In the archive"]</dt>
                <dd>@Model.Filed</dd>
                <dt>@L["Found by the search"]</dt>
                <dd>@Model.Found</dd>
                <dt>@L["In the inbox"]</dt>
                <dd><a href="/Inbox?LocationId=@l.Id">@Model.InInbox</a></dd>
            </dl>
        </div>
    </div>

    @if (Model.LastRun is { } last && (!string.IsNullOrWhiteSpace(last.Log) || Model.Runs.IsRunning))
    {
        <div class="mat-card" data-live="log">
            <div class="mat-card__head"><h2 class="mat-card__title">@L["Log of the latest run"]</h2></div>
            <div class="mat-card__body mat-stack">
                <pre class="mat-code mp-log">@last.Log</pre>
                <a href="/System/TaskRuns/Details?id=@last.Id">@Fmt.DateTimeSeconds(last.StartedAt)</a>
            </div>
        </div>
    }

    <mp-button-row>
        <mp-button variant="primary" href="@($"/System/StorageLocations/Edit?id={l.Id}")" icon="edit">@L["Edit"]</mp-button>
        <mp-button variant="secondary" href="@($"/System/StorageLocations/Align?id={l.Id}")" icon="refresh">@L["Align files to the template …"]</mp-button>
        <mp-button variant="secondary" href="/System/StorageLocations" icon="back">@L["Back"]</mp-button>
    </mp-button-row>
</div>
