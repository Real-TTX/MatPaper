@page "/System/StorageLocations/Details"
@model MatPaper.Pages.System.StorageLocations.DetailsModel
@using MatPaper.Data
@{
    var l = Model.Location;
}

<div class="task-head">
    <div class="task-head__main">
        <h2 class="task-head__title">@l.Name</h2>
        <div class="task-head__meta">
            <span class="badge badge--muted">@(l.Kind == StorageKind.Smb ? "SMB" : l.Kind == StorageKind.Cloud ? L["Cloud drive"].Value : L["Local"].Value)</span>
            @if (l.IsDefault) { <span class="badge badge--ok">@L["Default"]</span> }
            <span class="form-help" style="margin:0">@l.DisplayRoot</span>
        </div>
    </div>
    <div class="task-head__actions">
        <a class="btn btn--secondary" href="/System/StorageLocations/Align?id=@l.Id">@L["Align files to the template …"]</a>
        <a class="btn btn--secondary" href="/System/StorageLocations/Edit?id=@l.Id">@L["Edit"]</a>
        <a class="btn btn--secondary" href="/System/StorageLocations">@L["Back"]</a>
    </div>
</div>

<partial name="_TaskRunsPanel" model="Model.Runs" />

<div class="task-grid">
    <section class="task-card">
        <h3>@L["Location"]</h3>
        <dl class="task-facts">
            @foreach (var (label, value) in Model.Place)
            {
                <dt>@label</dt>
                <dd>@value</dd>
            }
        </dl>
    </section>
    <section class="task-card">
        <h3>@L["Files"]</h3>
        <dl class="task-facts">
            @foreach (var (label, value) in Model.Files)
            {
                <dt>@label</dt>
                <dd>@value</dd>
            }
        </dl>
    </section>
</div>

<section class="task-card task-card--wide">
    <h3>@L["Documents"]</h3>
    <dl class="task-facts">
        <dt>@L["In the archive"]</dt>
        <dd>@Model.Filed</dd>
        <dt>@L["Found by the search"]</dt>
        <dd>@Model.Found</dd>
        <dt>@L["In the inbox"]</dt>
        <dd><a href="/Inbox?LocationId=@l.Id">@Model.InInbox</a></dd>
    </dl>
</section>

@if (Model.LastRun is { } last && (!string.IsNullOrWhiteSpace(last.Log) || Model.Runs.IsRunning))
{
    <section class="task-card task-card--wide" data-live="log">
        <h3>@L["Log of the latest run"]</h3>
        <pre class="task-log">@last.Log</pre>
        <p class="runs-panel__more"><a href="/System/TaskRuns/Details?id=@last.Id">@Fmt.DateTimeSeconds(last.StartedAt)</a></p>
    </section>
}
