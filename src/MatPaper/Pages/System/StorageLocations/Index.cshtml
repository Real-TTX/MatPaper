@page "/System/StorageLocations"
@using MatPaper.Data
@inject MatPaper.Services.DocumentStorageService Storage
@model MatPaper.Pages.System.StorageLocations.IndexModel
@{
    ViewData["Breadcrumb"] = L["System / Storage locations"].Value;
    var kindLabel = Model.Kind switch { "Local" => L["Local"].Value, "Smb" => "SMB", _ => null };
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search),
        new MatPaper.Services.FilterSpec("Kind", L["Type"].Value, kindLabel));
}

<div class="mat-list">
    <mp-toolbar id="locations" label='@L["Storage locations"]' count="Model.TotalCount" singular="{0} storage location" plural="{0} storage locations">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name or path"]' />
        <mp-toolbar-select name="Kind" label='@L["Type"]' value="@Model.Kind">
            <option value="all">@L["All"]</option>
            <option value="Local">@L["Local"]</option>
            <option value="Smb">SMB</option>
        </mp-toolbar-select>
        <mp-toolbar-sort value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="activeFilters" />

    <form method="post" class="mp-contents">
        <mp-table item-count="Model.Rows.Count" empty-text='@L["No storage locations match your criteria."]' caption='@L["Storage locations"]'>
            <thead>
                <tr>
                    <th scope="col">@L["Name"]</th>
                    <th scope="col">@L["Type"]</th>
                    <th scope="col" class="mat-hide-sm">@L["Location"]</th>
                    <th scope="col">@L["Default"]</th>
                    <th scope="col">@L["Last searched"]</th>
                    <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Rows)
                {
                    <tr data-row-href="/System/StorageLocations/Details?id=@s.Id">
                        <td><div class="mat-table__name"><a href="/System/StorageLocations/Details?id=@s.Id">@s.Name</a></div></td>
                        <td><span class="@(s.Kind == StorageKind.Smb ? "mat-pill mat-pill--accent" : "mat-pill mat-pill--plain")">@(s.Kind == StorageKind.Smb ? "SMB" : L["Local"].Value)</span></td>
                        <td class="mat-hide-sm mat-mono">@s.DisplayRoot</td>
                        <td>
                            @if (s.IsDefault)
                            {
                                <span class="mat-pill mat-pill--ok">@L["Default"]</span>
                            }
                        </td>
                        <td>
                            @if (Model.Busy.Contains(s.Id))
                            {
                                <span class="mat-pill mat-pill--busy">@L["Search running…"]</span>
                            }
                            else if (s.LastScanError != null)
                            {
                                <span class="mat-pill mat-pill--error" title="@s.LastScanError">@L["Failed"]</span> <small class="mat-muted">@Fmt.Date(s.LastScanUtc)</small>
                            }
                            else if (s.LastScanUtc.HasValue)
                            {
                                <span>@Fmt.Date(s.LastScanUtc)</span> <small class="mat-muted">@L["{0} new", s.LastScanFound]</small>
                            }
                            else
                            {
                                <small class="mat-muted">@L["Never"]</small>
                            }
                        </td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <mp-icon-button icon="folder-open" label='@L["Search storage for files"]' type="submit" formaction='@Url.Page(null, "Scan", new { id = s.Id })' disabled="@Model.Busy.Contains(s.Id)" />
                                <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/System/StorageLocations/Edit?id={s.Id}")' />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </mp-table>

        <div class="mat-actions">
            <mp-button variant="primary" href="/System/StorageLocations/Edit" icon="plus">@L["New storage location"]</mp-button>
            @if (Model.Rows.Count > 0)
            {
                <mp-button variant="secondary" handler="ScanAll" icon="refresh">@L["Search all storage locations"]</mp-button>
            }
        </div>
    </form>

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />
</div>

<p class="mat-muted">@L["Inbox staging:"] <span class="mat-mono">@Storage.StagingRoot</span></p>
