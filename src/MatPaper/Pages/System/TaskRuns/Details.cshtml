@page "/System/TaskRuns/Details"
@model MatPaper.Pages.System.TaskRuns.DetailsModel
@{
    ViewData["Breadcrumb"] = L["System / Task history / Run"].Value;
}

<dl class="form">
    <div>
        <strong>@L["Task"]</strong>
        <div>@Model.TaskName</div>
    </div>
    <div>
        <strong>@L["Kind"]</strong>
        <div>@Model.Run.Kind</div>
    </div>
    <div>
        <strong>@L["State"]</strong>
        <div>
            @switch (Model.Run.State)
            {
                case MatPaper.Data.TaskRunState.Success:
                    <span class="badge badge--ok">@L["Success"]</span>
                    break;
                case MatPaper.Data.TaskRunState.Failed:
                    <span class="badge badge--off">@L["Failed"]</span>
                    break;
                default:
                    <span class="badge badge--muted">@L["Running"]</span>
                    break;
            }
        </div>
    </div>
    <div>
        <strong>@L["Started"]</strong>
        <div>@Fmt.DateTimeSeconds(Model.Run.StartedAt)</div>
    </div>
    <div>
        <strong>@L["Finished"]</strong>
        <div>
            @if (Model.Run.FinishedAt is { } finished)
            {
                @Fmt.DateTimeSeconds(finished)
            }
            else
            {
                <span class="badge badge--muted">—</span>
            }
        </div>
    </div>
    <div>
        <strong>@L["Duration"]</strong>
        <div>
            @if (Model.Duration is { } d)
            {
                @($"{(int)d.TotalHours:00}:{d.Minutes:00}:{d.Seconds:00}")
            }
            else
            {
                <span class="badge badge--muted">—</span>
            }
        </div>
    </div>
    <div>
        <strong>@L["Items processed"]</strong>
        <div>@Model.Run.ItemsProcessed</div>
    </div>
    <div>
        <strong>@L["Log"]</strong>
        <pre>@(string.IsNullOrEmpty(Model.Run.Log) ? L["(no log)"].Value : Model.Run.Log)</pre>
    </div>
</dl>

<mp-button-row>
    <mp-button variant="secondary" href="/System/TaskRuns">@L["Back"]</mp-button>
</mp-button-row>
