@page "/System/TaskRuns/Details"
@model MatPaper.Pages.System.TaskRuns.DetailsModel
@{
    ViewData["Breadcrumb"] = L["System / Task history / Run"].Value;
    ViewData["Title"] = Model.TaskName;
    ViewData["Heading"] = Model.TaskName;
    ViewData["Width"] = "narrow";
}

<div class="mat-stack">
    <div class="mat-card">
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>@L["Task"]</dt>
                <dd>@Model.TaskName</dd>
                <dt>@L["Kind"]</dt>
                <dd>@(Model.Run.Kind switch { MatPaper.Data.TaskRunKind.Import => L["Import"].Value, MatPaper.Data.TaskRunKind.Export => L["Export"].Value, MatPaper.Data.TaskRunKind.Align => L["Align to template"].Value, MatPaper.Data.TaskRunKind.ImportGroup => L["Import group"].Value, _ => L["Storage search"].Value })</dd>
                <dt>@L["State"]</dt>
                <dd>
                    @switch (Model.Run.State)
                    {
                        case MatPaper.Data.TaskRunState.Success:
                            <span class="mat-pill mat-pill--ok">@L["Success"]</span>
                            break;
                        case MatPaper.Data.TaskRunState.Failed:
                            <span class="mat-pill mat-pill--error">@L["Failed"]</span>
                            break;
                        case MatPaper.Data.TaskRunState.Cancelled:
                            <span class="mat-pill mat-pill--warn">@L["Cancelled"]</span>
                            break;
                        default:
                            <span class="mat-pill mat-pill--busy">@L["Running"]</span>
                            break;
                    }
                </dd>
                <dt>@L["Started"]</dt>
                <dd class="mat-mono">@Fmt.DateTimeSeconds(Model.Run.StartedAt)</dd>
                <dt>@L["Finished"]</dt>
                <dd class="mat-mono">
                    @if (Model.Run.FinishedAt is { } finished)
                    {
                        @Fmt.DateTimeSeconds(finished)
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd>
                <dt>@L["Duration"]</dt>
                <dd class="mat-mono">
                    @if (Model.Duration is { } d)
                    {
                        @($"{(int)d.TotalHours:00}:{d.Minutes:00}:{d.Seconds:00}")
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd>
                <dt>@L["Items processed"]</dt>
                <dd>@Model.Run.ItemsProcessed</dd>
            </dl>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@L["Log"]</h2></div>
        <div class="mat-card__body">
            <pre class="mat-code mp-log">@(string.IsNullOrEmpty(Model.Run.Log) ? L["(no log)"].Value : Model.Run.Log)</pre>
        </div>
    </div>

    <mp-button-row>
        <mp-button variant="secondary" href="/System/TaskRuns" icon="back">@L["Back"]</mp-button>
    </mp-button-row>
</div>
