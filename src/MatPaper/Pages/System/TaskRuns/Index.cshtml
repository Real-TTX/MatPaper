@page "/System/TaskRuns"
@model MatPaper.Pages.System.TaskRuns.IndexModel
@{
    ViewData["Breadcrumb"] = L["System / Task history"].Value;
}

<mp-toolbar count="Model.TotalCount">
    <mp-toolbar-select name="Kind" label='@L["Kind"]' value="@Model.Kind">
        <option value="all">@L["All"]</option>
        <option value="import">@L["Import"]</option>
        <option value="export">@L["Export"]</option>
        <option value="scan">@L["Storage search"]</option>
    </mp-toolbar-select>
</mp-toolbar>

@functions {
    string KindLabel(MatPaper.Data.TaskRunKind kind) => kind switch
    {
        MatPaper.Data.TaskRunKind.Import => L["Import"].Value,
        MatPaper.Data.TaskRunKind.Export => L["Export"].Value,
        _ => L["Storage search"].Value
    };
}

@{
    var kindLabel = Model.Kind switch
    {
        "import" => L["Import"].Value,
        "export" => L["Export"].Value,
        "scan" => L["Storage search"].Value,
        _ => null
    };
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Kind", L["Kind"].Value, kindLabel));
}
<partial name="_FilterChips" model="activeFilters" />

<mp-table item-count="Model.Rows.Count" empty-text='@L["No task runs recorded yet."]'>
    <thead>
        <tr>
            <th>@L["Started"]</th>
            <th>@L["Kind"]</th>
            <th>@L["Task"]</th>
            <th>@L["State"]</th>
            <th>@L["Items"]</th>
            <th>@L["Duration"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><a href="/System/TaskRuns/Details?id=@r.Id">@Fmt.DateTime(r.StartedAt)</a></td>
                <td>@KindLabel(r.Kind)</td>
                <td>@r.TaskName</td>
                <td>
                    @switch (r.State)
                    {
                        case MatPaper.Data.TaskRunState.Success:
                            <span class="badge badge--ok">@L["Success"]</span>
                            break;
                        case MatPaper.Data.TaskRunState.Failed:
                            <span class="badge badge--off">@L["Failed"]</span>
                            break;
                        default:
                            <span class="badge badge--muted">@L["Running"]</span>
                            break;
                    }
                </td>
                <td>@r.ItemsProcessed</td>
                <td>
                    @if (r.Duration is { } d)
                    {
                        @($"{(int)d.TotalHours:00}:{d.Minutes:00}:{d.Seconds:00}")
                    }
                    else
                    {
                        <span class="badge badge--muted">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</mp-table>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
