@page
@model MatPaper.Pages.System.Users.EditModel
@{
    ViewData["Breadcrumb"] = $"{L["System"].Value} / {L["Users"].Value} / {(Model.IsEdit ? L["Edit"].Value : L["New"].Value)}";
}

<form class="form" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <section class="form-section">
        <h2 class="form-section__title">@L["Account"]</h2>

        <mp-field asp-for="Input.Username" label='@L["Username"]' autocomplete="off" />
        <mp-field asp-for="Input.DisplayName" label='@L["Display name"]' autocomplete="off" />
        <mp-field asp-for="Input.Email" kind="email" label='@L["Email"]' autocomplete="off" />
        <mp-field asp-for="Input.RoleId" kind="select" label='@L["Role"]' asp-items="Model.RoleOptions" />
        <mp-field asp-for="Input.IsActive" kind="checkbox" label='@L["Active"]' />
    </section>

    <section class="form-section">
        <h2 class="form-section__title">@L["Password"]</h2>

        <mp-field asp-for="Input.Password" kind="password" label='@L["Password"]' autocomplete="new-password"
                  placeholder='@(Model.IsEdit ? L["Leave blank to keep current"].Value : L["At least 8 characters"].Value)' />
        <mp-field asp-for="Input.ConfirmPassword" kind="password" label='@L["Confirm password"]' autocomplete="new-password" />
    </section>

    <mp-button-row>
        <mp-button variant="primary" type="submit">@L["Save"]</mp-button>
        <mp-button variant="secondary" href="/System/Users">@L["Back"]</mp-button>
        <mp-button-spacer />
        @if (Model.IsEdit)
        {
            <mp-button variant="danger" type="submit" handler="Delete"
                       confirm='@L["Delete this user? This cannot be undone."]'>@L["Delete"]</mp-button>
        }
    </mp-button-row>
</form>
