@page
@model MatPaper.Pages.System.Users.IndexModel
@{
    ViewData["Breadcrumb"] = $"{L["System"].Value} / {L["Users"].Value}";
    var roleLabel = Model.Role == "All" ? null : L[Model.Role].Value;
    var activeFilters = MatPaper.Services.FilterChipBar.From(ViewContext.HttpContext.Request,
        new MatPaper.Services.FilterSpec("Search", L["Search"].Value, Model.Search),
        new MatPaper.Services.FilterSpec("Role", L["Role"].Value, roleLabel));
}

<div class="mat-list">
    <mp-toolbar id="users" label='@L["Users"]' count="Model.TotalCount" singular="{0} user" plural="{0} users">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Username, display name or email"]' />
        <mp-toolbar-select name="Role" label='@L["Role"]' value="@Model.Role">
            <option value="All">@L["All"]</option>
            <option value="Admin">@L["Admin"]</option>
            <option value="User">@L["User"]</option>
            <option value="Anonymous">@L["Anonymous"]</option>
        </mp-toolbar-select>
        <mp-toolbar-sort value="@Model.Sort">
            <option value="username_asc">@L["Username (A–Z)"]</option>
            <option value="username_desc">@L["Username (Z–A)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="activeFilters" />

    <mp-table item-count="Model.Users.Count" empty-text='@L["No users match your criteria."]' caption='@L["Users"]'>
        <thead>
            <tr>
                <th scope="col">@L["Username"]</th>
                <th scope="col" class="mat-hide-sm">@L["Display name"]</th>
                <th scope="col" class="mat-hide-sm">@L["Email"]</th>
                <th scope="col">@L["Role"]</th>
                <th scope="col">@L["Active"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                var roleName = user.Role?.Name ?? "";
                var rolePill = roleName switch
                {
                    "Admin" => "mat-pill mat-pill--accent",
                    "User" => "mat-pill",
                    _ => "mat-pill mat-pill--plain"
                };
                <tr data-row-href="/System/Users/Edit?id=@user.Id">
                    <td><div class="mat-table__name"><a href="/System/Users/Edit?id=@user.Id">@user.Username</a></div></td>
                    <td class="mat-hide-sm">@user.DisplayName</td>
                    <td class="mat-hide-sm">@(string.IsNullOrWhiteSpace(user.Email) ? "—" : user.Email)</td>
                    <td><span class="@rolePill">@(string.IsNullOrEmpty(roleName) ? "—" : L[roleName].Value)</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="mat-pill mat-pill--ok">@L["Active"]</span>
                        }
                        else
                        {
                            <span class="mat-pill mat-pill--warn">@L["Inactive"]</span>
                        }
                    </td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/System/Users/Edit?id={user.Id}")' />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mp-table>

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Users.Count" />

    <div class="mat-actions">
        <mp-button variant="primary" href="/System/Users/Edit" icon="plus">@L["New user"]</mp-button>
    </div>
</div>
