@page "/Tags"
@model MatPaper.Pages.Tags.IndexModel
@{
    ViewData["Breadcrumb"] = L["Tags"].Value;
}

<div class="mat-list">
    <mp-toolbar id="tags" label='@L["Tags"]' count="Model.TotalCount" singular="{0} tag" plural="{0} tags">
        <mp-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Name"]' />
        <mp-toolbar-sort value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
        </mp-toolbar-sort>
    </mp-toolbar>

    <partial name="_FilterChips" model="Model.Filters" />

    <mp-table item-count="Model.Rows.Count" empty-text='@L["No tags match your criteria."]' caption='@L["Tags"]'>
        <thead>
            <tr>
                <th scope="col">@L["Name"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tag in Model.Rows)
            {
                <tr data-row-href="/Tags/Edit?id=@tag.Id">
                    <td><div class="mat-table__name"><span class="mat-dot" data-colour="@(string.IsNullOrWhiteSpace(tag.Color) ? "#808080" : tag.Color)" aria-hidden="true"></span><a href="/Tags/Edit?id=@tag.Id">@tag.Name</a></div></td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <mp-icon-button icon="file-text" label='@L["Documents"]' href='@($"/Documents?TagIds={tag.Id}")' />
                            <mp-icon-button icon="edit" label='@L["Edit"]' href='@($"/Tags/Edit?id={tag.Id}")' />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mp-table>

    <mp-pager current-page="Model.PageNumber" total-pages="Model.TotalPages" total="Model.TotalCount" row-count="Model.Rows.Count" />

    <div class="mat-actions">
        <mp-button variant="primary" href="/Tags/Edit" icon="plus">@L["New tag"]</mp-button>
    </div>
</div>
