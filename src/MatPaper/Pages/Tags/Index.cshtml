@page "/Tags"
@model MatPaper.Pages.Tags.IndexModel
@{
    ViewData["Breadcrumb"] = "Tags";
}

<mp-toolbar>
    <mp-toolbar-search name="Search" value="@Model.Search" placeholder="Name" />
    <mp-toolbar-select name="Sort" label="Sort" value="@Model.Sort">
        <option value="name_asc">Name (A–Z)</option>
        <option value="name_desc">Name (Z–A)</option>
    </mp-toolbar-select>
</mp-toolbar>

<mp-table item-count="Model.Rows.Count" empty-text="No tags match your criteria.">
    <thead>
        <tr>
            <th>Name</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tag in Model.Rows)
        {
            var swatch = string.IsNullOrWhiteSpace(tag.Color) ? "#808080" : tag.Color;
            <tr>
                <td>
                    <span class="color-swatch" style="display:inline-block;width:0.9em;height:0.9em;border-radius:3px;vertical-align:middle;margin-right:0.5em;background:@swatch"></span>@tag.Name
                </td>
                <td class="is-actions"><a href="/Tags/Edit?id=@tag.Id">Edit</a></td>
            </tr>
        }
    </tbody>
</mp-table>

<div class="list-actions">
    <a class="btn btn--primary" href="/Tags/Edit">New tag</a>
</div>

<mp-pagination current-page="Model.PageNumber" total-pages="Model.TotalPages" />
